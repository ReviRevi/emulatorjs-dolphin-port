diff --git a/Source/Core/Core/PowerPC/CachedInterpreter/WasmEmitter.h b/Source/Core/Core/PowerPC/CachedInterpreter/WasmEmitter.h
new file mode 100644
index 0000000..d8b0c10
--- /dev/null
+++ b/Source/Core/Core/PowerPC/CachedInterpreter/WasmEmitter.h
@@ -0,0 +1,329 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// Minimal WebAssembly binary encoder for the WebAssembly JIT tier
+// (CachedInterpreterWasm.cpp). It builds one tiny module per compiled block:
+//
+//   (import "e" "t" (table 0 funcref))             ; the main module's table
+//   (import "e" "m" (memory 0 65536 shared))       ; the main module's memory
+//   (func (export "f") (result i32) ...)            ; the block: next block's fn or 0
+//
+// Only the handful of instructions the JIT emits are provided.
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+#include "Common/CommonTypes.h"
+
+namespace WasmJit
+{
+// Value types
+constexpr u8 I32 = 0x7f;
+constexpr u8 I64 = 0x7e;
+constexpr u8 F32 = 0x7d;
+constexpr u8 F64 = 0x7c;
+constexpr u8 VOID = 0x40;  // empty block type
+
+// Function types used by the JIT (index into the type section built below)
+enum TypeIndex : u32
+{
+  TYPE_V_V = 0,      // () -> ()                 the block function
+  TYPE_V_II = 1,     // (i32, i32) -> ()         Interpreter::Instruction(Interpreter&, inst*)
+  TYPE_I_II = 2,     // (i32, i32) -> i32        CachedInterpreter callbacks
+  TYPE_V_I = 3,      // (i32) -> ()
+  TYPE_I_I = 4,      // (i32) -> i32
+  TYPE_V_III = 5,    // (i32, i32, i32) -> ()
+  TYPE_I_III = 6,    // (i32, i32, i32) -> i32
+  TYPE_V_IIII = 7,   // (i32, i32, i32, i32) -> ()
+  TYPE_I_V = 8,      // () -> i32               the block function: next block or 0
+  TYPE_F_FFF = 9,    // (f64, f64, f64) -> f64  fma helper
+  TYPE_COUNT
+};
+
+class CodeWriter
+{
+public:
+  std::vector<u8> bytes;
+
+  void Byte(u8 b) { bytes.push_back(b); }
+  void U32(u32 v)
+  {
+    do
+    {
+      u8 b = v & 0x7f;
+      v >>= 7;
+      if (v)
+        b |= 0x80;
+      Byte(b);
+    } while (v);
+  }
+  void S32(s32 v)
+  {
+    bool more = true;
+    while (more)
+    {
+      u8 b = v & 0x7f;
+      v >>= 7;  // arithmetic shift
+      if ((v == 0 && !(b & 0x40)) || (v == -1 && (b & 0x40)))
+        more = false;
+      else
+        b |= 0x80;
+      Byte(b);
+    }
+  }
+  void S64(s64 v)
+  {
+    bool more = true;
+    while (more)
+    {
+      u8 b = v & 0x7f;
+      v >>= 7;
+      if ((v == 0 && !(b & 0x40)) || (v == -1 && (b & 0x40)))
+        more = false;
+      else
+        b |= 0x80;
+      Byte(b);
+    }
+  }
+  void Name(const char* s)
+  {
+    const size_t n = std::strlen(s);
+    U32(static_cast<u32>(n));
+    bytes.insert(bytes.end(), s, s + n);
+  }
+  void Append(const std::vector<u8>& v) { bytes.insert(bytes.end(), v.begin(), v.end()); }
+
+  // ---- instructions ----
+  void Unreachable() { Byte(0x00); }
+  void Block(u8 type = VOID) { Byte(0x02); Byte(type); }
+  void Loop(u8 type = VOID) { Byte(0x03); Byte(type); }
+  void If(u8 type = VOID) { Byte(0x04); Byte(type); }
+  void Else() { Byte(0x05); }
+  void End() { Byte(0x0b); }
+  void Br(u32 depth) { Byte(0x0c); U32(depth); }
+  void BrIf(u32 depth) { Byte(0x0d); U32(depth); }
+  void Return() { Byte(0x0f); }
+  void Call(u32 func) { Byte(0x10); U32(func); }
+  void CallIndirect(u32 type) { Byte(0x11); U32(type); U32(0); }
+  // Tail call (WebAssembly tail-call proposal)
+  void ReturnCallIndirect(u32 type) { Byte(0x13); U32(type); U32(0); }
+  void Drop() { Byte(0x1a); }
+  void Select() { Byte(0x1b); }
+  void LocalGet(u32 i) { Byte(0x20); U32(i); }
+  void LocalSet(u32 i) { Byte(0x21); U32(i); }
+  void LocalTee(u32 i) { Byte(0x22); U32(i); }
+
+  // memory access: align is log2, offset in bytes
+  void Mem(u8 op, u32 align, u32 offset) { Byte(op); U32(align); U32(offset); }
+  void I32Load(u32 off = 0) { Mem(0x28, 2, off); }
+  void I64Load(u32 off = 0) { Mem(0x29, 3, off); }
+  void F32Load(u32 off = 0) { Mem(0x2a, 2, off); }
+  void F64Load(u32 off = 0) { Mem(0x2b, 3, off); }
+  void I32Load8S(u32 off = 0) { Mem(0x2c, 0, off); }
+  void I32Load8U(u32 off = 0) { Mem(0x2d, 0, off); }
+  void I32Load16S(u32 off = 0) { Mem(0x2e, 1, off); }
+  void I32Load16U(u32 off = 0) { Mem(0x2f, 1, off); }
+  void I32Store(u32 off = 0) { Mem(0x36, 2, off); }
+  void I64Store(u32 off = 0) { Mem(0x37, 3, off); }
+  void F32Store(u32 off = 0) { Mem(0x38, 2, off); }
+  void F64Store(u32 off = 0) { Mem(0x39, 3, off); }
+  void I32Store8(u32 off = 0) { Mem(0x3a, 0, off); }
+  void I32Store16(u32 off = 0) { Mem(0x3b, 1, off); }
+
+  void I32Const(s32 v) { Byte(0x41); S32(v); }
+  void I32ConstU(u32 v) { I32Const(static_cast<s32>(v)); }
+  void I64Const(s64 v) { Byte(0x42); S64(v); }
+
+  void I32Eqz() { Byte(0x45); }
+  void I32Eq() { Byte(0x46); }
+  void I32Ne() { Byte(0x47); }
+  void I32LtS() { Byte(0x48); }
+  void I32LtU() { Byte(0x49); }
+  void I32GtS() { Byte(0x4a); }
+  void I32GtU() { Byte(0x4b); }
+  void I32LeS() { Byte(0x4c); }
+  void I32LeU() { Byte(0x4d); }
+  void I32GeS() { Byte(0x4e); }
+  void I32GeU() { Byte(0x4f); }
+  void I64Eqz() { Byte(0x50); }
+  void I64Ne() { Byte(0x52); }
+  void I64LtS() { Byte(0x53); }
+  void I64GtS() { Byte(0x55); }
+
+  void I32Clz() { Byte(0x67); }
+  void I32Add() { Byte(0x6a); }
+  void I32Sub() { Byte(0x6b); }
+  void I32Mul() { Byte(0x6c); }
+  void I32DivS() { Byte(0x6d); }
+  void I32DivU() { Byte(0x6e); }
+  void I32And() { Byte(0x71); }
+  void I32Or() { Byte(0x72); }
+  void I32Xor() { Byte(0x73); }
+  void I32Shl() { Byte(0x74); }
+  void I32ShrS() { Byte(0x75); }
+  void I32ShrU() { Byte(0x76); }
+  void I32Rotl() { Byte(0x77); }
+  void I32Rotr() { Byte(0x78); }
+
+  void I64Add() { Byte(0x7c); }
+  void I64Sub() { Byte(0x7d); }
+  void I64Mul() { Byte(0x7e); }
+  void I64And() { Byte(0x83); }
+  void I64Or() { Byte(0x84); }
+  void I64Shl() { Byte(0x86); }
+  void I64ShrS() { Byte(0x87); }
+  void I64ShrU() { Byte(0x88); }
+
+  void F64Eq() { Byte(0x61); }
+  void F64Ne() { Byte(0x62); }
+  void F64Lt() { Byte(0x63); }
+  void F64Gt() { Byte(0x64); }
+  void F64Le() { Byte(0x65); }
+  void F64Ge() { Byte(0x66); }
+  void F64Abs() { Byte(0x99); }
+  void F64Neg() { Byte(0x9a); }
+  void F64Trunc() { Byte(0x9d); }
+  void F64Add() { Byte(0xa0); }
+  void F64Sub() { Byte(0xa1); }
+  void F64Mul() { Byte(0xa2); }
+  void F64Div() { Byte(0xa3); }
+  void F64Const(double v)
+  {
+    Byte(0x44);
+    u64 bits;
+    std::memcpy(&bits, &v, 8);
+    for (int i = 0; i < 8; i++)
+      Byte(static_cast<u8>(bits >> (8 * i)));
+  }
+  void I64LtU() { Byte(0x54); }
+  void I64Eq() { Byte(0x51); }
+  void I64Xor() { Byte(0x85); }
+  void I32WrapI64() { Byte(0xa7); }
+  void I32TruncF64S() { Byte(0xaa); }
+  void F32DemoteF64() { Byte(0xb6); }
+  void F64PromoteF32() { Byte(0xbb); }
+  void I32ReinterpretF32() { Byte(0xbc); }
+  void I64ReinterpretF64() { Byte(0xbd); }
+  void F32ReinterpretI32() { Byte(0xbe); }
+  void F64ReinterpretI64() { Byte(0xbf); }
+  void I64ExtendI32S() { Byte(0xac); }
+  void I64ExtendI32U() { Byte(0xad); }
+  void I32Extend8S() { Byte(0xc0); }
+  void I32Extend16S() { Byte(0xc1); }
+};
+
+// Wraps a function body (locals + code) into a complete module.
+// `locals` lists extra local declarations as (count, type) pairs.
+inline std::vector<u8> BuildModule(const std::vector<std::pair<u32, u8>>& locals,
+                                   const std::vector<u8>& code, const char* name = nullptr)
+{
+  CodeWriter m;
+  // magic + version
+  const u8 header[] = {0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00};
+  m.bytes.insert(m.bytes.end(), header, header + sizeof(header));
+
+  auto section = [&m](u8 id, const CodeWriter& body) {
+    m.Byte(id);
+    m.U32(static_cast<u32>(body.bytes.size()));
+    m.Append(body.bytes);
+  };
+
+  // Type section
+  {
+    CodeWriter s;
+    s.U32(TYPE_COUNT);
+    auto functype = [&s](std::initializer_list<u8> params, std::initializer_list<u8> results) {
+      s.Byte(0x60);
+      s.U32(static_cast<u32>(params.size()));
+      for (u8 p : params)
+        s.Byte(p);
+      s.U32(static_cast<u32>(results.size()));
+      for (u8 r : results)
+        s.Byte(r);
+    };
+    functype({}, {});                        // TYPE_V_V
+    functype({I32, I32}, {});                // TYPE_V_II
+    functype({I32, I32}, {I32});             // TYPE_I_II
+    functype({I32}, {});                     // TYPE_V_I
+    functype({I32}, {I32});                  // TYPE_I_I
+    functype({I32, I32, I32}, {});           // TYPE_V_III
+    functype({I32, I32, I32}, {I32});        // TYPE_I_III
+    functype({I32, I32, I32, I32}, {});      // TYPE_V_IIII
+    functype({}, {I32});                     // TYPE_I_V
+    functype({F64, F64, F64}, {F64});        // TYPE_F_FFF
+    section(1, s);
+  }
+  // Import section: table and memory
+  {
+    CodeWriter s;
+    s.U32(2);
+    s.Name("e");
+    s.Name("t");
+    s.Byte(0x01);  // table
+    s.Byte(0x70);  // funcref
+    s.Byte(0x00);  // limits: min only
+    s.U32(0);
+    s.Name("e");
+    s.Name("m");
+    s.Byte(0x02);  // memory
+    s.Byte(0x03);  // limits: min + max, shared
+    s.U32(0);
+    s.U32(65536);
+    section(2, s);
+  }
+  // Function section: one function of type TYPE_I_V
+  {
+    CodeWriter s;
+    s.U32(1);
+    s.U32(TYPE_I_V);
+    section(3, s);
+  }
+  // Export section: "f"
+  {
+    CodeWriter s;
+    s.U32(1);
+    s.Name("f");
+    s.Byte(0x00);  // func
+    s.U32(0);
+    section(7, s);
+  }
+  // Code section
+  {
+    CodeWriter body;
+    body.U32(static_cast<u32>(locals.size()));
+    for (const auto& [count, type] : locals)
+    {
+      body.U32(count);
+      body.Byte(type);
+    }
+    body.Append(code);
+    body.End();
+
+    CodeWriter s;
+    s.U32(1);
+    s.U32(static_cast<u32>(body.bytes.size()));
+    s.Append(body.bytes);
+    section(10, s);
+  }
+  // Name section: profilers show the function under this name (e.g. the PPC
+  // block address) instead of wasm-function[0].
+  if (name)
+  {
+    CodeWriter names;  // subsection 1: function names
+    names.U32(1);
+    names.U32(0);
+    names.Name(name);
+    CodeWriter s;
+    s.Name("name");
+    s.Byte(1);
+    s.U32(static_cast<u32>(names.bytes.size()));
+    s.Append(names.bytes);
+    section(0, s);
+  }
+  return std::move(m.bytes);
+}
+}  // namespace WasmJit
