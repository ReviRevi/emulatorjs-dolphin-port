+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// WebGPU video backend for the browser (Emscripten) build. Rendering state lives
+// in JavaScript (WGPURuntime.js); these classes hold integer handles into it.
+
+#pragma once
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "VideoCommon/AbstractFramebuffer.h"
+#include "VideoCommon/AbstractGfx.h"
+#include "VideoCommon/AbstractPipeline.h"
+#include "VideoCommon/AbstractShader.h"
+#include "VideoCommon/AbstractStagingTexture.h"
+#include "VideoCommon/AbstractTexture.h"
+#include "VideoCommon/NativeVertexFormat.h"
+#include "VideoCommon/VertexManagerBase.h"
+#include "VideoCommon/VideoBackendBase.h"
+
+namespace WGPU
+{
+// Set by the libretro frontend: size of the picture handed to RetroArch, and a
+// callback that returns RetroArch's current framebuffer and presents the frame.
+extern int g_surface_width;
+extern int g_surface_height;
+extern unsigned (*g_get_frontend_framebuffer)();
+extern void (*g_frontend_present)(int width, int height);
+
+// Starts creating the WebGPU device (asynchronous) as early as possible.
+void Kick();
+bool IsReady();
+
+class Texture final : public AbstractTexture
+{
+public:
+  Texture(const TextureConfig& config, int id) : AbstractTexture(config), m_id(id) {}
+  ~Texture() override;
+  void CopyRectangleFromTexture(const AbstractTexture* src, const MathUtil::Rectangle<int>& src_rect,
+                                u32 src_layer, u32 src_level,
+                                const MathUtil::Rectangle<int>& dst_rect, u32 dst_layer,
+                                u32 dst_level) override;
+  void ResolveFromTexture(const AbstractTexture* src, const MathUtil::Rectangle<int>& rect,
+                          u32 layer, u32 level) override;
+  void Load(u32 level, u32 width, u32 height, u32 row_length, const u8* buffer, size_t buffer_size,
+            u32 layer) override;
+  int GetId() const { return m_id; }
+
+private:
+  int m_id;
+};
+
+class StagingTexture final : public AbstractStagingTexture
+{
+public:
+  StagingTexture(StagingTextureType type, const TextureConfig& config);
+  ~StagingTexture() override;
+  void CopyFromTexture(const AbstractTexture* src, const MathUtil::Rectangle<int>& src_rect,
+                       u32 src_layer, u32 src_level,
+                       const MathUtil::Rectangle<int>& dst_rect) override;
+  void CopyToTexture(const MathUtil::Rectangle<int>& src_rect, AbstractTexture* dst,
+                     const MathUtil::Rectangle<int>& dst_rect, u32 dst_layer,
+                     u32 dst_level) override;
+  bool Map() override;
+  void Unmap() override;
+  void Flush() override;
+
+private:
+  std::vector<u8> m_data;
+  int m_id;
+};
+
+class Framebuffer final : public AbstractFramebuffer
+{
+public:
+  Framebuffer(AbstractTexture* color, AbstractTexture* depth,
+              std::vector<AbstractTexture*> additional, AbstractTextureFormat color_format,
+              AbstractTextureFormat depth_format, u32 width, u32 height, int id)
+      : AbstractFramebuffer(color, depth, std::move(additional), color_format, depth_format,
+                            width, height, 1, 1),
+        m_id(id)
+  {
+  }
+  ~Framebuffer() override;
+  int GetId() const { return m_id; }
+
+private:
+  int m_id;
+};
+
+class Shader final : public AbstractShader
+{
+public:
+  Shader(ShaderStage stage, int id) : AbstractShader(stage), m_id(id) {}
+  ~Shader() override;
+  int GetId() const { return m_id; }
+
+private:
+  int m_id;
+};
+
+class Pipeline final : public AbstractPipeline
+{
+public:
+  Pipeline(const AbstractPipelineConfig& config, int id) : AbstractPipeline(config), m_id(id) {}
+  ~Pipeline() override;
+  int GetId() const { return m_id; }
+
+private:
+  int m_id;
+};
+
+class VertexFormat final : public NativeVertexFormat
+{
+public:
+  explicit VertexFormat(const PortableVertexDeclaration& decl);
+  int GetId() const { return m_id; }
+
+private:
+  int m_id;
+};
+
+class Gfx final : public AbstractGfx
+{
+public:
+  Gfx();
+  ~Gfx() override;
+
+  bool IsHeadless() const override { return false; }
+  std::unique_ptr<AbstractTexture> CreateTexture(const TextureConfig& config,
+                                                 std::string_view name) override;
+  std::unique_ptr<AbstractStagingTexture>
+  CreateStagingTexture(StagingTextureType type, const TextureConfig& config) override;
+  std::unique_ptr<AbstractFramebuffer>
+  CreateFramebuffer(AbstractTexture* color_attachment, AbstractTexture* depth_attachment,
+                    std::vector<AbstractTexture*> additional_color_attachments) override;
+  std::unique_ptr<AbstractShader> CreateShaderFromSource(ShaderStage stage,
+                                                         std::string_view source,
+                                                         VideoCommon::ShaderIncluder* includer,
+                                                         std::string_view name) override;
+  std::unique_ptr<AbstractShader> CreateShaderFromBinary(ShaderStage stage, const void* data,
+                                                         size_t length,
+                                                         std::string_view name) override;
+  std::unique_ptr<NativeVertexFormat>
+  CreateNativeVertexFormat(const PortableVertexDeclaration& vtx_decl) override;
+  std::unique_ptr<AbstractPipeline> CreatePipeline(const AbstractPipelineConfig& config,
+                                                   const void* cache_data = nullptr,
+                                                   size_t cache_data_length = 0) override;
+
+  void SetPipeline(const AbstractPipeline* pipeline) override;
+  void SetFramebuffer(AbstractFramebuffer* framebuffer) override;
+  void SetAndDiscardFramebuffer(AbstractFramebuffer* framebuffer) override;
+  void SetAndClearFramebuffer(AbstractFramebuffer* framebuffer, const ClearColor& color_value,
+                              float depth_value) override;
+  void ClearRegion(const MathUtil::Rectangle<int>& target_rc, bool color_enable,
+                   bool alpha_enable, bool z_enable, u32 color, u32 z) override;
+  void SetScissorRect(const MathUtil::Rectangle<int>& rc) override;
+  void SetTexture(u32 index, const AbstractTexture* texture) override;
+  void SetSamplerState(u32 index, const SamplerState& state) override;
+  void UnbindTexture(const AbstractTexture* texture) override;
+  void SetViewport(float x, float y, float width, float height, float near_depth,
+                   float far_depth) override;
+  void Draw(u32 base_vertex, u32 num_vertices) override;
+  void DrawIndexed(u32 base_index, u32 num_indices, u32 base_vertex) override;
+  bool BindBackbuffer(const ClearColor& clear_color = {}) override;
+  void PresentBackbuffer() override;
+  void Flush() override;
+  void WaitForGPUIdle() override;
+  SurfaceInfo GetSurfaceInfo() const override;
+
+private:
+  void EnsureBackbuffer();
+  std::unique_ptr<Texture> m_backbuffer;
+  std::unique_ptr<Framebuffer> m_backbuffer_fb;
+  const Texture* m_bound_textures[16] = {};
+};
+
+class VertexManager final : public VertexManagerBase
+{
+public:
+  void UploadUtilityUniforms(const void* uniforms, u32 uniforms_size) override;
+
+protected:
+  void CommitBuffer(u32 num_vertices, u32 vertex_stride, u32 num_indices, u32* out_base_vertex,
+                    u32* out_base_index) override;
+  void UploadUniforms() override;
+};
+
+class VideoBackend final : public VideoBackendBase
+{
+public:
+  bool Initialize(const WindowSystemInfo& wsi) override;
+  void Shutdown() override;
+  std::string GetConfigName() const override { return CONFIG_NAME; }
+  std::string GetDisplayName() const override { return "WebGPU"; }
+  void InitBackendInfo(const WindowSystemInfo& wsi) override;
+  static constexpr const char* CONFIG_NAME = "WebGPU";
+};
+}  // namespace WGPU
diff --git a/Source/Core/VideoBackends/WebGPU/WGPURuntime.js b/Source/Core/VideoBackends/WebGPU/WGPURuntime.js
new file mode 100644
index 0000000..f60e28f
--- /dev/null
+++ b/Source/Core/VideoBackends/WebGPU/WGPURuntime.js
@@ -0,0 +1,703 @@
+// WebGPU backend runtime for Dolphin (browser side). Evaluated once with `env`:
+//   env.heap()  -> current HEAPU8      env.gl() -> current WebGL context (RetroArch's)
+//   env.GL      -> Emscripten GL object tables    env.str(ptr) -> UTF8ToString
+//   env.nagaGlue / env.nagaB64 -> naga (GLSL -> WGSL translator) glue + wasm
+// The C++ side (WGPUBackend.cpp) talks to the returned object `W` through small
+// EM_JS stubs; objects are referred to by integer ids.
+'use strict';
+var W = {};
+var dev = null, queue = null, state = 0, feats = {}, nerr = 0;
+var O = [null];
+function put(o) { O.push(o); return O.length - 1; }
+function H() { return env.heap(); }
+function log() { console.log.apply(console, ['[wgpu]'].concat([].slice.call(arguments))); }
+function err() { if (nerr++ < 200) console.error.apply(console, ['[wgpu]'].concat([].slice.call(arguments))); }
+function align(v, a) { return Math.ceil(v / a) * a; }
+
+// ---------------- naga ----------------
+var naga = null;
+function initNaga() {
+  if (naga) return;
+  var glue = (new Function(env.nagaGlue + '\nreturn {initSync: initSync, parseGlsl: parseGlsl, validate: validate, writeWgsl: writeWgsl};'))();
+  var s = atob(env.nagaB64), b = new Uint8Array(s.length);
+  for (var i = 0; i < s.length; i++) b[i] = s.charCodeAt(i);
+  glue.initSync({ module: b });
+  naga = glue;
+}
+
+// ---------------- device ----------------
+var WANT = ['dual-source-blending', 'float32-filterable', 'texture-compression-bc', 'depth32float-stencil8'];
+W.kick = function() {
+  if (W._kicked) return;
+  W._kicked = true;
+  try { initNaga(); } catch (e) { state = -1; err('naga init failed', e); return; }
+  if (!navigator.gpu) { state = -1; err('navigator.gpu missing'); return; }
+  navigator.gpu.requestAdapter({ powerPreference: 'high-performance' }).then(function(a) {
+    if (!a) throw new Error('no WebGPU adapter');
+    var want = WANT.filter(function(f) { return a.features.has(f); });
+    want.forEach(function(f) { feats[f] = true; });
+    return a.requestDevice({ requiredFeatures: want,
+      requiredLimits: { maxUniformBufferBindingSize: Math.min(65536, a.limits.maxUniformBufferBindingSize) } });
+  }).then(function(d) {
+    dev = d; queue = d.queue;
+    d.lost.then(function(i) { err('device lost:', i.message); });
+    d.onuncapturederror = function(e) { err(e.error.message); };
+    setup();
+    state = 1;
+    log('device ready; features:', Object.keys(feats).join(','));
+  }).catch(function(e) { state = -1; err('init failed', e); });
+};
+W.state = function() { return state; };
+W.feature = function(i) { return feats[['dual-source-blending', 'float32-filterable', 'texture-compression-bc'][i]] ? 1 : 0; };
+
+// ---------------- formats (AbstractTextureFormat order) ----------------
+var FMT = [
+  { name: 'rgba8unorm', bytes: 4 }, { name: 'bgra8unorm', bytes: 4 }, { name: 'rgb10a2unorm', bytes: 4 },
+  { name: 'rgba16float', bytes: 8 }, { name: 'bc1-rgba-unorm', bytes: 8, block: 4 },
+  { name: 'bc2-rgba-unorm', bytes: 16, block: 4 }, { name: 'bc3-rgba-unorm', bytes: 16, block: 4 },
+  { name: 'bc7-rgba-unorm', bytes: 16, block: 4 }, { name: 'r16float', bytes: 2 },
+  { name: 'depth16unorm', bytes: 2, depth: true }, { name: 'depth24plus-stencil8', bytes: 4, depth: true, stencil: true },
+  { name: 'r32float', bytes: 4 }, { name: 'depth32float', bytes: 4, depth: true },
+  { name: 'depth32float-stencil8', bytes: 4, depth: true, stencil: true }, null];
+
+// ---------------- frame state ----------------
+var encoder = null, pass = null, trash = [], curFb = 0, pendingClear = null;
+var curPipe = 0, vp = [0, 0, 1, 1, 0, 1], sc = [0, 0, 1, 1];
+var dPipe = true, dVP = true, dSC = true, dVB = true, dBG0 = true, dBG1 = true;
+var slots = [], samplers = [], samplerCache = new Map();
+var vbuf, ibuf, ubuf, bgl0, bg0, dummy, VSIZE = 32 << 20, ISIZE = 8 << 20, USIZE = 8 << 20, UBIND = 16384;
+var vpos = 0, ipos = 0, upos = 0, gxOff = [0, 0, 0], utilOff = 0;
+var stats = W.stats = { bufWrites: 0, directUploads: 0, draws: 0, passes: 0, submits: 0, pipelines: 0, shaders: 0, shaderFails: 0, uploads: 0 };
+
+function setup() {
+  var U = GPUBufferUsage;
+  vbuf = dev.createBuffer({ size: VSIZE, usage: U.VERTEX | U.COPY_DST });
+  ibuf = dev.createBuffer({ size: ISIZE, usage: U.INDEX | U.COPY_DST });
+  ubuf = dev.createBuffer({ size: USIZE, usage: U.UNIFORM | U.COPY_DST });
+  vStage = new Uint8Array(VSIZE); iStage = new Uint8Array(ISIZE); uStage = new Uint8Array(USIZE);
+  var vis = GPUShaderStage.VERTEX | GPUShaderStage.FRAGMENT;
+  var e = [];
+  for (var i = 0; i < 3; i++) e.push({ binding: i, visibility: vis, buffer: { type: 'uniform', hasDynamicOffset: true } });
+  bgl0 = dev.createBindGroupLayout({ entries: e });
+  bg0 = dev.createBindGroup({ layout: bgl0, entries: [0, 1, 2].map(function(i) { return { binding: i, resource: { buffer: ubuf, offset: 0, size: UBIND } }; }) });
+  var t = dev.createTexture({ size: [1, 1, 1], format: 'rgba8unorm', usage: GPUTextureUsage.TEXTURE_BINDING | GPUTextureUsage.COPY_DST });
+  queue.writeTexture({ texture: t }, new Uint8Array([0, 0, 0, 255]), { bytesPerRow: 4 }, [1, 1, 1]);
+  dummy = { t: t, w: 1, h: 1, layers: 1, levels: 1, f: FMT[0], views: {} };
+}
+
+function enc() { if (!encoder) encoder = dev.createCommandEncoder(); return encoder; }
+function endPass() { if (pass) { pass.end(); pass = null; } }
+// Vertex, index and uniform data is staged in JS mirrors of the GPU ring buffers
+// and written with one writeBuffer per buffer just before each submit (instead
+// of one per draw). Draws only reference ring offsets, so this is equivalent.
+var vStage, iStage, uStage, vLo = 1e9, vHi = 0, iLo = 1e9, iHi = 0, uLo = 1e9, uHi = 0, encEpoch = 1;
+function flushStage() {
+  if (vHi > vLo) { queue.writeBuffer(vbuf, vLo, vStage, vLo, vHi - vLo); stats.bufWrites++; }
+  if (iHi > iLo) { queue.writeBuffer(ibuf, iLo, iStage, iLo, iHi - iLo); stats.bufWrites++; }
+  if (uHi > uLo) { queue.writeBuffer(ubuf, uLo, uStage, uLo, uHi - uLo); stats.bufWrites++; }
+  vLo = iLo = uLo = 1e9; vHi = iHi = uHi = 0;
+}
+function submit() {
+  endPass();
