+        c.I32Const(1);
+        c.I32And();
+        c.I32Store8(e.m.xer_ca);
+        c.I32ConstU(e.m.ppc);
+        c.LocalGet(L_V);
+        c.I32Const(XER_OV_SHIFT);
+        c.I32ShrU();
+        c.I32Const(3);
+        c.I32And();
+        c.I32Store8(e.m.xer_so_ov);
+      }
+    }
+    c.Br(1);
+    c.End();
+    e.Flush(true);
+    fallback();
+    if (xo == 339)
+      e.Reload(rd);
+    c.End();
+    if (xo == 339)
+    {
+      e.loaded |= 1u << rd;
+      e.dirty |= 1u << rd;
+    }
+    return true;
+  }
+  case 922:  // extsh
+  case 954:  // extsb
+    return binop(ra, [&] {
+      e.PushGPR(rs);
+      xo == 922 ? c.I32Extend16S() : c.I32Extend8S();
+    });
+  default:
+    break;
+  }
+
+  if (inst.OE)
+    return false;
+
+  switch (xo & 0x1ff)  // XO-form: 9-bit opcode
+  {
+  case 266:  // add
+    return binop(rd, [&] {
+      e.PushGPR(ra);
+      e.PushGPR(rb);
+      c.I32Add();
+    });
+  case 40:  // subf: rB - rA
+    return binop(rd, [&] {
+      e.PushGPR(rb);
+      e.PushGPR(ra);
+      c.I32Sub();
+    });
+  case 104:  // neg
+    return binop(rd, [&] {
+      c.I32Const(0);
+      e.PushGPR(ra);
+      c.I32Sub();
+    });
+  case 235:  // mullw
+    return binop(rd, [&] {
+      e.PushGPR(ra);
+      e.PushGPR(rb);
+      c.I32Mul();
+    });
+  case 75:  // mulhw
+  case 11:  // mulhwu
+    return binop(rd, [&] {
+      e.PushGPR(ra);
+      (xo & 0x1ff) == 75 ? c.I64ExtendI32S() : c.I64ExtendI32U();
+      e.PushGPR(rb);
+      (xo & 0x1ff) == 75 ? c.I64ExtendI32S() : c.I64ExtendI32U();
+      c.I64Mul();
+      c.I64Const(32);
+      c.I64ShrU();
+      c.I32WrapI64();
+    });
+  case 491:  // divw
+  {
+    // overflow (b == 0 || (a == INT_MIN && b == -1)): rD = a < 0 ? -1 : 0
+    e.PushGPR(ra);
+    c.LocalSet(Local::L_T);
+    e.PushGPR(rb);
+    c.LocalSet(Local::L_E);
+    c.LocalGet(Local::L_E);
+    c.I32Eqz();
+    c.LocalGet(Local::L_T);
+    c.I32ConstU(0x80000000);
+    c.I32Eq();
+    c.LocalGet(Local::L_E);
+    c.I32Const(-1);
+    c.I32Eq();
+    c.I32And();
+    c.I32Or();
+    c.If(WasmJit::I32);
+    c.LocalGet(Local::L_T);
+    c.I32Const(31);
+    c.I32ShrS();
+    c.Else();
+    c.LocalGet(Local::L_T);
+    c.LocalGet(Local::L_E);
+    c.I32DivS();
+    c.End();
+    c.LocalSet(Local::L_V);
+    e.SetGPRFromLocal(rd, Local::L_V);
+    if (inst.Rc)
+      e.UpdateCR0(Local::L_V);
+    return true;
+  }
+  case 459:  // divwu: b == 0 -> 0
+    e.Use(ra);
+    e.PushGPR(rb);
+    c.LocalTee(Local::L_E);
+    c.If(WasmJit::I32);
+    e.PushGPR(ra);
+    c.LocalGet(Local::L_E);
+    c.I32DivU();
+    c.Else();
+    c.I32Const(0);
+    c.End();
+    c.LocalSet(Local::L_V);
+    e.SetGPRFromLocal(rd, Local::L_V);
+    if (inst.Rc)
+      e.UpdateCR0(Local::L_V);
+    return true;
+  case 10:   // addc: CA = carry(a, b)
+  case 138:  // adde: CA = carry(a, b) || carry(a + b, ca)
+  case 202:  // addze: rD = a + ca, CA = carry(a, ca)
+  case 200:  // subfze: rD = ~a + ca, CA = carry(~a, ca)
+  case 8:    // subfc: rD = ~a + b + 1, CA = ~a == 0xFFFFFFFF || carry(b, ~a + 1)
+  case 136:  // subfe: rD = ~a + b + ca, CA = carry(~a, b) || carry(~a + b, ca)
+  {
+    const u32 op = xo & 0x1ff;
+    // Do it in 64 bits: carry is bit 32 of the full sum.
+    e.PushGPR(ra);
+    if (op == 8 || op == 136 || op == 200)
+    {
+      c.I32Const(-1);
+      c.I32Xor();
+    }
+    c.I64ExtendI32U();
+    if (op != 202 && op != 200)
+    {
+      e.PushGPR(rb);
+      c.I64ExtendI32U();
+      c.I64Add();
+    }
+    if (op == 8)
+    {
+      c.I64Const(1);
+      c.I64Add();
+    }
+    else if (op != 10)
+    {
+      e.PushCarry();
+      c.I64ExtendI32U();
+      c.I64Add();
+    }
+    c.LocalTee(Local::L_X);
+    c.I32WrapI64();
+    c.LocalSet(Local::L_V);
+    e.SetGPRFromLocal(rd, Local::L_V);
+    c.LocalGet(Local::L_X);
+    c.I64Const(32);
+    c.I64ShrU();
+    c.I32WrapI64();
+    e.SetCarryFromStack();
+    if (inst.Rc)
+      e.UpdateCR0(Local::L_V);
+    return true;
+  }
+  default:
+    return false;
+  }
+}
+
+s32 CachedInterpreter::WasmEntry(PowerPC::PowerPCState& ppc_state,
+                                 const WasmEntryOperands& operands)
+{
+  // Only reached when the block isn't compiled; ExecuteOneBlock handles it.
+  return sizeof(AnyCallback) + sizeof(operands);
+}
+
+s32 CachedInterpreter::WasmEntry(std::ostream& stream, const WasmEntryOperands& operands)
+{
+  fmt::println(stream, "WasmEntry(fn={}, calls={})", operands.fn, operands.calls);
+  return sizeof(AnyCallback) + sizeof(operands);
+}
+
+void CachedInterpreter::OnDestroyBlock(const JitBlock& block)
+{
+  if (!block.normalEntry)
+    return;
+  if (*reinterpret_cast<const AnyCallback*>(block.normalEntry) != AnyCallbackCast(WasmEntry))
+    return;
+  auto& entry =
+      *reinterpret_cast<WasmEntryOperands*>(block.normalEntry + sizeof(AnyCallback));
+  if (entry.fn != 0)
+    dolphin_wasm_jit_free(static_cast<int>(entry.fn));
+  entry.fn = 0;
+  entry.calls = WASM_JIT_NEVER;
+}
+
+void CachedInterpreter::CompileWasm(WasmEntryOperands& entry)
+{
+  using namespace WasmJit;
+  const int mode = dolphin_wasm_jit_mode();
+  s_disabled_groups = static_cast<u32>(dolphin_wasm_jit_disabled_groups());
+  if (mode <= 0)
+  {
+    entry.calls = WASM_JIT_NEVER;
+    return;
+  }
+  JitBlock& block = *entry.block;
+  const u8* p = reinterpret_cast<const u8*>(&entry) + sizeof(WasmEntryOperands);
+  const u8* const end = block.near_end;
+
+  const u32 ppc = static_cast<u32>(reinterpret_cast<uintptr_t>(&m_ppc_state));
+  const u32 off_pc = offsetof(PowerPC::PowerPCState, pc);
+  const u32 off_npc = offsetof(PowerPC::PowerPCState, npc);
+
+  auto& memory = m_system.GetMemory();
+  // Whether main RAM sits at 0x80000000 with the standard cached BAT mapping
+  // (and data cache emulation is off), for Emitter::Translate's fast path.
+  const auto FastRamMapped = [&] {
+    if (m_ppc_state.m_enable_dcache)
+      return false;
+    const auto& dbat = m_system.GetMMU().GetDBATTable();
+    const u32 size = memory.GetRamSizeReal();
+    for (u32 ea = 0x80000000; ea < 0x80000000 + size; ea += PowerPC::BAT_PAGE_SIZE)
+    {
+      const u32 e = dbat[ea >> PowerPC::BAT_INDEX_SHIFT];
+      if (!(e & PowerPC::BAT_MAPPED_BIT) || (e & PowerPC::BAT_WI_BIT) ||
+          (e & PowerPC::BAT_RESULT_MASK) != ea - 0x80000000)
+        return false;
+    }
+    return true;
+  };
+  const Machine machine{
+      ppc,
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, gpr)),
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, cr) +
+                       offsetof(PowerPC::ConditionRegister, fields)),
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, msr)),
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, xer_ca)),
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, xer_so_ov)),
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, xer_stringctrl)),
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, m_enable_dcache)),
+      static_cast<u32>(reinterpret_cast<uintptr_t>(PowerPC::ConditionRegister::s_crTable.data())),
+      static_cast<u32>(reinterpret_cast<uintptr_t>(m_system.GetMMU().GetDBATTable().data())),
+      static_cast<u32>(reinterpret_cast<uintptr_t>(memory.GetRAM())),
+      memory.GetRamMask(),
+      static_cast<u32>(reinterpret_cast<uintptr_t>(memory.GetEXRAM())),
+      memory.GetEXRAM() ? memory.GetExRamSizeReal() : 0,
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, pc)),
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, npc)),
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, spr)),
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, downcount)),
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, feature_flags)),
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, ps)),
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, fpscr)),
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, gather_pipe_ptr)),
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, gather_pipe_base_ptr)),
+      static_cast<u32>(reinterpret_cast<uintptr_t>(&m_system.GetGPFifo())),
+      memory.GetRamSizeReal(),
+      FastRamMapped(),
+      (block.feature_flags & FEATURE_FLAG_MSR_DR) != 0,
+  };
+  const bool branch_watch = m_system.GetPowerPC().GetBranchWatch().GetRecordingActive();
+
+  CodeWriter c;
+  Emitter emitter(c, machine);
+  auto call_callback = [&](AnyCallback cb, const u8* payload) {
+    // if (cb(ppc_state, payload) == 0) return;
+    emitter.Flush();
+    c.I32ConstU(ppc);
+    c.I32ConstU(static_cast<u32>(reinterpret_cast<uintptr_t>(payload)));
+    c.I32ConstU(static_cast<u32>(reinterpret_cast<uintptr_t>(cb)));
+    c.CallIndirect(TYPE_I_II);
+    c.I32Eqz();
+    c.If();
+    c.I32Const(0);
+    c.Return();
+    c.End();
+    emitter.Invalidate();  // callbacks may change any register
+  };
+
+  // Block exit: EndBlock<false> inline (pc = npc, downcount, no performance
+  // monitor), then block chaining: if there's time left in the slice, look
+  // the next block up in the dispatcher's map and return its compiled
+  // function (0: let the dispatcher handle it).
+  const bool can_chain = m_block_cache.UsesFastBlockMapFallback();
+  const bool tail_calls = dolphin_wasm_jit_tailcalls() != 0;
+  const u32 entry_addr = static_cast<u32>(reinterpret_cast<uintptr_t>(&entry));
+  const u32 fast_map =
+      static_cast<u32>(reinterpret_cast<uintptr_t>(m_block_cache.GetFastBlockMapFallback()));
+  const u32 wasm_entry_cb = static_cast<u32>(reinterpret_cast<uintptr_t>(AnyCallbackCast(WasmEntry)));
+  // loop_depth: how many blocks deep the function-wide loop is from here;
+  // in_branch: inside a conditional exit, where the fall-through path still
+  // needs the cached registers (flush but keep them dirty).
+  auto end_block_inline = [&](const EndBlockOperands<false>& op, u32 loop_depth = 0,
+                              bool in_branch = false) {
+    emitter.Flush(in_branch);
+    // pc = npc
+    c.I32ConstU(ppc);
+    c.I32ConstU(ppc);
+    c.I32Load(machine.npc);
+    c.I32Store(machine.pc);
+    // downcount -= n
+    c.I32ConstU(ppc);
+    c.I32ConstU(ppc);
+    c.I32Load(machine.downcount);
+    c.I32ConstU(op.downcount);
+    c.I32Sub();
+    c.LocalTee(L_T);
+    c.I32Store(machine.downcount);
+    if (!can_chain)
+    {
+      c.I32Const(0);
+      c.Return();
+      return;
+    }
+    c.LocalGet(L_T);
+    c.I32Const(0);
+    c.I32LeS();
+    c.If();
+    c.I32Const(0);
+    c.Return();
+    c.End();
+    // Tight loop: the block branches to itself. Run it again here, unless it
+    // was destroyed meanwhile (OnDestroyBlock clears entry.fn; the operands'
+    // memory is only reused at the next compile).
+    c.I32ConstU(ppc);
+    c.I32Load(machine.pc);
+    c.I32ConstU(block.effectiveAddress);
+    c.I32Eq();
+    c.I32ConstU(entry_addr);
+    c.I32Load(offsetof(WasmEntryOperands, fn));
+    c.I32Const(0);
+    c.I32Ne();
+    c.I32And();
+    c.BrIf(loop_depth);  // the function-wide loop
+    // block = fast_map[(pc >> 2) & mask]
+    c.I32ConstU(ppc);
+    c.I32Load(machine.pc);
+    c.LocalTee(L_V);
+    c.I32Const(2);
+    c.I32ShrU();
+    c.I32ConstU(JitBaseBlockCache::FAST_BLOCK_MAP_FALLBACK_MASK);
+    c.I32And();
+    c.I32Const(2);
+    c.I32Shl();
+    c.I32ConstU(fast_map);
+    c.I32Add();
+    c.I32Load();
+    c.LocalTee(L_E);
+    c.I32Eqz();
+    c.If();
+    c.I32Const(0);
+    c.Return();
+    c.End();
+    // block->effectiveAddress == pc && block->feature_flags == feature_flags
+    c.LocalGet(L_E);
+    c.I32Load(offsetof(JitBlockData, effectiveAddress));
+    c.LocalGet(L_V);
+    c.I32Ne();
+    c.LocalGet(L_E);
+    c.I32Load(offsetof(JitBlockData, feature_flags));
+    c.I32ConstU(ppc);
+    c.I32Load(machine.feature_flags);
+    c.I32Ne();
+    c.I32Or();
+    c.If();
+    c.I32Const(0);
+    c.Return();
+    c.End();
+    // entry = block->normalEntry; first callback must be WasmEntry
+    c.LocalGet(L_E);
+    c.I32Load(offsetof(JitBlockData, normalEntry));
+    c.LocalTee(L_E);
+    c.I32Load();
+    c.I32ConstU(wasm_entry_cb);
+    c.I32Ne();
+    c.If();
+    c.I32Const(0);
+    c.Return();
+    c.End();
+    c.LocalGet(L_E);
+    c.I32Load(sizeof(AnyCallback) + offsetof(WasmEntryOperands, fn));
+    if (tail_calls)
+    {
+      // next block compiled: jump into it; otherwise back to the dispatcher
+      c.LocalTee(L_E);
+      c.I32Eqz();
+      c.If();
+      c.I32Const(0);
+      c.Return();
+      c.End();
+      c.LocalGet(L_E);
+      c.ReturnCallIndirect(TYPE_I_V);
+    }
+    else
+    {
+      c.Return();
+    }
+  };
+
+  c.Loop();  // target of the tight-loop branch in end_block_inline
+
+  // ---- forward branches inside the block ----
+  // A conditional branch that skips a few instructions ahead (beq over an
+  // `if` body) used to leave the block when taken, so a loop full of them ran
+  // as many tiny blocks with a dispatch between each (TTYD: 5 per iteration).
+  // When the target is a later instruction of this same block, reached in
+  // straight-line order, the taken path jumps there inside the function:
+  //   block            ; region
+  //     br_if 0 (taken)
+  //     ...skipped instructions...
+  //   end              ; target instruction follows
+  // Registers: dirty ones are written back before the branch (memory is right
+  // on the taken path); at the join only registers loaded on both paths stay
+  // loaded, and ones first loaded and modified inside are written back at the
+  // end of the fall-through path.
+  struct ScanEntry
+  {
+    const u8* p;
+    AnyCallback cb;
+    u32 pc;  // Interpret ops: the instruction's address, else 0
+  };
+  std::vector<ScanEntry> scan;
+  bool scan_ok = true;
+  for (const u8* q = p; q < end;)
+  {
+    const auto qcb = *reinterpret_cast<const AnyCallback*>(q);
+    const u8* qp = q + sizeof(AnyCallback);
+    std::size_t qsize = 0;
+    u32 qpc = 0;
+    if (qcb == AnyCallbackCast(Interpret<false>) || qcb == AnyCallbackCast(Interpret<true>))
+    {
+      qsize = sizeof(InterpretOperands);
+      qpc = reinterpret_cast<const InterpretOperands*>(qp)->current_pc;
+    }
+    else if (qcb == AnyCallbackCast(InterpretAndCheckExceptions<false>) ||
+             qcb == AnyCallbackCast(InterpretAndCheckExceptions<true>))
+      qsize = sizeof(InterpretAndCheckExceptionsOperands);
+    else if (qcb == AnyCallbackCast(EndBlock<false>))
+      qsize = sizeof(EndBlockOperands<false>);
+    else if (qcb == AnyCallbackCast(EndBlock<true>))
+      qsize = sizeof(EndBlockOperands<true>);
+    else if (qcb == AnyCallbackCast(EndBlockIfTaken))
+      qsize = sizeof(EndBlockIfTakenOperands);
+    else if (qcb == AnyCallbackCast(StartProfiledBlock))
+      qsize = sizeof(StartProfiledBlockOperands);
+    else if (qcb == AnyCallbackCast(HLEFunction))
+      qsize = sizeof(HLEFunctionOperands);
+    else if (qcb == AnyCallbackCast(WriteBrokenBlockNPC))
+      qsize = sizeof(WriteBrokenBlockNPCOperands);
+    else if (qcb == AnyCallbackCast(CheckFPU) || qcb == AnyCallbackCast(CheckBreakpoint))
+      qsize = sizeof(CheckHaltOperands);
+    else if (qcb == AnyCallbackCast(CheckIdle))
+      qsize = sizeof(CheckIdleOperands);
+    else
+    {
+      scan_ok = false;
+      break;
+    }
+    scan.push_back({q, qcb, qpc});
+    q = qp + qsize;
+  }
+  // Whether the instruction at `target` comes later in this block, reached
+  // through straight-line code from the entry after `from` (no followed
+  // branches or block ends in between).
+  auto target_ahead = [&](const u8* from, u32 branch_pc, u32 target) {
+    if (!scan_ok || WebGLDebugFlag("DOLPHIN_WASM_JIT_FWDBRANCH", 1) == 0)
+      return false;
+    std::size_t i = 0;
+    while (i < scan.size() && scan[i].p <= from)
+      i++;
+    u32 last = branch_pc;
+    for (; i < scan.size(); i++)
+    {
+      const auto& se = scan[i];
+      if (se.cb == AnyCallbackCast(EndBlock<false>) || se.cb == AnyCallbackCast(EndBlock<true>) ||
+          se.cb == AnyCallbackCast(HLEFunction) || se.cb == AnyCallbackCast(WriteBrokenBlockNPC))
+        return false;
+      if (se.pc == 0)
+        continue;
+      if (se.pc == target)
+        return true;
+      if (se.pc <= last || se.pc > target)
+        return false;
+      last = se.pc;
+    }
+    return false;
+  };
+  struct Region
+  {
+    u32 target;
+    u32 loaded0;
+  };
+  std::vector<Region> regions;
+  u32 prev_pc = 0;
+  UGeckoInstruction prev_inst{};
+  auto close_region = [&] {
+    const Region r = regions.back();
+    regions.pop_back();
+    // fall-through path: write back registers first loaded in here and changed
+    const u32 spill = emitter.dirty & ~r.loaded0;
+    for (u32 reg = 0; reg < 32; reg++)
+    {
+      if (!(spill & (1u << reg)))
+        continue;
+      c.I32ConstU(ppc);
+      c.LocalGet(L_GPR0 + reg);
+      c.I32Store(machine.gpr + 4 * reg);
+    }
+    c.End();
+    emitter.loaded &= r.loaded0;
+    emitter.dirty &= emitter.loaded;
+  };
+  while (p < end)
+  {
+    const auto cb = *reinterpret_cast<const AnyCallback*>(p);
+    const u8* payload = p + sizeof(AnyCallback);
+
+    if (cb == AnyCallbackCast(Interpret<false>) || cb == AnyCallbackCast(Interpret<true>))
+    {
+      const auto& op = *reinterpret_cast<const InterpretOperands*>(payload);
+      while (!regions.empty() && regions.back().target == op.current_pc)
+        close_region();
+      prev_pc = op.current_pc;
+      prev_inst = op.inst;
+      if (cb == AnyCallbackCast(Interpret<true>))
+      {
+        c.I32ConstU(ppc);
+        c.I32ConstU(op.current_pc);
+        c.I32Store(off_pc);
+        c.I32ConstU(ppc);
+        c.I32ConstU(op.current_pc + 4);
+        c.I32Store(off_npc);
+      }
+      // func(interpreter, inst): the instruction is passed by pointer in the
+      // WebAssembly C ABI, and the operands hold a copy we can point at.
+      const auto call_interpreter = [&] {
+        c.I32ConstU(static_cast<u32>(reinterpret_cast<uintptr_t>(&op.interpreter)));
+        c.I32ConstU(static_cast<u32>(reinterpret_cast<uintptr_t>(&op.inst)));
+        c.I32ConstU(static_cast<u32>(reinterpret_cast<uintptr_t>(op.func)));
+        c.CallIndirect(TYPE_V_II);
+      };
+      if (!(mode >= 2 && EmitInline(emitter, op.inst, op.current_pc, branch_watch,
+                                     call_interpreter)))
+      {
+        emitter.Flush();
+        call_interpreter();
+        emitter.Invalidate();
+        dolphin_wasm_jit_note_fallback(PPCTables::GetInstructionName(op.inst, op.current_pc));
+      }
+      p = payload + sizeof(InterpretOperands);
+      continue;
+    }
+
+    std::size_t size;
+    if (cb == AnyCallbackCast(InterpretAndCheckExceptions<false>) ||
+        cb == AnyCallbackCast(InterpretAndCheckExceptions<true>))
+      size = sizeof(InterpretAndCheckExceptionsOperands);
+    else if (cb == AnyCallbackCast(EndBlock<false>))
+    {
+      size = sizeof(EndBlockOperands<false>);
+      if ((block.feature_flags & FEATURE_FLAG_PERFMON) == 0)
+      {
+        end_block_inline(*reinterpret_cast<const EndBlockOperands<false>*>(payload),
+                         static_cast<u32>(regions.size()));
+        p = payload + size;
+        continue;
+      }
+    }
+    else if (cb == AnyCallbackCast(EndBlock<true>))
+      size = sizeof(EndBlockOperands<true>);
+    else if (cb == AnyCallbackCast(EndBlockIfTaken))
+    {
+      size = sizeof(EndBlockIfTakenOperands);
+      if ((block.feature_flags & FEATURE_FLAG_PERFMON) == 0)
+      {
+        const auto& op = *reinterpret_cast<const EndBlockIfTakenOperands*>(payload);
+        const u32 target = prev_inst.OPCD == 16 && !prev_inst.LK ?
+                               u32(SignExt16(s16(prev_inst.BD << 2))) +
+                                   (prev_inst.AA ? 0 : prev_pc) :
+                               0;
+        if (!branch_watch && target > prev_pc && op.fallthrough_pc == prev_pc + 4 &&
+            (regions.empty() || target <= regions.back().target) &&
+            target_ahead(p, prev_pc, target))
+        {
+          // taken: npc != fall-through -> jump ahead within the block
+          emitter.Flush(true);
+          regions.push_back({target, emitter.loaded});
+          c.Block();
+          c.I32ConstU(ppc);
+          c.I32Load(machine.npc);
+          c.I32ConstU(op.fallthrough_pc);
+          c.I32Ne();
+          c.BrIf(0);
+          p = payload + size;
+          continue;
+        }
+        // taken: npc != fall-through -> leave the block like EndBlock
+        c.I32ConstU(ppc);
+        c.I32Load(machine.npc);
+        c.I32ConstU(op.fallthrough_pc);
+        c.I32Ne();
+        c.If();
+        end_block_inline({op.downcount, op.num_load_stores, op.num_fp_inst},
+                         1 + static_cast<u32>(regions.size()), true);
+        c.End();
+        p = payload + size;
+        continue;
+      }
+    }
+    else if (cb == AnyCallbackCast(StartProfiledBlock))
+      size = sizeof(StartProfiledBlockOperands);
+    else if (cb == AnyCallbackCast(HLEFunction))
+      size = sizeof(HLEFunctionOperands);
+    else if (cb == AnyCallbackCast(WriteBrokenBlockNPC))
+      size = sizeof(WriteBrokenBlockNPCOperands);
+    else if (cb == AnyCallbackCast(CheckFPU) || cb == AnyCallbackCast(CheckBreakpoint))
+      size = sizeof(CheckHaltOperands);
+    else if (cb == AnyCallbackCast(CheckIdle))
+      size = sizeof(CheckIdleOperands);
+    else
+    {
+      WARN_LOG_FMT(DYNA_REC, "WebAssembly JIT: unknown callback in block {:08x}",
+                   block.effectiveAddress);
+      entry.calls = WASM_JIT_NEVER;
+      return;
+    }
+    call_callback(cb, payload);
+    p = payload + size;
+  }
+
+  while (!regions.empty())  // not expected: targets are checked to be ahead
+    close_region();
+  c.End();        // loop
+  c.I32Const(0);  // not reached: every block ends in EndBlock
+  char name[24];
+  std::snprintf(name, sizeof(name), "ppc_%08x", block.effectiveAddress);
+  const std::vector<u8> module =
+      BuildModule({{L_I32_COUNT, I32}, {L_I64_COUNT, I64}, {L_F64_COUNT, F64}}, c.bytes, name);
+  const int fn = dolphin_wasm_jit_install(module.data(), static_cast<int>(module.size()),
+                                         block.effectiveAddress);
+  if (fn <= 0)
+  {
+    entry.calls = WASM_JIT_NEVER;
+    return;
+  }
+  entry.fn = static_cast<u32>(fn);
+}
+
+#endif  // __EMSCRIPTEN__
+
+#ifdef __EMSCRIPTEN__
+#include "Common/GekkoDisassembler.h"
+#include "Core/Core.h"
+#include "Core/PowerPC/MMU.h"
+#include "Core/System.h"
+
+// Console helper for profiling: a profile names compiled blocks ppc_<address>;
+//   EJS_emulator.Module._dolphin_disasm(0x80123456, 40)
+// prints that many PowerPC instructions from there.
+extern "C" EMSCRIPTEN_KEEPALIVE void dolphin_disasm(u32 address, int count)
+{
+  Core::System& system = Core::System::GetInstance();
+  Core::CPUThreadGuard guard(system);
+  std::string out;
+  for (int i = 0; i < count; i++)
+  {
+    const u32 a = address + 4 * i;
+    const u32 op = PowerPC::MMU::HostRead_Instruction(guard, a);
+    out += fmt::format("{:08x}  {:08x}  {}\n", a, op, Common::GekkoDisassembler::Disassemble(op, a));
+  }
+  dolphin_print_text(out.c_str());
+}
+#endif
+
