+void OGLGfx::BreakFeedbackLoops()
+{
+  // WebGL refuses any draw while a texture attached to the bound framebuffer is
+  // also bound to a texture unit the program's samplers use ("Feedback loop
+  // formed between Framebuffer and active Texture"), even if it isn't sampled.
+  // Desktop GL allows this. Dolphin leaves stale bindings, e.g. a texture-cache
+  // entry it later renders into: unbind those.
+  static bool published = false;
+  if (!published)
+  {
+    published = true;
+    dolphin_publish_gl_stats(&g_webgl_stats, sizeof(g_webgl_stats) / 4);
+  }
+  static const bool enabled = WebGLDebugFlag("DOLPHIN_GL_FEEDBACK", 1) != 0;
+  if (!enabled)
+    return;
+  if (!m_current_framebuffer)
+    return;
+  const AbstractTexture* color = m_current_framebuffer->GetColorAttachment();
+  const AbstractTexture* depth = m_current_framebuffer->GetDepthAttachment();
+  if (!color && !depth)
+    return;
+  for (size_t i = 0; i < m_bound_textures.size(); i++)
+  {
+    const AbstractTexture* t = m_bound_textures[i];
+    if (!t || (t != color && t != depth))
+      continue;
+    glActiveTexture(static_cast<GLenum>(GL_TEXTURE0 + i));
+    glBindTexture(static_cast<const OGLTexture*>(t)->GetGLTarget(), 0);
+    m_bound_textures[i] = nullptr;
+    WEBGL_STAT(feedback_unbinds, 1);
+  }
