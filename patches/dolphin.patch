+                                 u32 layer, u32 level)
+{
+  // No MSAA in this backend: a resolve is a plain copy.
+  wgpu_tex_copy(TexId(src), layer, level, rect.left, rect.top, m_id, layer, level, rect.left,
+                rect.top, rect.GetWidth(), rect.GetHeight());
