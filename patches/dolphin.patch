+std::unique_ptr<AbstractPipeline> Gfx::CreatePipeline(const AbstractPipelineConfig& config,
+                                                      const void*, size_t)
+{
+  auto sid = [](const AbstractShader* s) {
+    return s ? static_cast<const Shader*>(s)->GetId() : 0;
+  };
+  const int vf = config.vertex_format ?
+                     static_cast<const VertexFormat*>(config.vertex_format)->GetId() :
+                     0;
+  const int usage = config.usage == AbstractPipelineUsage::Utility ? 2 :
+                    config.usage == AbstractPipelineUsage::GXUber ? 1 :
+                                                                    0;
+  const int id = wgpu_pipeline_create(sid(config.vertex_shader), sid(config.pixel_shader), vf,
+                                      config.rasterization_state.hex, config.depth_state.hex,
+                                      config.blending_state.hex, config.framebuffer_state.hex,
+                                      usage);
+  if (!id)
+    return nullptr;
+  return std::make_unique<Pipeline>(config, id);
+}
