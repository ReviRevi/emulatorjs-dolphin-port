+  // partial draws a quad through the shared utility path.
+  const int fw = m_current_framebuffer->GetWidth(), fh = m_current_framebuffer->GetHeight();
+  if (target_rc == MathUtil::Rectangle<int>(0, 0, fw, fh))
+  {
+    if (bpmem.zcontrol.pixel_format == PixelFormat::RGB565_Z16 ||
+        bpmem.zcontrol.pixel_format == PixelFormat::RGB8_Z24 ||
+        bpmem.zcontrol.pixel_format == PixelFormat::Z24)
+    {
+      alpha_enable = true;
+      color &= 0x00FFFFFF;
+    }
+    const bool c_ok = (color_enable && alpha_enable) || !m_current_framebuffer->HasColorBuffer();
+    const bool z_ok = z_enable || !m_current_framebuffer->HasDepthBuffer();
+    if (c_ok && z_ok)
+    {
+      float zn = static_cast<float>(z & 0xFFFFFF) / 16777216.0f;
+      if (!g_backend_info.bSupportsReversedDepthRange)
+        zn = 1.0f - zn;
+      wgpu_set_framebuffer(static_cast<Framebuffer*>(m_current_framebuffer)->GetId(), 2,
+                           ((color >> 16) & 0xFF) / 255.0f, ((color >> 8) & 0xFF) / 255.0f,
+                           (color & 0xFF) / 255.0f, ((color >> 24) & 0xFF) / 255.0f, zn);
+      return;
+    }
+  }
+  AbstractGfx::ClearRegion(target_rc, color_enable, alpha_enable, z_enable, color, z);
+}
+void Gfx::SetScissorRect(const MathUtil::Rectangle<int>& rc)
+{
+  wgpu_set_scissor(rc.left, rc.top, rc.GetWidth(), rc.GetHeight());
+}
+void Gfx::SetTexture(u32 index, const AbstractTexture* texture)
+{
+  if (index < 16)
+    m_bound_textures[index] = static_cast<const Texture*>(texture);
+  wgpu_set_texture(index, TexId(texture));
+}
+void Gfx::SetSamplerState(u32 index, const SamplerState& state)
+{
+  wgpu_set_sampler(index, state.tm0.hex, state.tm1.hex);
+}
+void Gfx::UnbindTexture(const AbstractTexture* texture)
+{
+  for (u32 i = 0; i < 16; i++)
+  {
+    if (m_bound_textures[i] == texture)
+    {
+      m_bound_textures[i] = nullptr;
+      wgpu_set_texture(i, 0);
+    }
+  }
+}
+void Gfx::SetViewport(float x, float y, float width, float height, float near_depth,
+                      float far_depth)
+{
+  wgpu_set_viewport(x, y, width, height, near_depth, far_depth);
+}
+void Gfx::Draw(u32 base_vertex, u32 num_vertices)
+{
+  wgpu_draw(base_vertex, num_vertices);
+}
+void Gfx::DrawIndexed(u32 base_index, u32 num_indices, u32 base_vertex)
+{
+  wgpu_draw_indexed(base_index, num_indices, base_vertex);
+}
+
+void Gfx::EnsureBackbuffer()
+{
+  const int w = std::max(1, g_surface_width), h = std::max(1, g_surface_height);
+  if (m_backbuffer && static_cast<int>(m_backbuffer->GetWidth()) == w &&
+      static_cast<int>(m_backbuffer->GetHeight()) == h)
+    return;
+  m_backbuffer_fb.reset();
+  m_backbuffer.reset();
+  TextureConfig cfg(w, h, 1, 1, 1, AbstractTextureFormat::RGBA8, AbstractTextureFlag_RenderTarget,
+                    AbstractTextureType::Texture_2DArray);
+  m_backbuffer.reset(static_cast<Texture*>(CreateTexture(cfg, "backbuffer").release()));
+  m_backbuffer_fb.reset(
+      static_cast<Framebuffer*>(CreateFramebuffer(m_backbuffer.get(), nullptr, {}).release()));
+}
+bool Gfx::BindBackbuffer(const ClearColor& clear_color)
+{
+  EnsureBackbuffer();
+  SetAndClearFramebuffer(m_backbuffer_fb.get(), clear_color, 1.0f);
+  return true;
+}
+void Gfx::PresentBackbuffer()
+{
+  wgpu_present(m_backbuffer ? m_backbuffer->GetId() : 0,
+               g_get_frontend_framebuffer ? g_get_frontend_framebuffer() : 0);
+  if (g_frontend_present && m_backbuffer)
+    g_frontend_present(m_backbuffer->GetWidth(), m_backbuffer->GetHeight());
+}
+void Gfx::Flush()
+{
+  wgpu_flush();
+}
+void Gfx::WaitForGPUIdle()
+{
+  wgpu_flush();
+}
+SurfaceInfo Gfx::GetSurfaceInfo() const
+{
+  return {static_cast<u32>(std::max(1, g_surface_width)),
+          static_cast<u32>(std::max(1, g_surface_height)), 1.0f, AbstractTextureFormat::RGBA8};
+}
+
+// ---------------------------------------------------------------------------
+// Vertex manager
+// ---------------------------------------------------------------------------
+void VertexManager::CommitBuffer(u32 num_vertices, u32 vertex_stride, u32 num_indices,
+                                 u32* out_base_vertex, u32* out_base_index)
+{
+  *out_base_vertex = num_vertices ?
+                         wgpu_vertices(m_cpu_vertex_buffer.data(), num_vertices * vertex_stride,
+                                       vertex_stride) :
+                         0;
+  *out_base_index = num_indices ? wgpu_indices(m_cpu_index_buffer.data(), num_indices) : 0;
+}
+void VertexManager::UploadUniforms()
+{
+  auto& system = Core::System::GetInstance();
+  auto& vsm = system.GetVertexShaderManager();
+  auto& gsm = system.GetGeometryShaderManager();
+  auto& psm = system.GetPixelShaderManager();
+  if (psm.dirty)
+  {
+    wgpu_uniforms(0, &psm.constants, sizeof(psm.constants));
+    psm.dirty = false;
+  }
+  if (vsm.dirty)
+  {
+    wgpu_uniforms(1, &vsm.constants, sizeof(vsm.constants));
+    vsm.dirty = false;
+  }
+  if (gsm.dirty)
+  {
+    wgpu_uniforms(2, &gsm.constants, sizeof(gsm.constants));
+    gsm.dirty = false;
+  }
+}
+void VertexManager::UploadUtilityUniforms(const void* uniforms, u32 uniforms_size)
+{
+  InvalidateConstants();
+  wgpu_uniforms(3, uniforms, uniforms_size);
+}
+
+// ---------------------------------------------------------------------------
+// Backend
+// ---------------------------------------------------------------------------
+void VideoBackend::InitBackendInfo(const WindowSystemInfo&)
+{
+  auto& b = g_backend_info;
+  b.api_type = APIType::Metal;  // same GLSL conventions as the Metal backend
+  b.MaxTextureSize = 8192;
+  b.bUsesLowerLeftOrigin = false;
+  b.bSupportsExclusiveFullscreen = false;
+  b.bSupportsDualSourceBlend = IsReady() && wgpu_feature(0);
+  b.bSupportsPrimitiveRestart = false;
+  b.bSupportsGeometryShaders = false;
+  b.bSupportsComputeShaders = false;
+  b.bSupports3DVision = false;
+  b.bSupportsEarlyZ = true;
+  b.bSupportsBindingLayout = true;
+  b.bSupportsBBox = false;
+  b.bSupportsGSInstancing = false;
+  b.bSupportsPostProcessing = true;
+  b.bSupportsPaletteConversion = false;
+  b.bSupportsClipControl = true;
+  b.bSupportsSSAA = false;
+  b.bSupportsFragmentStoresAndAtomics = false;
+  b.bSupportsReversedDepthRange = false;
+  b.bSupportsLogicOp = false;
+  b.bSupportsMultithreading = false;
+  b.bSupportsGPUTextureDecoding = false;
+  b.bSupportsCopyToVram = true;
+  b.bSupportsBitfield = true;
+  b.bSupportsDynamicSamplerIndexing = false;
+  b.bSupportsFramebufferFetch = false;
+  b.bSupportsBackgroundCompiling = false;
+  b.bSupportsLargePoints = false;
+  b.bSupportsPartialDepthCopies = true;
+  b.bSupportsDepthReadback = true;
+  b.bSupportsShaderBinaries = false;
+  b.bSupportsPipelineCacheData = false;
+  b.bSupportsCoarseDerivatives = false;
+  b.bSupportsTextureQueryLevels = true;
+  b.bSupportsLodBiasInSampler = false;
+  b.bSupportsSettingObjectNames = false;
+  b.bSupportsPartialMultisampleResolve = false;
+  b.bSupportsDynamicVertexLoader = false;
+  b.bSupportsVSLinePointExpand = false;
+  b.bSupportsDepthClamp = false;
+  b.bSupportsST3CTextures = IsReady() && wgpu_feature(2);
+  b.bSupportsBPTCTextures = b.bSupportsST3CTextures;
+  b.bSupportsHDROutput = false;
+  b.Adapters.clear();
+  b.AAModes = {1};
+}
+
+bool VideoBackend::Initialize(const WindowSystemInfo& wsi)
+{
+  Kick();
+  if (!IsReady())
+  {
+    PanicAlertFmt("WebGPU is not available (device not ready). Reload with WebGPU off.");
+    return false;
+  }
+  InitBackendInfo(wsi);
+  UpdateActiveConfig();
+  return InitializeShared(std::make_unique<Gfx>(), std::make_unique<VertexManager>(),
+                          std::make_unique<Null::PerfQuery>(),
+                          std::make_unique<Null::NullBoundingBox>());
+}
+void VideoBackend::Shutdown()
+{
+  ShutdownShared();
+  wgpu_flush();
+}
+}  // namespace WGPU
