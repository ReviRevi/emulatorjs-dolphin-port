+VertexFormat::VertexFormat(const PortableVertexDeclaration& decl) : NativeVertexFormat(decl)
+{
+  int d[1 + 16 * 6] = {};
+  d[0] = decl.stride;
+  auto set = [&](ShaderAttrib loc, const AttributeFormat& f) {
+    const int i = static_cast<int>(loc);
+    int* a = &d[1 + i * 6];
+    a[0] = i;
+    a[1] = static_cast<int>(f.type) >= 4 ? 4 : static_cast<int>(f.type);
+    a[2] = f.components;
+    a[3] = f.offset;
+    a[4] = f.enable;
+    a[5] = f.integer;
+  };
+  set(ShaderAttrib::Position, decl.position);
+  for (int i = 0; i < 3; i++)
+    set(ShaderAttrib::Normal + i, decl.normals[i]);
+  for (int i = 0; i < 2; i++)
+    set(ShaderAttrib::Color0 + i, decl.colors[i]);
+  for (int i = 0; i < 8; i++)
+    set(ShaderAttrib::TexCoord0 + i, decl.texcoords[i]);
+  set(ShaderAttrib::PositionMatrix, decl.posmtx);
+  m_id = wgpu_vfmt_create(d);
+}
