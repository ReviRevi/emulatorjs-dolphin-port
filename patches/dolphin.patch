+void StagingTexture::CopyFromTexture(const AbstractTexture* src,
+                                     const MathUtil::Rectangle<int>& src_rect, u32 src_layer,
+                                     u32 src_level, const MathUtil::Rectangle<int>& dst_rect)
+{
+  const int off = static_cast<int>(dst_rect.top * m_map_stride + dst_rect.left * m_texel_size);
+  wgpu_st_copy_from(m_id, TexId(src), src_layer, src_level, src_rect.left, src_rect.top,
+                    src_rect.GetWidth(), src_rect.GetHeight(), off,
+                    static_cast<int>(m_map_stride));
+  m_needs_flush = true;
+}
+void StagingTexture::CopyToTexture(const MathUtil::Rectangle<int>& src_rect, AbstractTexture* dst,
+                                   const MathUtil::Rectangle<int>& dst_rect, u32 dst_layer,
+                                   u32 dst_level)
+{
+  const u8* p = m_data.data() + src_rect.top * m_map_stride + src_rect.left * m_texel_size;
+  wgpu_tex_upload(TexId(dst), dst_level, dst_layer, dst_rect.left, dst_rect.top,
+                  dst_rect.GetWidth(), dst_rect.GetHeight(),
+                  static_cast<int>(m_map_stride / m_texel_size), p,
+                  static_cast<int>(m_data.size() - (p - m_data.data())));
+}
+bool StagingTexture::Map()
+{
