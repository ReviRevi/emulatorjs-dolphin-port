+
+namespace
+{
+constexpr u32 WASM_JIT_NEVER = 0xffffffff;  // compile failed: stay interpreted
+
+// Locals of a compiled block function.
+enum Local : u32
+{
+  L_EA = 0,    // effective address
+  L_E = 1,     // BAT table entry
+  L_PHYS = 2,  // physical address
+  L_WI = 3,    // write-through / cache-inhibited bit from the BAT
+  L_HOST = 4,  // host address of the access
+  L_T = 5,     // scratch
+  L_V = 6,     // result value
+  L_V2 = 7,    // second value (psq_st's ps1); never touched by Translate
+  L_GPR0 = 8,  // r0..r31 cached in locals (Emitter::PushGPR / SetGPR)
+  L_I32_COUNT = 8 + 32,
+  L_X = L_I32_COUNT,  // i64 scratch
+  L_X2,               // i64 scratch
+  L_I64_END,
+  L_F0 = L_I64_END,   // f64 scratch
+  L_F1,
+  L_F2,
+  L_F3,
+  L_F4,
+  L_F5,
+  L_F64_END,
+};
+constexpr u32 L_I64_COUNT = L_I64_END - L_X;
+constexpr u32 L_F64_COUNT = L_F64_END - L_F0;
+
+// Gather pipe overflow check after an inline write (GPFifoManager::FastCheckGatherPipe).
+static void WasmJitGatherCheck(u32 gpfifo, u32)
+{
+  reinterpret_cast<GPFifo::GPFifoManager*>(static_cast<uintptr_t>(gpfifo))->FastCheckGatherPipe();
+}
+
+// Everything the inline code needs to know about the emulated machine. The
+// addresses are fixed for the lifetime of the emulation (and blocks are
+// thrown away with the JIT cache when they change).
+struct Machine
+{
+  u32 ppc;          // &PowerPCState
+  u32 gpr;          // offsetof(gpr)
+  u32 cr;           // offsetof(cr.fields)
+  u32 msr;          // offsetof(msr)
+  u32 xer_ca;       // offsetof(xer_ca)
+  u32 xer_so_ov;    // offsetof(xer_so_ov)
+  u32 xer_stringctrl;  // offsetof(xer_stringctrl)
+  u32 dcache;       // offsetof(m_enable_dcache)
+  u32 cr_table;     // &ConditionRegister::s_crTable
+  u32 dbat;         // &MMU::m_dbat_table
+  u32 ram;          // Memory::GetRAM()
+  u32 ram_mask;
+  u32 exram;        // Memory::GetEXRAM() (0 on GameCube)
+  u32 exram_size;
+  u32 pc;           // offsetof(pc)
+  u32 npc;          // offsetof(npc)
+  u32 spr;          // offsetof(spr)
+  u32 downcount;    // offsetof(downcount)
+  u32 feature_flags;  // offsetof(feature_flags)
+  u32 ps;           // offsetof(ps): paired singles, {u64 ps0, ps1} as double bits
+  u32 fpscr;        // offsetof(fpscr)
+  u32 gp_ptr;       // offsetof(gather_pipe_ptr)
+  u32 gp_base;      // offsetof(gather_pipe_base_ptr)
+  u32 gpfifo;       // &GPFifoManager
+  u32 ram_size;     // Memory::GetRamSizeReal()
+  bool fast_ram;    // 0x80000000 + [0, ram_size) is BAT-mapped to RAM, cached, and
+                    // data cache emulation is off: see Translate
+  bool dr;          // the block runs with MSR.DR set (blocks are per MSR.DR/IR,
+                    // and instructions that change the MSR end the block)
+};
+
+class Emitter
+{
+public:
+  Emitter(WasmJit::CodeWriter& c, const Machine& m) : c(c), m(m) {}
+
+  // ---- registers ----
+  // GPRs live in locals within a block: loaded on first use, written back
+  // (Flush) before anything that reads PowerPCState (Interpreter calls,
+  // callbacks, block exit) and reloaded after anything that may write it.
+  //
+  // Rule for control flow: a register must not be loaded for the first time
+  // inside a conditional path (its local would be stale on the other path),
+  // so ops Use() their registers before branching.
+  void PushGPR(u32 r)
+  {
+    Use(r);
+    c.LocalGet(L_GPR0 + r);
+  }
+  void Use(u32 r)
+  {
+    if (loaded & (1u << r))
+      return;
+    c.I32ConstU(m.ppc);
+    c.I32Load(m.gpr + 4 * r);
+    c.LocalSet(L_GPR0 + r);
+    loaded |= 1u << r;
+  }
+  // r = value()
+  template <typename F>
+  void SetGPR(u32 r, F value)
+  {
+    value();
+    c.LocalSet(L_GPR0 + r);
+    loaded |= 1u << r;
+    dirty |= 1u << r;
+  }
+  void SetGPRFromLocal(u32 r, u32 local)
+  {
+    SetGPR(r, [&] { c.LocalGet(local); });
+  }
+  // Write dirty registers back to PowerPCState. With `keep_dirty`, only emit
+  // the stores (for one branch of a conditional; the other branch still has
+  // them dirty).
+  void Flush(bool keep_dirty = false)
+  {
+    for (u32 r = 0; r < 32; r++)
+    {
+      if (!(dirty & (1u << r)))
+        continue;
+      c.I32ConstU(m.ppc);
+      c.LocalGet(L_GPR0 + r);
+      c.I32Store(m.gpr + 4 * r);
+    }
+    if (!keep_dirty)
+      dirty = 0;
+  }
+  // After something that may have written registers in PowerPCState.
+  void Invalidate() { loaded = dirty = 0; }
+  // Reload r from PowerPCState into its local (it stays marked loaded).
+  void Reload(u32 r)
+  {
+    c.I32ConstU(m.ppc);
+    c.I32Load(m.gpr + 4 * r);
+    c.LocalSet(L_GPR0 + r);
+  }
+
+  u32 loaded = 0;
+  u32 dirty = 0;
+
+  void PushRAOrZero(u32 ra)
+  {
+    if (ra)
+      PushGPR(ra);
+    else
+      c.I32Const(0);
+  }
+
+  // CR0 from a 32-bit result in `local` (Interpreter::Helper_UpdateCR0).
+  void UpdateCR0(u32 local)
+  {
+    c.I32ConstU(m.ppc);
+    c.LocalGet(local);
+    c.I64ExtendI32S();
+    c.LocalGet(local);
+    c.I32Eqz();
+    c.I64ExtendI32U();
+    c.I64Const(63);
+    c.I64Shl();
+    c.I64Or();
+    c.I64Const(static_cast<s64>(~(1ULL << PowerPC::CR_EMU_SO_BIT)));
+    c.I64And();
+    PushSO();
+    c.I64ExtendI32U();
+    c.I64Const(PowerPC::CR_EMU_SO_BIT);
+    c.I64Shl();
+    c.I64Or();
+    c.I64Store(m.cr);
+  }
+  void PushSO()
+  {
+    c.I32ConstU(m.ppc);
+    c.I32Load8U(m.xer_so_ov);
+    c.I32Const(1);
+    c.I32ShrU();
+  }
+  // CR field from an LT/GT/EQ comparison of locals L_T (a) and L_V (b)
+  // (Interpreter::Helper_IntCompare).
+  void Compare(u32 crf, bool is_signed)
+  {
+    c.I32ConstU(m.ppc);
+    // index = LT*8 | GT*4 | EQ*2 | SO
+    c.LocalGet(L_T);
+    c.LocalGet(L_V);
+    is_signed ? c.I32LtS() : c.I32LtU();
+    c.I32Const(3);
+    c.I32Shl();
+    c.LocalGet(L_T);
+    c.LocalGet(L_V);
+    is_signed ? c.I32GtS() : c.I32GtU();
+    c.I32Const(2);
+    c.I32Shl();
+    c.I32Or();
+    c.LocalGet(L_T);
+    c.LocalGet(L_V);
+    c.I32Eq();
+    c.I32Const(1);
+    c.I32Shl();
+    c.I32Or();
+    PushSO();
+    c.I32Or();
+    c.I32Const(3);
+    c.I32Shl();
+    c.I32ConstU(m.cr_table);
+    c.I32Add();
+    c.I64Load();
+    c.I64Store(m.cr + 8 * crf);
+  }
+  void SetCarryFromStack()
+  {
+    // value (0/1) on the stack -> xer_ca
+    c.LocalSet(L_T);
+    c.I32ConstU(m.ppc);
+    c.LocalGet(L_T);
+    c.I32Store8(m.xer_ca);
+  }
+  void PushCarry()
+  {
+    c.I32ConstU(m.ppc);
+    c.I32Load8U(m.xer_ca);
+  }
+
+  // Pushes CR bit `bi` (0/1), like ConditionRegister::GetBit.
+  void PushCRBit(u32 bi)
+  {
+    c.I32ConstU(m.ppc);
+    c.I64Load(m.cr + 8 * (bi >> 2));
+    switch (bi & 3)
+    {
+    case 0:  // LT: bit 62
+      c.I64Const(PowerPC::CR_EMU_LT_BIT);
+      c.I64ShrU();
+      c.I32WrapI64();
+      c.I32Const(1);
+      c.I32And();
+      break;
+    case 1:  // GT: (s64)cr_val > 0
+      c.I64Const(0);
+      c.I64GtS();
+      break;
+    case 2:  // EQ: low 32 bits are zero
+      c.I32WrapI64();
+      c.I32Eqz();
+      break;
+    default:  // SO: bit 59
+      c.I64Const(PowerPC::CR_EMU_SO_BIT);
+      c.I64ShrU();
+      c.I32WrapI64();
+      c.I32Const(1);
+      c.I32And();
+      break;
+    }
+  }
+  // ConditionRegister::GetField: the 4-bit LT|GT|EQ|SO value of a CR field.
+  void PushCRField(u32 crf)
+  {
+    for (u32 i = 0; i < 4; i++)
+    {
+      PushCRBit(crf * 4 + i);
+      if (i != 3)
+      {
+        c.I32Const(3 - i);
+        c.I32Shl();
+      }
+      if (i != 0)
+        c.I32Or();
+    }
+  }
+  // ConditionRegister::SetField from the 4-bit value on the stack.
+  void StoreCRField(u32 crf)
+  {
+    c.I32Const(3);
+    c.I32Shl();
+    c.I32ConstU(m.cr_table);
+    c.I32Add();
+    c.I64Load();
+    c.LocalSet(L_X);
+    c.I32ConstU(m.ppc);
+    c.LocalGet(L_X);
+    c.I64Store(m.cr + 8 * crf);
+  }
+  void PushSPR(u32 index)
+  {
+    c.I32ConstU(m.ppc);
+    c.I32Load(m.spr + 4 * index);
+  }
+  template <typename F>
+  void SetSPR(u32 index, F value)
+  {
+    c.I32ConstU(m.ppc);
+    value();
+    c.I32Store(m.spr + 4 * index);
+  }
+  void SetNPC(u32 local)
+  {
+    c.I32ConstU(m.ppc);
+    c.LocalGet(local);
+    c.I32Store(m.npc);
+  }
+
+
+  // ---- floating point ----
+  // Paired-single registers stay in PowerPCState (not cached in locals).
+  u32 PSOff(u32 r, u32 half) const { return m.ps + 16 * r + 8 * half; }
+  void PushPS(u32 r, u32 half)  // as f64
+  {
+    c.I32ConstU(m.ppc);
+    c.F64Load(PSOff(r, half));
+  }
+  void PushPSBits(u32 r, u32 half)  // as i64
+  {
+    c.I32ConstU(m.ppc);
+    c.I64Load(PSOff(r, half));
+  }
+  void StorePSFromLocal(u32 r, u32 half, u32 local_f64)
+  {
+    c.I32ConstU(m.ppc);
+    c.LocalGet(local_f64);
+    c.F64Store(PSOff(r, half));
+  }
+  void StorePSBitsFromLocal(u32 r, u32 half, u32 local_i64)
+  {
+    c.I32ConstU(m.ppc);
+    c.LocalGet(local_i64);
+    c.I64Store(PSOff(r, half));
+  }
+  // br_if `depth` if local f64 is NaN: NaNs and their FPSCR side effects are
+  // left to the Interpreter.
+  void BrIfNaN(u32 local_f64, u32 depth)
+  {
+    c.LocalGet(local_f64);
+    c.LocalGet(local_f64);
+    c.F64Ne();
+    c.BrIf(depth);
+  }
+  void PushFPSCRBit(u32 mask)
+  {
+    c.I32ConstU(m.ppc);
+    c.I32Load(m.fpscr);
+    c.I32ConstU(mask);
+    c.I32And();
+  }
+  // Force25Bit (Interpreter_FPUtils.h), normal-number path: round the
+  // mantissa to 25 bits. Pushes the result. (The subnormal-double path is
+  // not reproduced; GameCube values never get there.)
+  void Force25Bit(u32 local_f64)
+  {
+    c.LocalGet(local_f64);
+    c.I64ReinterpretF64();
+    c.LocalTee(L_X);
+    c.I64Const(static_cast<s64>(0xFFFFFFFFF8000000ULL));
+    c.I64And();
+    c.LocalGet(L_X);
+    c.I64Const(0x8000000);
+    c.I64And();
+    c.I64Add();
+    c.F64ReinterpretI64();
+  }
+  // ForceSingle (Interpreter_FPUtils.h): round to single and back, with the
+  // FPSCR.NI flush. local -> stack (f64).
+  void ForceSingle(u32 local_f64)
+  {
+    // flushed: sign only (selected when NI && |x| < smallest normal single)
+    c.LocalGet(local_f64);
+    c.I64ReinterpretF64();
+    c.I64Const(static_cast<s64>(0x8000000000000000ULL));
+    c.I64And();
+    c.F64ReinterpretI64();
+    // normal conversion
+    c.LocalGet(local_f64);
+    c.F32DemoteF64();
+    c.F64PromoteF32();
+    // NI && (bits & ~sign) < 0x3810000000000000
+    PushFPSCRBit(1u << 2);  // NI
+    c.I32Const(0);
+    c.I32Ne();
+    c.LocalGet(local_f64);
+    c.I64ReinterpretF64();
+    c.I64Const(0x7FFFFFFFFFFFFFFFLL);
+    c.I64And();
+    c.I64Const(0x3810000000000000LL);
+    c.I64LtU();
+    c.I32And();
+    c.Select();
+  }
+  // ForceDouble: flush subnormal doubles to zero when FPSCR.NI. local -> stack.
+  void ForceDouble(u32 local_f64)
+  {
+    c.LocalGet(local_f64);
+    c.I64ReinterpretF64();
+    c.I64Const(static_cast<s64>(0x8000000000000000ULL));
+    c.I64And();
+    c.F64ReinterpretI64();
+    c.LocalGet(local_f64);
+    PushFPSCRBit(1u << 2);
+    c.I32Const(0);
+    c.I32Ne();
+    // exponent == 0 && fraction != 0
+    c.LocalGet(local_f64);
+    c.I64ReinterpretF64();
+    c.I64Const(0x7FF0000000000000LL);
+    c.I64And();
+    c.I64Eqz();
+    c.I32And();
+    c.LocalGet(local_f64);
+    c.I64ReinterpretF64();
+    c.I64Const(0x000FFFFFFFFFFFFFLL);
+    c.I64And();
+    c.I64Const(0);
+    c.I64Ne();
+    c.I32And();
+    c.Select();
+  }
+  // ConvertToDouble (Interpreter_FPUtils.h) of the single in local i32 `v`
+  // -> stack (i64 bits).
+  void ConvertToDouble(u32 v)
+  {
+    // e = (v >> 23) & 0xff; subnormal (e == 0 && frac != 0): exact promote
+    c.LocalGet(v);
+    c.I32ConstU(0x7f800000);
+    c.I32And();
+    c.I32Eqz();
+    c.LocalGet(v);
+    c.I32ConstU(0x007fffff);
+    c.I32And();
+    c.I32Const(0);
+    c.I32Ne();
+    c.I32And();
+    c.If(WasmJit::I64);
+    {
+      c.LocalGet(v);
+      c.F32ReinterpretI32();
+      c.F64PromoteF32();
+      c.I64ReinterpretF64();
+    }
+    c.Else();
+    {
+      // ((x & 0xc0000000) << 32) | ((x & 0x3fffffff) << 29) | z
+      c.LocalGet(v);
+      c.I64ExtendI32U();
+      c.LocalTee(L_X2);
+      c.I64Const(0xc0000000LL);
+      c.I64And();
+      c.I64Const(32);
+      c.I64Shl();
+      c.LocalGet(L_X2);
+      c.I64Const(0x3fffffffLL);
+      c.I64And();
+      c.I64Const(29);
+      c.I64Shl();
+      c.I64Or();
+      // z = 0x3800000000000000 if e == 255 || (e != 0 && !(x & 0x40000000))
+      c.I64Const(0x3800000000000000LL);
+      c.I64Const(0);
+      c.LocalGet(v);
+      c.I32ConstU(0x7f800000);
+      c.I32And();
+      c.LocalTee(L_T);
+      c.I32ConstU(0x7f800000);
+      c.I32Eq();
+      c.LocalGet(L_T);
+      c.I32Const(0);
+      c.I32Ne();
+      c.LocalGet(v);
+      c.I32ConstU(0x40000000);
+      c.I32And();
+      c.I32Eqz();
+      c.I32And();
+      c.I32Or();
+      c.Select();
+      c.I64Or();
+    }
+    c.End();
+  }
+  // Single from double bits in local i64 `x`, the stfs way (ConvertToSingle):
+  // pushes the u32, or branches to `depth` for the denormal-result case.
+  // With ftz (psq_st: ConvertToSingleFTZ) that case becomes the sign instead.
+  void ConvertToSingle(u32 x, bool ftz, u32 depth)
+  {
+    // exp = (x >> 52) & 0x7ff; simple path when exp > 896 || exp < 874 || |x| == 0
+    c.LocalGet(x);
+    c.I64Const(52);
+    c.I64ShrU();
+    c.I32WrapI64();
+    c.I32ConstU(0x7ff);
+    c.I32And();
+    c.LocalTee(L_T);
+    c.I32ConstU(896);
+    c.I32LeU();
+    c.LocalGet(L_T);
+    c.I32ConstU(ftz ? 0 : 874);
+    c.I32GeU();
+    c.I32And();
+    c.LocalGet(x);
+    c.I64Const(0x7FFFFFFFFFFFFFFFLL);
+    c.I64And();
+    c.I64Const(0);
+    c.I64Ne();
+    c.I32And();
+    if (ftz)
+    {
+      c.If(WasmJit::I32);
+      c.LocalGet(x);
+      c.I64Const(32);
+      c.I64ShrU();
+      c.I32WrapI64();
+      c.I32ConstU(0x80000000);
+      c.I32And();
+      c.Else();
+    }
+    else
+    {
+      c.BrIf(depth);
+    }
+    // ((x >> 32) & 0xc0000000) | ((x >> 29) & 0x3fffffff)
+    c.LocalGet(x);
+    c.I64Const(32);
+    c.I64ShrU();
+    c.I32WrapI64();
+    c.I32ConstU(0xc0000000);
+    c.I32And();
+    c.LocalGet(x);
+    c.I64Const(29);
+    c.I64ShrU();
+    c.I32WrapI64();
+    c.I32ConstU(0x3fffffff);
+    c.I32And();
+    c.I32Or();
+    if (ftz)
+      c.End();
+  }
+  void Bswap64()  // i64 on the stack
+  {
+    c.LocalTee(L_X2);
+    c.I32WrapI64();
+    Bswap32();
+    c.I64ExtendI32U();
+    c.I64Const(32);
+    c.I64Shl();
+    c.LocalGet(L_X2);
+    c.I64Const(32);
+    c.I64ShrU();
+    c.I32WrapI64();
+    Bswap32();
+    c.I64ExtendI32U();
+    c.I64Or();
+  }
+
+  void Bswap32()  // value on the stack
+  {
+    c.LocalTee(L_T);
+    c.I32Const(8);
+    c.I32Rotl();
+    c.I32ConstU(0x00ff00ff);
+    c.I32And();
+    c.LocalGet(L_T);
+    c.I32Const(8);
+    c.I32Rotr();
+    c.I32ConstU(0xff00ff00);
+    c.I32And();
+    c.I32Or();
+  }
+
+  // ---- memory ----
+  // Resolves L_EA to a host address in L_HOST, or branches to `slow` (a label
+  // `depth` levels out) when the fast path doesn't apply: page-crossing
+  // access, page-table translation, anything that isn't plain RAM, the data
+  // cache emulation, or a cache-inhibited store that isn't a full aligned word.
+  // Mirrors MMU::ReadFromHardware / WriteToHardware for the RAM case.
+  void Translate(u32 size, bool store, u32 depth)
+  {
+    // Fast path: games keep main RAM at 0x80000000 with the standard cached
+    // BAT, so an address in [0x80000000, 0x80000000 + RAM size) is just an
+    // offset into RAM. Checked at compile time (fast_ram): blocks are thrown
+    // away when the BATs change (MMU::DBATUpdated clears the JIT cache).
+    // RAM is contiguous on the host, so page crossings don't matter here.
+    if (m.fast_ram && m.dr)
+    {
+      c.LocalGet(L_EA);
+      c.I32ConstU(0x80000000);
+      c.I32Sub();
+      c.LocalTee(L_PHYS);
+      c.I32ConstU(m.ram_size - size);
+      c.I32LeU();
+      c.If();
+      c.LocalGet(L_PHYS);
+      c.I32ConstU(m.ram);
+      c.I32Add();
+      c.LocalSet(L_HOST);
+      c.Else();
+      TranslateGeneric(size, store, depth + 1);
+      c.End();
+      return;
+    }
+    TranslateGeneric(size, store, depth);
+  }
+
+  void TranslateGeneric(u32 size, bool store, u32 depth)
+  {
+    if (size > 1)
+    {
+      c.LocalGet(L_EA);
+      c.I32ConstU(0xfff);
+      c.I32And();
+      c.I32ConstU(0x1000 - size);
+      c.I32GtU();
+      c.BrIf(depth);
+    }
+    if (!m.dr)
+    {
+      // Real mode: the effective address is physical.
+      c.LocalGet(L_EA);
+      c.LocalSet(L_PHYS);
+      c.I32Const(0);
+      c.LocalSet(L_WI);
+    }
+    else
+    {
+      // translate through the data BATs
+      c.LocalGet(L_EA);
+      c.I32Const(PowerPC::BAT_INDEX_SHIFT);
+      c.I32ShrU();
+      c.I32Const(2);
+      c.I32Shl();
+      c.I32ConstU(m.dbat);
+      c.I32Add();
+      c.I32Load();
+      c.LocalTee(L_E);
+      c.I32Const(PowerPC::BAT_MAPPED_BIT);
+      c.I32And();
+      c.I32Eqz();
+      c.BrIf(depth + 1);  // not BAT-mapped: page tables, take the slow path
+      c.LocalGet(L_E);
+      c.I32ConstU(PowerPC::BAT_RESULT_MASK);
+      c.I32And();
+      c.LocalGet(L_EA);
+      c.I32ConstU(PowerPC::BAT_PAGE_SIZE - 1);
+      c.I32And();
+      c.I32Or();
+      c.LocalSet(L_PHYS);
+      c.LocalGet(L_E);
+      c.I32Const(PowerPC::BAT_WI_BIT);
+      c.I32And();
+      c.LocalSet(L_WI);
+    }
+    // data cache emulation: slow path
+    c.I32ConstU(m.ppc);
+    c.I32Load8U(m.dcache);
+    c.BrIf(depth);
+    if (store)
+    {
+      // Cache-inhibited stores smaller than an aligned word have odd hardware
+      // behaviour (MMU::WriteToHardware): slow path.
+      c.LocalGet(L_WI);
+      if (size < 4)
+      {
+        c.BrIf(depth);
+      }
+      else
+      {
+        c.LocalGet(L_PHYS);
+        c.I32Const(3);
+        c.I32And();
+        c.I32And();
+        c.BrIf(depth);
+      }
+    }
+    // RAM: (phys & 0xF8000000) == 0
+    c.LocalGet(L_PHYS);
+    c.I32ConstU(0xF8000000);
+    c.I32And();
+    if (m.exram)
+    {
+      c.If();
+      {
+        // MEM2: (phys >> 28) == 1 && (phys & 0x0FFFFFFF) < size
+        c.LocalGet(L_PHYS);
+        c.I32Const(28);
+        c.I32ShrU();
+        c.I32Const(1);
+        c.I32Ne();
+        c.BrIf(depth + 1);
+        c.LocalGet(L_PHYS);
+        c.I32ConstU(0x0FFFFFFF);
+        c.I32And();
+        c.LocalTee(L_HOST);
+        c.I32ConstU(m.exram_size);
+        c.I32GeU();
+        c.BrIf(depth + 1);
+        c.LocalGet(L_HOST);
+        c.I32ConstU(m.exram);
+        c.I32Add();
+        c.LocalSet(L_HOST);
+      }
+      c.Else();
+      {
+        c.LocalGet(L_PHYS);
+        c.I32ConstU(m.ram_mask);
+        c.I32And();
+        c.I32ConstU(m.ram);
+        c.I32Add();
+        c.LocalSet(L_HOST);
+      }
+      c.End();
+    }
+    else
+    {
+      c.BrIf(depth);
+      c.LocalGet(L_PHYS);
+      c.I32ConstU(m.ram_mask);
+      c.I32And();
+      c.I32ConstU(m.ram);
+      c.I32Add();
+      c.LocalSet(L_HOST);
+    }
+  }
+
+  // ---- gather pipe ----
+  // Games feed the GPU by storing to 0xCC008000 (the write-gather pipe). Those
+  // stores aren't RAM, so they used to take the Interpreter path through
+  // MMU::WriteToHardware. Instead, when L_EA is in the gather pipe's page,
+  // write big-endian at ppcState.gather_pipe_ptr directly (what
+  // GPFifoManager::FastWrite* does) and let the pipe flush once it holds 32
+  // bytes. Usage: GatherPipeBegin(); <store at L_HOST>; GatherPipeEnd(bytes,
+  // depth of $done from inside the If).
+  void GatherPipeBegin()
+  {
+    c.LocalGet(L_EA);
+    c.I32ConstU(0xFFFFF000);
+    c.I32And();
+    c.I32ConstU(m.dr ? 0xCC008000 : 0x0C008000);
+    c.I32Eq();
+    c.If();
+    c.I32ConstU(m.ppc);
+    c.I32Load(m.gp_ptr);
+    c.LocalSet(L_HOST);
+  }
+  void GatherPipeEnd(u32 bytes, u32 done_depth)
+  {
+    c.LocalGet(L_HOST);
+    c.I32Const(static_cast<s32>(bytes));
+    c.I32Add();
+    c.LocalSet(L_HOST);
+    c.I32ConstU(m.ppc);
+    c.LocalGet(L_HOST);
+    c.I32Store(m.gp_ptr);
+    c.LocalGet(L_HOST);
+    c.I32ConstU(m.ppc);
+    c.I32Load(m.gp_base);
+    c.I32Sub();
+    c.I32ConstU(GPFifo::GATHER_PIPE_SIZE);
+    c.I32GeU();
+    c.If();
+    c.I32ConstU(m.gpfifo);
+    c.I32Const(0);
+    c.I32ConstU(static_cast<u32>(reinterpret_cast<uintptr_t>(&WasmJitGatherCheck)));
+    c.CallIndirect(WasmJit::TYPE_V_II);
+    c.End();
+    c.Br(done_depth);
+    c.End();
+  }
+
+  // Loads `size` bytes big-endian from L_HOST onto the stack.
+  void LoadHost(u32 size, bool sign)
+  {
+    if (size == 1)
+    {
+      c.LocalGet(L_HOST);
+      sign ? c.I32Load8S() : c.I32Load8U();
+    }
+    else if (size == 2)
+    {
+      c.LocalGet(L_HOST);
+      sign ? c.I32Load8S() : c.I32Load8U();
+      c.I32Const(8);
+      c.I32Shl();
+      c.LocalGet(L_HOST);
+      c.I32Load8U(1);
+      c.I32Or();
+    }
+    else
+    {
+      c.LocalGet(L_HOST);
+      c.I32Load();
+      Bswap32();
+    }
+  }
+  // Stores the low `size` bytes of `local` big-endian at L_HOST.
+  void StoreHost(u32 size, u32 local)
+  {
+    if (size == 1)
+    {
+      c.LocalGet(L_HOST);
+      c.LocalGet(local);
+      c.I32Store8();
+    }
+    else if (size == 2)
+    {
+      c.LocalGet(L_HOST);
+      c.LocalGet(local);
+      c.I32Const(8);
+      c.I32ShrU();
+      c.I32Store8();
+      c.LocalGet(L_HOST);
+      c.LocalGet(local);
+      c.I32Store8(1);
+    }
+    else
+    {
+      c.LocalGet(L_HOST);
+      c.LocalGet(local);
+      Bswap32();
+      c.I32Store();
+    }
+  }
+
+  WasmJit::CodeWriter& c;
+  const Machine& m;
+};
+
+}  // namespace
+
+
+// ---- floating point / paired singles ----
+// Matches the Interpreter's results bit for bit: anything that would produce
+// a NaN, plus the rare fused-multiply-add cases that need extra precision,
+// goes to the Interpreter (which also raises the FPSCR exceptions). FPSCR's
+// FPRF/FI/FR are not updated for arithmetic, like Dolphin's JITs (Jit64,
+// JitArm64) without the "FPRF" setting; Rc forms go to the Interpreter.
+enum WasmJitGroup : u32
+{
+  GROUP_FP_LOADSTORE = 1,  // lfs/lfd/stfs/stfd
+  GROUP_PSQ = 2,           // psq_l/psq_st
+  GROUP_FP_SINGLE = 4,     // opcode 59
+  GROUP_FP_DOUBLE = 8,     // opcode 63 arithmetic, frsp, fctiwz
+  GROUP_FP_MOVE = 16,      // fmr/fneg/fabs/fnabs/fsel, ps moves/merges/sel
+  GROUP_FP_COMPARE = 32,   // fcmpu/fcmpo/ps_cmp*
+  GROUP_PS_ARITH = 64,     // ps arithmetic
+  GROUP_INTEGER = 128,     // everything outside EmitInlineFP
+  GROUP_CR = 256,          // CR logic ops, mcrf, mfcr, mtcrf
+};
+static u32 s_disabled_groups = 0;
+static bool Enabled(u32 group)
+{
+  return (s_disabled_groups & group) == 0;
+}
+
+// std::fma as the Interpreter computes it (WebAssembly has no fused multiply-add):
+// called from compiled blocks through the function table.
+static double WasmJitFma(double a, double b, double c)
+{
+  return std::fma(a, b, c);
+}
+
+// Common::ApproximateReciprocal(SquareRoot): table-based, called like WasmJitFma.
+static double WasmJitRecip(double b, double, double)
+{
+  return Common::ApproximateReciprocal(b);
+}
+static double WasmJitRsqrte(double b, double, double)
+{
+  return Common::ApproximateReciprocalSquareRoot(b);
+}
+
+static bool EmitInlineFP(Emitter& e, UGeckoInstruction inst, bool& handled,
+                         const std::function<void()>& fallback)
+{
+  using namespace WasmJit;
+  WasmJit::CodeWriter& c = e.c;
+  handled = true;
+
+  // block { block { body (br_if 0 = slow) ; br 1 } ; fallback } ;
+  auto with_fallback = [&](auto body, bool reads_gprs) {
+    c.Block();
+    c.Block();
+    body();
+    c.Br(1);
+    c.End();
+    if (reads_gprs)
+      e.Flush(true);
+    fallback();
+    c.End();
+    return true;
+  };
+
+  // Raw result of a single-precision op on halves (ha of a, hb of b/c)
+  // into `dst` (f64 local); branches to 0 on cases left to the Interpreter.
+  enum class Op { Add, Sub, Mul, Div, Madd, Msub };
+  auto single_raw = [&](Op op, u32 fa, u32 ha, u32 fb, u32 hb, u32 fc, u32 hc, u32 dst) {
+    switch (op)
+    {
+    case Op::Add:
+    case Op::Sub:
+    case Op::Div:
+      e.PushPS(fa, ha);
+      e.PushPS(fb, hb);
+      op == Op::Add ? c.F64Add() : op == Op::Sub ? c.F64Sub() : c.F64Div();
+      c.LocalSet(dst);
+      break;
+    case Op::Mul:
+      e.PushPS(fc, hc);
+      c.LocalSet(L_F5);
+      e.PushPS(fa, ha);
+      e.Force25Bit(L_F5);
+      c.F64Mul();
+      c.LocalSet(dst);
+      break;
+    case Op::Madd:
+    case Op::Msub:
+      // NI_madd_msub<single>: fma(a, Force25Bit(c), +-b), with a tie fix-up.
+      // a * Force25Bit(c) is exact in a double when a has at most 28
+      // significant bits (always, for single-precision values), and then
+      // a * c + b rounds once, like the fma. Otherwise: Interpreter.
+      e.PushPSBits(fa, ha);
+      c.I64Const(0x1FFFFFF);
+      c.I64And();
+      c.I64Const(0);
+      c.I64Ne();
+      c.BrIf(0);
+      e.PushPS(fc, hc);
+      c.LocalSet(L_F5);
+      e.PushPS(fa, ha);
+      e.Force25Bit(L_F5);
+      c.F64Mul();
+      e.PushPS(fb, hb);
+      op == Op::Madd ? c.F64Add() : c.F64Sub();
+      c.LocalTee(dst);
+      // the tie case the Interpreter corrects: (bits & 0x1fffffff) == 0x10000000
+      c.I64ReinterpretF64();
+      c.I64Const(0x1fffffff);
+      c.I64And();
+      c.I64Const(0x10000000);
+      c.I64Eq();
+      c.BrIf(0);
+      break;
+    }
+    e.BrIfNaN(dst, 0);
+  };
+  // dst = ForceSingle(src), negated for the nmadd/nmsub forms (src isn't NaN)
+  auto to_single = [&](u32 src, u32 dst, bool negate) {
+    e.ForceSingle(src);
+    if (negate)
+      c.F64Neg();
+    c.LocalSet(dst);
+  };
+
+  const u32 fd = inst.FD, fa = inst.FA, fb = inst.FB, fc = inst.FC;
+
+  // ---------------- loads / stores ----------------
+  enum class Mem { LFS, LFD, STFS, STFD, PSQ_L, PSQ_ST, STFIWX };
+  auto fpmem = [&](Mem kind, auto ea, bool update, bool w = false, u32 gqr = 0) {
+    if (!Enabled((kind == Mem::PSQ_L || kind == Mem::PSQ_ST) ? GROUP_PSQ : GROUP_FP_LOADSTORE))
+      return false;
+    const bool store =
+        kind == Mem::STFS || kind == Mem::STFD || kind == Mem::PSQ_ST || kind == Mem::STFIWX;
+    const u32 size = (kind == Mem::LFD || kind == Mem::STFD) ? 8 :
+                     ((kind == Mem::PSQ_L || kind == Mem::PSQ_ST) && !w) ? 8 : 4;
+    c.Block();  // $done
+    c.Block();  // $slow
+    ea();
+    c.LocalSet(L_EA);
+    if (kind == Mem::PSQ_L || kind == Mem::PSQ_ST)
+    {
+      // HID2.LSQE must be set, and the GQR type must be float
+      e.PushSPR(SPR_HID2);
+      c.I32ConstU(0x80000000);
+      c.I32And();
+      c.I32Eqz();
+      c.BrIf(0);
+      e.PushSPR(SPR_GQR0 + gqr);
+      if (kind == Mem::PSQ_L)
+      {
+        c.I32Const(16);
+        c.I32ShrU();
+      }
+      c.I32Const(7);
+      c.I32And();
+      c.BrIf(0);
+    }
+    else
+    {
+      // lfs/lfd/stfs/stfd: misaligned -> alignment exception (Interpreter)
+      c.LocalGet(L_EA);
+      c.I32Const(3);
+      c.I32And();
+      c.BrIf(0);
+    }
+    // store values, before translating (stfs may need the Interpreter)
+    if (kind == Mem::STFS)
+    {
+      e.PushPSBits(fd, 0);
+      c.LocalSet(L_X);
+      e.ConvertToSingle(L_X, false, 0);
+      c.LocalSet(L_V);
+    }
+    else if (kind == Mem::STFD)
+    {
+      e.PushPSBits(fd, 0);
+      c.LocalSet(L_X);
+    }
+    else if (kind == Mem::STFIWX)  // low 32 bits of ps0, as is
+    {
+      e.PushPSBits(fd, 0);
+      c.I32WrapI64();
+      c.LocalSet(L_V);
+    }
+    else if (kind == Mem::PSQ_ST)
+    {
+      e.PushPSBits(fd, 0);
+      c.LocalSet(L_X);
+      e.ConvertToSingle(L_X, true, 0);
+      c.LocalSet(L_V);
+      if (!w)
+      {
+        e.PushPSBits(fd, 1);
+        c.LocalSet(L_X);
+        e.ConvertToSingle(L_X, true, 0);
+        c.LocalSet(L_V2);
+      }
+    }
+    if (store && !update)
+    {
+      e.GatherPipeBegin();
+      u32 bytes = 4;
+      switch (kind)
+      {
+      case Mem::STFD:
+        c.LocalGet(L_HOST);
+        c.LocalGet(L_X);
+        e.Bswap64();
+        c.I64Store();
+        bytes = 8;
+        break;
+      case Mem::PSQ_ST:
+        e.StoreHost(4, L_V);
+        if (!w)
+        {
+          c.LocalGet(L_HOST);
+          c.LocalGet(L_V2);
+          e.Bswap32();
+          c.I32Store(4);
+          bytes = 8;
+        }
+        break;
+      default:  // STFS, STFIWX
+        e.StoreHost(4, L_V);
+        break;
+      }
+      e.GatherPipeEnd(bytes, 2);  // If -> $slow -> $done
+    }
+    e.Translate(size, store, 0);
+    switch (kind)
+    {
+    case Mem::LFS:
+      c.LocalGet(L_HOST);
+      c.I32Load();
+      e.Bswap32();
+      c.LocalSet(L_V);
+      e.ConvertToDouble(L_V);
+      c.LocalSet(L_X);
+      e.StorePSBitsFromLocal(fd, 0, L_X);
+      e.StorePSBitsFromLocal(fd, 1, L_X);
+      break;
+    case Mem::LFD:
+      c.LocalGet(L_HOST);
+      c.I64Load();
+      e.Bswap64();
+      c.LocalSet(L_X);
+      e.StorePSBitsFromLocal(fd, 0, L_X);
+      break;
+    case Mem::PSQ_L:
+      c.LocalGet(L_HOST);
+      c.I32Load();
+      e.Bswap32();
+      c.LocalSet(L_V);
+      e.ConvertToDouble(L_V);
+      c.LocalSet(L_X);
+      if (w)
+      {
+        c.I64Const(0x3FF0000000000000LL);  // 1.0
+      }
+      else
+      {
+        c.LocalGet(L_HOST);
+        c.I32Load(4);
+        e.Bswap32();
+        c.LocalSet(L_V);
+        e.ConvertToDouble(L_V);
+      }
+      c.LocalSet(L_X2);
+      e.StorePSBitsFromLocal(fd, 0, L_X);
+      e.StorePSBitsFromLocal(fd, 1, L_X2);
+      break;
+    case Mem::STFS:
+    case Mem::STFIWX:
+      e.StoreHost(4, L_V);
+      break;
+    case Mem::STFD:
+      c.LocalGet(L_HOST);
+      c.LocalGet(L_X);
+      e.Bswap64();
+      c.I64Store();
+      break;
+    case Mem::PSQ_ST:
+      e.StoreHost(4, L_V);
+      if (!w)
+      {
+        c.LocalGet(L_HOST);
+        c.LocalGet(L_V2);
+        e.Bswap32();
+        c.I32Store(4);
+      }
+      break;
+    }
+    if (update)
+      e.SetGPRFromLocal(inst.RA, L_EA);
+    c.Br(1);
+    c.End();  // $slow
+    e.Flush(true);
+    fallback();
+    if (update)
+      e.Reload(inst.RA);
+    c.End();  // $done
+    if (update)
+    {
+      e.loaded |= 1u << inst.RA;
+      e.dirty |= 1u << inst.RA;
+    }
+    return true;
+  };
+  const u32 ra = inst.RA, rb = inst.RB;
+  auto ea_d = [&] { e.PushRAOrZero(ra); c.I32Const(inst.SIMM_16); c.I32Add(); };
+  auto ea_du = [&] { e.PushGPR(ra); c.I32Const(inst.SIMM_16); c.I32Add(); };
+  auto ea_x = [&] { e.PushRAOrZero(ra); e.PushGPR(rb); c.I32Add(); };
+  auto ea_xu = [&] { e.PushGPR(ra); e.PushGPR(rb); c.I32Add(); };
+  auto ea_q = [&] { e.PushRAOrZero(ra); c.I32Const(inst.SIMM_12); c.I32Add(); };
+  auto ea_qu = [&] { e.PushGPR(ra); c.I32Const(inst.SIMM_12); c.I32Add(); };
+
+  switch (inst.OPCD)
+  {
+  case 48: return fpmem(Mem::LFS, ea_d, false);
+  case 49: return fpmem(Mem::LFS, ea_du, true);
+  case 50: return fpmem(Mem::LFD, ea_d, false);
+  case 51: return fpmem(Mem::LFD, ea_du, true);
+  case 52: return fpmem(Mem::STFS, ea_d, false);
+  case 53: return fpmem(Mem::STFS, ea_du, true);
+  case 54: return fpmem(Mem::STFD, ea_d, false);
+  case 55: return fpmem(Mem::STFD, ea_du, true);
+  case 56: return fpmem(Mem::PSQ_L, ea_q, false, inst.W, inst.I);
+  case 57: return fpmem(Mem::PSQ_L, ea_qu, true, inst.W, inst.I);
+  case 60: return fpmem(Mem::PSQ_ST, ea_q, false, inst.W, inst.I);
+  case 61: return fpmem(Mem::PSQ_ST, ea_qu, true, inst.W, inst.I);
+  case 4:
+    switch (inst.SUBOP6)
+    {
+    case 6: return fpmem(Mem::PSQ_L, ea_x, false, inst.Wx, inst.Ix);    // psq_lx
+    case 7: return fpmem(Mem::PSQ_ST, ea_x, false, inst.Wx, inst.Ix);   // psq_stx
+    case 38: return fpmem(Mem::PSQ_L, ea_xu, true, inst.Wx, inst.Ix);   // psq_lux
+    case 39: return fpmem(Mem::PSQ_ST, ea_xu, true, inst.Wx, inst.Ix);  // psq_stux
+    default: break;
+    }
+    break;
+  case 31:
+    switch (inst.SUBOP10)
+    {
+    case 535: return fpmem(Mem::LFS, ea_x, false);
+    case 567: return fpmem(Mem::LFS, ea_xu, true);
+    case 599: return fpmem(Mem::LFD, ea_x, false);
+    case 631: return fpmem(Mem::LFD, ea_xu, true);
+    case 663: return fpmem(Mem::STFS, ea_x, false);
+    case 695: return fpmem(Mem::STFS, ea_xu, true);
+    case 727: return fpmem(Mem::STFD, ea_x, false);
+    case 759: return fpmem(Mem::STFD, ea_xu, true);
+    case 983: return fpmem(Mem::STFIWX, ea_x, false);
+    default: handled = false; return false;
+    }
+  case 59:
+  case 63:
+    break;
+  default:
+    handled = false;
+    return false;
+  }
+
+  if (inst.Rc)  // CR1 updates: Interpreter
+    return false;
+
+  // ---------------- compare helper ----------------
+  // CR field + FPSCR.FPCC from halves of a and b; NaNs -> Interpreter.
+  auto fcompare = [&](u32 ha, u32 hb) {
+    if (!Enabled(GROUP_FP_COMPARE))
+      return false;
+    return with_fallback(
+        [&] {
+          e.PushPS(fa, ha);
+          c.LocalSet(L_F0);
+          e.PushPS(fb, hb);
+          c.LocalSet(L_F1);
+          e.BrIfNaN(L_F0, 0);
+          e.BrIfNaN(L_F1, 0);
+          // code = LT*8 | GT*4 | EQ*2 (FPCC FL/FG/FE)
+          c.LocalGet(L_F0);
+          c.LocalGet(L_F1);
+          c.F64Lt();
+          c.I32Const(3);
+          c.I32Shl();
+          c.LocalGet(L_F0);
+          c.LocalGet(L_F1);
+          c.F64Gt();
+          c.I32Const(2);
+          c.I32Shl();
+          c.I32Or();
+          c.LocalGet(L_F0);
+          c.LocalGet(L_F1);
+          c.F64Eq();
+          c.I32Const(1);
+          c.I32Shl();
+          c.I32Or();
+          c.LocalSet(L_V);
+          // fpscr.FPRF = (FPRF & ~0xF) | code   (FPRF is bits 12..16)
+          c.I32ConstU(e.m.ppc);
+          c.I32ConstU(e.m.ppc);
+          c.I32Load(e.m.fpscr);
+          c.I32ConstU(~(0xFu << 12));
+          c.I32And();
+          c.LocalGet(L_V);
+          c.I32Const(12);
+          c.I32Shl();
+          c.I32Or();
+          c.I32Store(e.m.fpscr);
+          // cr.fields[crfd] = s_crTable[code]
+          c.I32ConstU(e.m.ppc);
+          c.LocalGet(L_V);
+          c.I32Const(3);
+          c.I32Shl();
+          c.I32ConstU(e.m.cr_table);
+          c.I32Add();
+          c.I64Load();
+          c.I64Store(e.m.cr + 8 * inst.CRFD);
+        },
+        false);
+  };
+  // bit ops on ps0 (and ps1): dst = f(src)
+  auto bits_op = [&](bool both, auto f) {
+    if (!Enabled(GROUP_FP_MOVE))
+      return false;
+    for (u32 h = 0; h < (both ? 2u : 1u); h++)
+    {
+      e.PushPSBits(fb, h);
+      f();
+      c.LocalSet(h ? L_X2 : L_X);
+    }
+    for (u32 h = 0; h < (both ? 2u : 1u); h++)
+      e.StorePSBitsFromLocal(fd, h, h ? L_X2 : L_X);
+    return true;
+  };
+  constexpr s64 SIGN = static_cast<s64>(0x8000000000000000ULL);
+
+  // fres/frsqrte/ps_res/ps_rsqrte: Common::ApproximateReciprocal(SquareRoot) through
+  // the function table. Inputs that raise exceptions or clear FI/FR in the Interpreter
+  // (zero, NaN, infinity, and negative for rsqrte) go to the Interpreter.
+  auto estimate = [&](bool rsqrt, u32 halves, bool fill, bool force_single) {
+    return with_fallback(
+        [&] {
+          for (u32 h = 0; h < halves; h++)
+          {
+            const u32 in = h ? L_F1 : L_F0;
+            e.PushPS(fb, h);
+            c.LocalSet(in);
+            // rsqrt: 0 < b < inf; reciprocal: 0 < |b| < inf (false for NaN)
+            c.LocalGet(in);
+            if (!rsqrt)
+              c.F64Abs();
+            c.F64Const(0.0);
+            c.F64Gt();
+            c.LocalGet(in);
+            c.F64Abs();
+            c.F64Const(std::numeric_limits<double>::infinity());
+            c.F64Lt();
+            c.I32And();
+            c.I32Eqz();
+            c.BrIf(0);
+          }
+          for (u32 h = 0; h < halves; h++)
+          {
+            const u32 in = h ? L_F1 : L_F0;
+            const u32 out = h ? L_F3 : L_F2;
+            c.LocalGet(in);
+            c.F64Const(0.0);
+            c.F64Const(0.0);
+            c.I32ConstU(static_cast<u32>(
+                reinterpret_cast<uintptr_t>(rsqrt ? &WasmJitRsqrte : &WasmJitRecip)));
+            c.CallIndirect(WasmJit::TYPE_F_FFF);
+            c.LocalSet(out);
+            if (force_single)
+            {
+              e.ForceSingle(out);
+              c.LocalSet(out);
+            }
+          }
+          e.StorePSFromLocal(fd, 0, L_F2);
+          if (halves == 2)
+            e.StorePSFromLocal(fd, 1, L_F3);
+          else if (fill)
+            e.StorePSFromLocal(fd, 1, L_F2);
+        },
+        false);
+  };
+
+  if (inst.OPCD == 59)
+  {
+    if (!Enabled(GROUP_FP_SINGLE))
+      return false;
+    Op op;
+    bool neg = false;
+    switch (inst.SUBOP5)
+    {
+    case 18: op = Op::Div; break;
+    case 20: op = Op::Sub; break;
+    case 21: op = Op::Add; break;
+    case 25: op = Op::Mul; break;
+    case 28: op = Op::Msub; break;
+    case 29: op = Op::Madd; break;
+    case 30: op = Op::Msub; neg = true; break;
+    case 31: op = Op::Madd; neg = true; break;
+    case 24: return estimate(false, 1, true, false);  // fres: ps0 = ps1 = 1/b
+    default: return false;
+    }
+    return with_fallback(
+        [&] {
+          single_raw(op, fa, 0, fb, 0, fc, 0, L_F0);
+          to_single(L_F0, L_F2, neg);
+          e.StorePSFromLocal(fd, 0, L_F2);
+          e.StorePSFromLocal(fd, 1, L_F2);
+        },
+        false);
+  }
+
+  if (inst.OPCD == 63)
+  {
+    if (inst.SUBOP5 == 23 && !Enabled(GROUP_FP_MOVE))
+      return false;
+    if (inst.SUBOP5 != 23 && !Enabled(GROUP_FP_DOUBLE) &&
+        !(inst.SUBOP10 == 0 || inst.SUBOP10 == 32 || inst.SUBOP10 == 40 || inst.SUBOP10 == 72 ||
+          inst.SUBOP10 == 136 || inst.SUBOP10 == 264))
+      return false;
+    switch (inst.SUBOP5)
+    {
+    case 18:  // fdiv
+    case 20:  // fsub
+    case 21:  // fadd
+    case 25:  // fmul
+      return with_fallback(
+          [&] {
+            e.PushPS(fa, 0);
+            e.PushPS(inst.SUBOP5 == 25 ? fc : fb, 0);
+            switch (inst.SUBOP5)
+            {
+            case 18: c.F64Div(); break;
+            case 20: c.F64Sub(); break;
+            case 21: c.F64Add(); break;
+            default: c.F64Mul(); break;
+            }
+            c.LocalSet(L_F0);
+            e.BrIfNaN(L_F0, 0);
+            e.ForceDouble(L_F0);
+            c.LocalSet(L_F2);
+            e.StorePSFromLocal(fd, 0, L_F2);
+          },
+          false);
+    case 28:  // fmsub
+    case 29:  // fmadd
+    case 30:  // fnmsub
+    case 31:  // fnmadd
+    {
+      // NI_madd_msub<double>: fma(a, c, +-b); NaN results -> Interpreter.
+      const bool sub = inst.SUBOP5 == 28 || inst.SUBOP5 == 30;
+      const bool neg = inst.SUBOP5 >= 30;
+      return with_fallback(
+          [&] {
+            e.PushPS(fa, 0);
+            e.PushPS(fc, 0);
+            e.PushPS(fb, 0);
+            if (sub)
+              c.F64Neg();
+            c.I32ConstU(static_cast<u32>(reinterpret_cast<uintptr_t>(&WasmJitFma)));
+            c.CallIndirect(WasmJit::TYPE_F_FFF);
+            c.LocalSet(L_F0);
+            e.BrIfNaN(L_F0, 0);
+            e.ForceDouble(L_F0);
+            if (neg)
+              c.F64Neg();
+            c.LocalSet(L_F2);
+            e.StorePSFromLocal(fd, 0, L_F2);
+          },
+          false);
+    }
+    case 26:  // frsqrte: ps0 only
+      return estimate(true, 1, false, false);
+    case 23:  // fsel: ps0 = a >= -0.0 ? c : b
+      e.PushPSBits(fc, 0);
+      e.PushPSBits(fb, 0);
+      e.PushPS(fa, 0);
+      c.F64Const(-0.0);
+      c.F64Ge();
+      c.Select();
+      c.LocalSet(L_X);
+      e.StorePSBitsFromLocal(fd, 0, L_X);
+      return true;
+    default:
+      break;
+    }
+    switch (inst.SUBOP10)
+    {
+    case 0:   // fcmpu
+    case 32:  // fcmpo
+      return fcompare(0, 0);
+    case 12:  // frsp
+      return with_fallback(
+          [&] {
+            e.PushPS(fb, 0);
+            c.LocalSet(L_F0);
+            e.BrIfNaN(L_F0, 0);
+            to_single(L_F0, L_F2, false);
+            e.StorePSFromLocal(fd, 0, L_F2);
+            e.StorePSFromLocal(fd, 1, L_F2);
+          },
+          false);
+    case 15:  // fctiwz
+      return with_fallback(
+          [&] {
+            // in range (and not NaN): -2^31 <= b < 2^31, else Interpreter
+            e.PushPS(fb, 0);
+            c.LocalTee(L_F0);
+            c.F64Const(-2147483648.0);
+            c.F64Ge();
+            c.LocalGet(L_F0);
+            c.F64Const(2147483648.0);
+            c.F64Lt();
+            c.I32And();
+            c.I32Eqz();
+            c.BrIf(0);
+            // ps0 = 0xfff8000000000000 | u32(trunc(b)), | 0x100000000 for -0 results
+            c.LocalGet(L_F0);
+            c.I32TruncF64S();
+            c.LocalTee(L_V);
+            c.I64ExtendI32U();
+            c.I64Const(static_cast<s64>(0xfff8000000000000ULL));
+            c.I64Or();
+            c.I64Const(0x100000000LL);
+            c.I64Const(0);
+            c.LocalGet(L_V);
+            c.I32Eqz();
+            c.LocalGet(L_F0);
+            c.I64ReinterpretF64();
+            c.I64Const(0);
+            c.I64LtS();
+            c.I32And();
+            c.Select();
+            c.I64Or();
+            c.LocalSet(L_X);
+            e.StorePSBitsFromLocal(fd, 0, L_X);
+          },
+          false);
+    case 40:   // fneg
+      return bits_op(false, [&] { c.I64Const(SIGN); c.I64Xor(); });
+    case 72:   // fmr
+      return bits_op(false, [] {});
+    case 136:  // fnabs
+      return bits_op(false, [&] { c.I64Const(SIGN); c.I64Or(); });
+    case 264:  // fabs
+      return bits_op(false, [&] { c.I64Const(~SIGN); c.I64And(); });
+    default:
+      return false;
+    }
+  }
+
+  // ---------------- opcode 4: paired singles ----------------
+  switch (inst.SUBOP10)
+  {
+  case 0:   return fcompare(0, 0);  // ps_cmpu0
+  case 32:  return fcompare(0, 0);  // ps_cmpo0
+  case 64:  return fcompare(1, 1);  // ps_cmpu1
+  case 96:  return fcompare(1, 1);  // ps_cmpo1
+  case 40:  return bits_op(true, [&] { c.I64Const(SIGN); c.I64Xor(); });   // ps_neg
+  case 72:  return bits_op(true, [] {});                                    // ps_mr
+  case 136: return bits_op(true, [&] { c.I64Const(SIGN); c.I64Or(); });    // ps_nabs
+  case 264: return bits_op(true, [&] { c.I64Const(~SIGN); c.I64And(); });  // ps_abs
+  case 528:  // ps_merge00
+  case 560:  // ps_merge01
+  case 592:  // ps_merge10
+  case 624:  // ps_merge11
+  {
+    if (!Enabled(GROUP_FP_MOVE))
+      return false;
+    const u32 h0 = (inst.SUBOP10 == 592 || inst.SUBOP10 == 624) ? 1 : 0;  // from a
+    const u32 h1 = (inst.SUBOP10 == 560 || inst.SUBOP10 == 624) ? 1 : 0;  // from b
+    e.PushPSBits(fa, h0);
+    c.LocalSet(L_X);
+    e.PushPSBits(fb, h1);
+    c.LocalSet(L_X2);
+    e.StorePSBitsFromLocal(fd, 0, L_X);
+    e.StorePSBitsFromLocal(fd, 1, L_X2);
+    return true;
+  }
+  default:
+    break;
+  }
+
+  auto paired = [&](Op op, bool neg, u32 c_half0, u32 c_half1) {
+    if (!Enabled(GROUP_PS_ARITH))
+      return false;
+    return with_fallback(
+        [&] {
+          single_raw(op, fa, 0, fb, 0, fc, c_half0, L_F0);
+          single_raw(op, fa, 1, fb, 1, fc, c_half1, L_F1);
+          to_single(L_F0, L_F2, neg);
+          to_single(L_F1, L_F3, neg);
+          e.StorePSFromLocal(fd, 0, L_F2);
+          e.StorePSFromLocal(fd, 1, L_F3);
+        },
+        false);
+  };
+  switch (inst.SUBOP5)
+  {
+  case 24:  // ps_res
+    if (!Enabled(GROUP_PS_ARITH))
+      return false;
+    return estimate(false, 2, false, false);
+  case 26:  // ps_rsqrte: ForceSingle of each estimate
+    if (!Enabled(GROUP_PS_ARITH))
+      return false;
+    return estimate(true, 2, false, true);
+  case 10:  // ps_sum0: ps0 = a0 + b1, ps1 = c1
+  case 11:  // ps_sum1: ps0 = c0, ps1 = a0 + b1
+  {
+    if (!Enabled(GROUP_PS_ARITH))
+      return false;
+    const bool sum0 = inst.SUBOP5 == 10;
+    return with_fallback(
+        [&] {
+          single_raw(Op::Add, fa, 0, fb, 1, 0, 0, L_F0);
+          e.PushPS(fc, sum0 ? 1 : 0);
+          c.LocalSet(L_F1);
+          e.BrIfNaN(L_F1, 0);
+          to_single(L_F0, L_F2, false);
+          to_single(L_F1, L_F3, false);
+          e.StorePSFromLocal(fd, sum0 ? 0 : 1, L_F2);
+          e.StorePSFromLocal(fd, sum0 ? 1 : 0, L_F3);
+        },
+        false);
+  }
+  case 12: return paired(Op::Mul, false, 0, 0);   // ps_muls0
+  case 13: return paired(Op::Mul, false, 1, 1);   // ps_muls1
+  case 14: return paired(Op::Madd, false, 0, 0);  // ps_madds0
+  case 15: return paired(Op::Madd, false, 1, 1);  // ps_madds1
+  case 18: return paired(Op::Div, false, 0, 1);   // ps_div
+  case 20: return paired(Op::Sub, false, 0, 1);   // ps_sub
+  case 21: return paired(Op::Add, false, 0, 1);   // ps_add
+  case 23:  // ps_sel
+    if (!Enabled(GROUP_FP_MOVE))
+      return false;
+    for (u32 h = 0; h < 2; h++)
+    {
+      e.PushPSBits(fc, h);
+      e.PushPSBits(fb, h);
+      e.PushPS(fa, h);
+      c.F64Const(-0.0);
+      c.F64Ge();
+      c.Select();
+      c.LocalSet(h ? L_X2 : L_X);
+    }
+    e.StorePSBitsFromLocal(fd, 0, L_X);
+    e.StorePSBitsFromLocal(fd, 1, L_X2);
+    return true;
+  case 25: return paired(Op::Mul, false, 0, 1);   // ps_mul
+  case 28: return paired(Op::Msub, false, 0, 1);  // ps_msub
+  case 29: return paired(Op::Madd, false, 0, 1);  // ps_madd
+  case 30: return paired(Op::Msub, true, 0, 1);   // ps_nmsub
+  case 31: return paired(Op::Madd, true, 0, 1);   // ps_nmadd
+  default:
+    return false;  // ps_res, ps_rsqrte, quantized indexed loads, dcbz_l, ...
+  }
+}
+
+// Emits inline WebAssembly for one instruction, with `fallback` (a call to
+// the Interpreter's version of it) for the cases the inline code doesn't
+// handle. Returns false if the instruction isn't handled inline at all.
+static bool EmitInline(Emitter& e, UGeckoInstruction inst, u32 pc, bool branch_watch,
+                       const std::function<void()>& fallback)
+{
+  WasmJit::CodeWriter& c = e.c;
+  const u32 rd = inst.RD, ra = inst.RA, rb = inst.RB;
+
+  // ---- branches (Interpreter_Branch.cpp). The block's Interpret<true> has
+  // already set pc and npc = pc + 4. Left to the Interpreter while the
+  // debugger's branch watch is recording. ----
+  auto taken_to = [&](auto push_target, bool lk) {
+    push_target();
+    c.LocalSet(Local::L_V);
+    if (lk)
+      e.SetSPR(SPR_LR, [&] { c.I32ConstU(pc + 4); });
+    e.SetNPC(Local::L_V);
+  };
+  // Pushes the BO/BI condition (counter && condition) for bc/bclr, updating
+  // CTR first unless BO says not to.
+  auto push_bo_condition = [&](u32 bo, u32 bi, bool ctr_allowed) {
+    bool have = false;
+    if (ctr_allowed && (bo & BO_DONT_DECREMENT_FLAG) == 0)
+    {
+      e.SetSPR(SPR_CTR, [&] {
+        e.PushSPR(SPR_CTR);
+        c.I32Const(1);
+        c.I32Sub();
+      });
+      // counter: (CTR != 0) ^ BO[1]
+      e.PushSPR(SPR_CTR);
+      c.I32Const(0);
+      ((bo >> 1) & 1) ? c.I32Eq() : c.I32Ne();
+      have = true;
+    }
+    else if (ctr_allowed && ((bo >> 2) & 1) == 0)
+    {
+      // BO says check CTR but not decrement: (CTR != 0) ^ BO[1]
+      e.PushSPR(SPR_CTR);
+      c.I32Const(0);
+      ((bo >> 1) & 1) ? c.I32Eq() : c.I32Ne();
+      have = true;
+    }
+    if (((bo >> 4) & 1) == 0)  // condition check
+    {
+      e.PushCRBit(bi);
+      if (((bo >> 3) & 1) == 0)
+        c.I32Eqz();
+      if (have)
+        c.I32And();
+      have = true;
+    }
+    if (!have)
+      c.I32Const(1);  // branch always
+  };
+
+  if (!branch_watch)
+  {
+    if (inst.OPCD == 18)  // bx
+    {
+      const u32 dest = u32(SignExt26(inst.LI << 2)) + (inst.AA ? 0 : pc);
+      taken_to([&] { c.I32ConstU(dest); }, inst.LK);
+      return true;
+    }
+    if (inst.OPCD == 16)  // bcx
+    {
+      const u32 dest = u32(SignExt16(s16(inst.BD << 2))) + (inst.AA ? 0 : pc);
+      push_bo_condition(inst.BO, inst.BI, true);
+      c.If();
+      taken_to([&] { c.I32ConstU(dest); }, inst.LK);
+      c.End();
+      return true;
+    }
+    if (inst.OPCD == 19 && (inst.SUBOP10 == 16 || inst.SUBOP10 == 528))  // bclrx, bcctrx
+    {
+      const bool lr = inst.SUBOP10 == 16;
+      if (!lr && (inst.BO_2 & BO_DONT_DECREMENT_FLAG) == 0)
+        return false;  // invalid form
+      // Read LR / CTR before LK overwrites LR.
+      push_bo_condition(inst.BO_2, inst.BI_2, lr);
+      c.If();
+      taken_to(
+          [&] {
+            e.PushSPR(lr ? SPR_LR : SPR_CTR);
+            c.I32Const(~3);
+            c.I32And();
+          },
+          inst.LK_3);
+      c.End();
+      return true;
+    }
+  }
+
+  // ---- CR logic (Interpreter_SystemRegisters.cpp) ----
+  if (inst.OPCD == 19 && Enabled(GROUP_CR))
+  {
+    const u32 xo = inst.SUBOP10;
+    if (xo == 0)  // mcrf
+    {
+      e.PushCRField(inst.CRFS);
+      e.StoreCRField(inst.CRFD);
+      return true;
+    }
+    if (xo == 150)  // isync: nothing to do
+      return true;
+    if (xo == 33 || xo == 129 || xo == 193 || xo == 225 || xo == 257 || xo == 289 || xo == 417 ||
+        xo == 449)
+    {
+      const u32 bd = inst.CRBD;
+      const u32 shift = 3 - (bd & 3);
+      // field with bit bd cleared | (a OP b) << shift
+      e.PushCRField(bd >> 2);
+      c.I32Const(~(1 << shift) & 0xF);
+      c.I32And();
+      e.PushCRBit(inst.CRBA);
+      e.PushCRBit(inst.CRBB);
+      switch (xo)
+      {
