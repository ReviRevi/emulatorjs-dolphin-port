+std::optional<std::string> PreprocessShader(EShLanguage stage, std::string_view source)
+{
+  if (!InitializeGlslang())
+    return std::nullopt;
+  glslang::TShader shader(stage);
+  glslang::TShader::ForbidIncluder forbid_includer;
+  const char* src = source.data();
+  int len = static_cast<int>(source.size());
+  shader.setStringsWithLengths(&src, &len, 1);
+  shader.setEnvTarget(glslang::EShTargetSpv, glslang::EShTargetSpv_1_0);
+  std::string out;
+  const EShMessages messages =
+      static_cast<EShMessages>(EShMsgDefault | EShMsgSpvRules | EShMsgVulkanRules);
+  if (!shader.preprocess(GetCompilerResourceLimits(), 450, ECoreProfile, false, true, messages,
+                         &out, forbid_includer))
+  {
+    ERROR_LOG_FMT(VIDEO, "Shader preprocessing failed: {}", shader.getInfoLog());
+    return std::nullopt;
+  }
+  return out;
+}
 }  // namespace SPIRV
