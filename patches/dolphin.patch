+// clang-format off
+EM_JS(int, dolphin_wasm_jit_install, (const unsigned char* ptr, int len, unsigned addr), {
+  try {
+    // Pointers past 2 GB arrive as negative numbers: make them unsigned.
+    ptr >>>= 0;
+    var mod = new WebAssembly.Module(HEAPU8.slice(ptr, ptr + len));
+    var inst = new WebAssembly.Instance(mod, { e: { t: wasmTable, m: wasmMemory } });
+    var free = Module["__wasmJitFree"] || (Module["__wasmJitFree"] = []);
+    var idx = free.length ? free.pop() : wasmTable.grow(1);
+    wasmTable.set(idx, inst.exports["f"]);
+    (Module["__wasmJitOwn"] || (Module["__wasmJitOwn"] = {}))[idx] = 1;
+    Module["wasmJitBlocks"] = (Module["wasmJitBlocks"] || 0) + 1;
+    return idx;
+  } catch (e) {
+    // Counted and printed with console.error directly: EmulatorJS may not
+    // forward Emscripten's err() to the console.
+    Module["wasmJitFailed"] = (Module["wasmJitFailed"] || 0) + 1;
+    var list = Module["wasmJitFailures"] || (Module["wasmJitFailures"] = []);
+    var a = (addr >>> 0).toString(16);
+    if (list.length < 20) list.push(a + ": " + e);
+    if (list.length <= 5) console.error("Dolphin WebAssembly JIT: block " + a + ": " + e);
+    return 0;
+  }
+});
+
+// JIT mode, from the page: globalThis.DOLPHIN_WASM_JIT = 0 (off: plain Cached
+// Interpreter), 1 (compile blocks, but only as calls into the Interpreter) or
+// 2 (default: inline code). Read when a block is compiled.
+EM_JS(void, dolphin_print_text, (const char* text), { console.log(UTF8ToString(text >>> 0)); });
+EM_JS(int, dolphin_wasm_jit_mode, (), {
+  var m = globalThis["DOLPHIN_WASM_JIT"];
+  return typeof m === "number" ? m : 2;
+});
+
+// Whether the browser supports WebAssembly tail calls (return_call_indirect):
+// then a block jumps straight into the next block instead of returning it to
+// the C++ loop. Checked once with a tiny module.
+EM_JS(int, dolphin_wasm_jit_tailcalls, (), {
+  if (Module["__wasmJitTail"] === undefined) {
+    // (module (table 1 funcref) (type (func)) (func (return_call_indirect (type 0) (i32.const 0))))
+    var bytes = new Uint8Array([0,97,115,109,1,0,0,0, 1,4,1,96,0,0, 3,2,1,0, 4,4,1,112,0,1,
+                                10,9,1,7,0,65,0,19,0,0,11]);
+    var ok = false;
+    try { ok = WebAssembly.validate(bytes); } catch (e) {}
+    Module["__wasmJitTail"] = ok ? 1 : 0;
+  }
+  return Module["__wasmJitTail"];
+});
+
+// Debugging aid: globalThis.DOLPHIN_WASM_JIT_DISABLE is a bitmask of
+// instruction groups to leave to the Interpreter (see WasmJitGroup).
+EM_JS(int, dolphin_wasm_jit_disabled_groups, (), {
+  var m = globalThis["DOLPHIN_WASM_JIT_DISABLE"];
+  return typeof m === "number" ? m : 0;
+});
+
+// Statistics for tuning: which instructions fell back to the Interpreter.
+EM_JS(void, dolphin_wasm_jit_note_fallback, (const char* name), {
+  var s = Module["wasmJitFallbacks"] || (Module["wasmJitFallbacks"] = {});
+  var n = UTF8ToString(name >>> 0);
+  s[n] = (s[n] || 0) + 1;
+});
+
+// Every thread has its own function table. In dual core, blocks are compiled
+// and installed on the CPU thread (a worker), but may be destroyed from another
+// thread: only free slots this thread installed (other threads' indices could
+// name unrelated functions here). A slot installed elsewhere just stays
+// allocated there; the block's entry no longer points at it.
+EM_JS(void, dolphin_wasm_jit_free, (int idx), {
+  var own = Module["__wasmJitOwn"];
+  if (!own || !own[idx]) return;
+  delete own[idx];
+  wasmTable.set(idx, null);
+  (Module["__wasmJitFree"] || (Module["__wasmJitFree"] = [])).push(idx);
+});
+// clang-format on
