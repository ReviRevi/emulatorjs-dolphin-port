diff --git a/Source/Core/Core/PowerPC/CachedInterpreter/CachedInterpreterWasm.cpp b/Source/Core/Core/PowerPC/CachedInterpreter/CachedInterpreterWasm.cpp
new file mode 100644
index 0000000..667ddb6
--- /dev/null
+++ b/Source/Core/Core/PowerPC/CachedInterpreter/CachedInterpreterWasm.cpp
@@ -0,0 +1,2446 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// WebAssembly JIT tier for the Cached Interpreter (Emscripten builds only).
+//
+// WebAssembly can't run machine code it writes into memory, but it can compile
+// a new module at run time and call it through the function table. Once a
+// block has run WASM_JIT_THRESHOLD times, its callback list is translated into
+// a WebAssembly function that does the same work without the dispatch loop:
+//
+//   Interpret<..>            -> direct call of the Interpreter instruction
+//                               (or inline WebAssembly, see EmitInline)
+//   every other callback     -> call it with its operands; return if it
+//                               returns 0 (block exit)
+//
+// The function is compiled with `new WebAssembly.Module`, instantiated with
+// the main module's table and memory, and put in the table; its index goes in
+// the block's WasmEntry operands, which ExecuteOneBlock checks first.
+//
+// The table is per thread, so compiled blocks may only run on the thread that
+// compiled them. On the web the CPU always runs on the browser's main thread
+// (single-core mode, see DolphinLibretro/Boot.cpp), so this holds.
+
+#ifdef __EMSCRIPTEN__
+
+#include "Core/PowerPC/CachedInterpreter/CachedInterpreter.h"
+
+#include <cstddef>
+#include <functional>
+#include <ostream>
+#include <vector>
+
+#include <emscripten.h>
+#include <fmt/ostream.h>
+
+#include "Common/Logging/Log.h"
+#include "Core/HW/Memmap.h"
+#include "Core/PowerPC/ConditionRegister.h"
+#include "Core/PowerPC/Gekko.h"
+#include "Core/PowerPC/MMU.h"
+#include "Core/System.h"
+#include "Core/Debugger/BranchWatch.h"
+#include "Core/PowerPC/CachedInterpreter/WasmEmitter.h"
+#include "Core/PowerPC/Interpreter/Interpreter.h"
+#include "Core/PowerPC/PPCTables.h"
+#include "Core/PowerPC/PowerPC.h"
+
+// clang-format off
+EM_JS(int, dolphin_wasm_jit_install, (const unsigned char* ptr, int len), {
+  try {
+    var mod = new WebAssembly.Module(HEAPU8.slice(ptr, ptr + len));
+    var inst = new WebAssembly.Instance(mod, { e: { t: wasmTable, m: wasmMemory } });
+    var free = Module["__wasmJitFree"] || (Module["__wasmJitFree"] = []);
+    var idx = free.length ? free.pop() : wasmTable.grow(1);
+    wasmTable.set(idx, inst.exports["f"]);
+    Module["wasmJitBlocks"] = (Module["wasmJitBlocks"] || 0) + 1;
+    return idx;
+  } catch (e) {
+    err("Dolphin WebAssembly JIT: " + e);
+    return 0;
+  }
+});
+
+// JIT mode, from the page: globalThis.DOLPHIN_WASM_JIT = 0 (off: plain Cached
+// Interpreter), 1 (compile blocks, but only as calls into the Interpreter) or
+// 2 (default: inline code). Read when a block is compiled.
+EM_JS(int, dolphin_wasm_jit_mode, (), {
+  var m = globalThis["DOLPHIN_WASM_JIT"];
+  return typeof m === "number" ? m : 2;
+});
+
+// Whether the browser supports WebAssembly tail calls (return_call_indirect):
+// then a block jumps straight into the next block instead of returning it to
+// the C++ loop. Checked once with a tiny module.
+EM_JS(int, dolphin_wasm_jit_tailcalls, (), {
+  if (Module["__wasmJitTail"] === undefined) {
+    // (module (table 1 funcref) (type (func)) (func (return_call_indirect (type 0) (i32.const 0))))
+    var bytes = new Uint8Array([0,97,115,109,1,0,0,0, 1,4,1,96,0,0, 3,2,1,0, 4,4,1,112,0,1,
+                                10,9,1,7,0,65,0,19,0,0,11]);
+    var ok = false;
+    try { ok = WebAssembly.validate(bytes); } catch (e) {}
+    Module["__wasmJitTail"] = ok ? 1 : 0;
+  }
+  return Module["__wasmJitTail"];
+});
+
+// Debugging aid: globalThis.DOLPHIN_WASM_JIT_DISABLE is a bitmask of
+// instruction groups to leave to the Interpreter (see WasmJitGroup).
+EM_JS(int, dolphin_wasm_jit_disabled_groups, (), {
+  var m = globalThis["DOLPHIN_WASM_JIT_DISABLE"];
+  return typeof m === "number" ? m : 0;
+});
+
+// Statistics for tuning: which instructions fell back to the Interpreter.
+EM_JS(void, dolphin_wasm_jit_note_fallback, (const char* name), {
+  var s = Module["wasmJitFallbacks"] || (Module["wasmJitFallbacks"] = {});
+  var n = UTF8ToString(name);
+  s[n] = (s[n] || 0) + 1;
+});
+
+EM_JS(void, dolphin_wasm_jit_free, (int idx), {
+  wasmTable.set(idx, null);
+  (Module["__wasmJitFree"] || (Module["__wasmJitFree"] = [])).push(idx);
+});
+// clang-format on
+
+
+namespace
+{
+constexpr u32 WASM_JIT_NEVER = 0xffffffff;  // compile failed: stay interpreted
+
+// Locals of a compiled block function.
+enum Local : u32
+{
+  L_EA = 0,    // effective address
+  L_E = 1,     // BAT table entry
+  L_PHYS = 2,  // physical address
+  L_WI = 3,    // write-through / cache-inhibited bit from the BAT
+  L_HOST = 4,  // host address of the access
+  L_T = 5,     // scratch
+  L_V = 6,     // result value
+  L_V2 = 7,    // second value (psq_st's ps1); never touched by Translate
+  L_GPR0 = 8,  // r0..r31 cached in locals (Emitter::PushGPR / SetGPR)
+  L_I32_COUNT = 8 + 32,
+  L_X = L_I32_COUNT,  // i64 scratch
+  L_X2,               // i64 scratch
+  L_I64_END,
+  L_F0 = L_I64_END,   // f64 scratch
+  L_F1,
+  L_F2,
+  L_F3,
+  L_F4,
+  L_F5,
+  L_F64_END,
+};
+constexpr u32 L_I64_COUNT = L_I64_END - L_X;
+constexpr u32 L_F64_COUNT = L_F64_END - L_F0;
+
+// Everything the inline code needs to know about the emulated machine. The
+// addresses are fixed for the lifetime of the emulation (and blocks are
+// thrown away with the JIT cache when they change).
+struct Machine
+{
+  u32 ppc;          // &PowerPCState
+  u32 gpr;          // offsetof(gpr)
+  u32 cr;           // offsetof(cr.fields)
+  u32 msr;          // offsetof(msr)
+  u32 xer_ca;       // offsetof(xer_ca)
+  u32 xer_so_ov;    // offsetof(xer_so_ov)
+  u32 xer_stringctrl;  // offsetof(xer_stringctrl)
+  u32 dcache;       // offsetof(m_enable_dcache)
+  u32 cr_table;     // &ConditionRegister::s_crTable
+  u32 dbat;         // &MMU::m_dbat_table
+  u32 ram;          // Memory::GetRAM()
+  u32 ram_mask;
+  u32 exram;        // Memory::GetEXRAM() (0 on GameCube)
+  u32 exram_size;
+  u32 pc;           // offsetof(pc)
+  u32 npc;          // offsetof(npc)
+  u32 spr;          // offsetof(spr)
+  u32 downcount;    // offsetof(downcount)
+  u32 feature_flags;  // offsetof(feature_flags)
+  u32 ps;           // offsetof(ps): paired singles, {u64 ps0, ps1} as double bits
+  u32 fpscr;        // offsetof(fpscr)
+  bool dr;          // the block runs with MSR.DR set (blocks are per MSR.DR/IR,
+                    // and instructions that change the MSR end the block)
+};
+
+class Emitter
+{
+public:
+  Emitter(WasmJit::CodeWriter& c, const Machine& m) : c(c), m(m) {}
+
+  // ---- registers ----
+  // GPRs live in locals within a block: loaded on first use, written back
+  // (Flush) before anything that reads PowerPCState (Interpreter calls,
+  // callbacks, block exit) and reloaded after anything that may write it.
+  //
+  // Rule for control flow: a register must not be loaded for the first time
+  // inside a conditional path (its local would be stale on the other path),
+  // so ops Use() their registers before branching.
+  void PushGPR(u32 r)
+  {
+    Use(r);
+    c.LocalGet(L_GPR0 + r);
+  }
+  void Use(u32 r)
+  {
+    if (loaded & (1u << r))
+      return;
+    c.I32ConstU(m.ppc);
+    c.I32Load(m.gpr + 4 * r);
+    c.LocalSet(L_GPR0 + r);
+    loaded |= 1u << r;
+  }
+  // r = value()
+  template <typename F>
+  void SetGPR(u32 r, F value)
+  {
+    value();
+    c.LocalSet(L_GPR0 + r);
+    loaded |= 1u << r;
+    dirty |= 1u << r;
+  }
+  void SetGPRFromLocal(u32 r, u32 local)
+  {
+    SetGPR(r, [&] { c.LocalGet(local); });
+  }
+  // Write dirty registers back to PowerPCState. With `keep_dirty`, only emit
+  // the stores (for one branch of a conditional; the other branch still has
+  // them dirty).
+  void Flush(bool keep_dirty = false)
+  {
+    for (u32 r = 0; r < 32; r++)
+    {
+      if (!(dirty & (1u << r)))
+        continue;
+      c.I32ConstU(m.ppc);
+      c.LocalGet(L_GPR0 + r);
+      c.I32Store(m.gpr + 4 * r);
+    }
+    if (!keep_dirty)
+      dirty = 0;
+  }
+  // After something that may have written registers in PowerPCState.
+  void Invalidate() { loaded = dirty = 0; }
+  // Reload r from PowerPCState into its local (it stays marked loaded).
+  void Reload(u32 r)
+  {
+    c.I32ConstU(m.ppc);
+    c.I32Load(m.gpr + 4 * r);
+    c.LocalSet(L_GPR0 + r);
+  }
+
+  u32 loaded = 0;
+  u32 dirty = 0;
+
+  void PushRAOrZero(u32 ra)
+  {
+    if (ra)
+      PushGPR(ra);
+    else
+      c.I32Const(0);
+  }
+
+  // CR0 from a 32-bit result in `local` (Interpreter::Helper_UpdateCR0).
+  void UpdateCR0(u32 local)
+  {
+    c.I32ConstU(m.ppc);
+    c.LocalGet(local);
+    c.I64ExtendI32S();
+    c.LocalGet(local);
+    c.I32Eqz();
+    c.I64ExtendI32U();
+    c.I64Const(63);
+    c.I64Shl();
+    c.I64Or();
+    c.I64Const(static_cast<s64>(~(1ULL << PowerPC::CR_EMU_SO_BIT)));
+    c.I64And();
+    PushSO();
+    c.I64ExtendI32U();
+    c.I64Const(PowerPC::CR_EMU_SO_BIT);
+    c.I64Shl();
+    c.I64Or();
+    c.I64Store(m.cr);
+  }
+  void PushSO()
+  {
+    c.I32ConstU(m.ppc);
+    c.I32Load8U(m.xer_so_ov);
+    c.I32Const(1);
+    c.I32ShrU();
+  }
+  // CR field from an LT/GT/EQ comparison of locals L_T (a) and L_V (b)
+  // (Interpreter::Helper_IntCompare).
+  void Compare(u32 crf, bool is_signed)
+  {
+    c.I32ConstU(m.ppc);
+    // index = LT*8 | GT*4 | EQ*2 | SO
+    c.LocalGet(L_T);
+    c.LocalGet(L_V);
+    is_signed ? c.I32LtS() : c.I32LtU();
+    c.I32Const(3);
+    c.I32Shl();
+    c.LocalGet(L_T);
+    c.LocalGet(L_V);
+    is_signed ? c.I32GtS() : c.I32GtU();
+    c.I32Const(2);
+    c.I32Shl();
+    c.I32Or();
+    c.LocalGet(L_T);
+    c.LocalGet(L_V);
+    c.I32Eq();
+    c.I32Const(1);
+    c.I32Shl();
+    c.I32Or();
+    PushSO();
+    c.I32Or();
+    c.I32Const(3);
+    c.I32Shl();
+    c.I32ConstU(m.cr_table);
+    c.I32Add();
+    c.I64Load();
+    c.I64Store(m.cr + 8 * crf);
+  }
+  void SetCarryFromStack()
+  {
+    // value (0/1) on the stack -> xer_ca
+    c.LocalSet(L_T);
+    c.I32ConstU(m.ppc);
+    c.LocalGet(L_T);
+    c.I32Store8(m.xer_ca);
+  }
+  void PushCarry()
+  {
+    c.I32ConstU(m.ppc);
+    c.I32Load8U(m.xer_ca);
+  }
+
+  // Pushes CR bit `bi` (0/1), like ConditionRegister::GetBit.
+  void PushCRBit(u32 bi)
+  {
+    c.I32ConstU(m.ppc);
+    c.I64Load(m.cr + 8 * (bi >> 2));
+    switch (bi & 3)
+    {
+    case 0:  // LT: bit 62
+      c.I64Const(PowerPC::CR_EMU_LT_BIT);
+      c.I64ShrU();
+      c.I32WrapI64();
+      c.I32Const(1);
+      c.I32And();
+      break;
+    case 1:  // GT: (s64)cr_val > 0
+      c.I64Const(0);
+      c.I64GtS();
+      break;
+    case 2:  // EQ: low 32 bits are zero
+      c.I32WrapI64();
+      c.I32Eqz();
+      break;
+    default:  // SO: bit 59
+      c.I64Const(PowerPC::CR_EMU_SO_BIT);
+      c.I64ShrU();
+      c.I32WrapI64();
+      c.I32Const(1);
+      c.I32And();
+      break;
+    }
+  }
+  void PushSPR(u32 index)
+  {
+    c.I32ConstU(m.ppc);
+    c.I32Load(m.spr + 4 * index);
+  }
+  template <typename F>
+  void SetSPR(u32 index, F value)
+  {
+    c.I32ConstU(m.ppc);
+    value();
+    c.I32Store(m.spr + 4 * index);
+  }
+  void SetNPC(u32 local)
+  {
+    c.I32ConstU(m.ppc);
+    c.LocalGet(local);
+    c.I32Store(m.npc);
+  }
+
+
+  // ---- floating point ----
+  // Paired-single registers stay in PowerPCState (not cached in locals).
+  u32 PSOff(u32 r, u32 half) const { return m.ps + 16 * r + 8 * half; }
+  void PushPS(u32 r, u32 half)  // as f64
+  {
+    c.I32ConstU(m.ppc);
+    c.F64Load(PSOff(r, half));
+  }
+  void PushPSBits(u32 r, u32 half)  // as i64
+  {
+    c.I32ConstU(m.ppc);
+    c.I64Load(PSOff(r, half));
+  }
+  void StorePSFromLocal(u32 r, u32 half, u32 local_f64)
+  {
+    c.I32ConstU(m.ppc);
+    c.LocalGet(local_f64);
+    c.F64Store(PSOff(r, half));
+  }
+  void StorePSBitsFromLocal(u32 r, u32 half, u32 local_i64)
+  {
+    c.I32ConstU(m.ppc);
+    c.LocalGet(local_i64);
+    c.I64Store(PSOff(r, half));
+  }
+  // br_if `depth` if local f64 is NaN: NaNs and their FPSCR side effects are
+  // left to the Interpreter.
+  void BrIfNaN(u32 local_f64, u32 depth)
+  {
+    c.LocalGet(local_f64);
+    c.LocalGet(local_f64);
+    c.F64Ne();
+    c.BrIf(depth);
+  }
+  void PushFPSCRBit(u32 mask)
+  {
+    c.I32ConstU(m.ppc);
+    c.I32Load(m.fpscr);
+    c.I32ConstU(mask);
+    c.I32And();
+  }
+  // Force25Bit (Interpreter_FPUtils.h), normal-number path: round the
+  // mantissa to 25 bits. Pushes the result. (The subnormal-double path is
+  // not reproduced; GameCube values never get there.)
+  void Force25Bit(u32 local_f64)
+  {
+    c.LocalGet(local_f64);
+    c.I64ReinterpretF64();
+    c.LocalTee(L_X);
+    c.I64Const(static_cast<s64>(0xFFFFFFFFF8000000ULL));
+    c.I64And();
+    c.LocalGet(L_X);
+    c.I64Const(0x8000000);
+    c.I64And();
+    c.I64Add();
+    c.F64ReinterpretI64();
+  }
+  // ForceSingle (Interpreter_FPUtils.h): round to single and back, with the
+  // FPSCR.NI flush. local -> stack (f64).
+  void ForceSingle(u32 local_f64)
+  {
+    // flushed: sign only (selected when NI && |x| < smallest normal single)
+    c.LocalGet(local_f64);
+    c.I64ReinterpretF64();
+    c.I64Const(static_cast<s64>(0x8000000000000000ULL));
+    c.I64And();
+    c.F64ReinterpretI64();
+    // normal conversion
+    c.LocalGet(local_f64);
+    c.F32DemoteF64();
+    c.F64PromoteF32();
+    // NI && (bits & ~sign) < 0x3810000000000000
+    PushFPSCRBit(1u << 2);  // NI
+    c.I32Const(0);
+    c.I32Ne();
+    c.LocalGet(local_f64);
+    c.I64ReinterpretF64();
+    c.I64Const(0x7FFFFFFFFFFFFFFFLL);
+    c.I64And();
+    c.I64Const(0x3810000000000000LL);
+    c.I64LtU();
+    c.I32And();
+    c.Select();
+  }
+  // ForceDouble: flush subnormal doubles to zero when FPSCR.NI. local -> stack.
+  void ForceDouble(u32 local_f64)
+  {
+    c.LocalGet(local_f64);
+    c.I64ReinterpretF64();
+    c.I64Const(static_cast<s64>(0x8000000000000000ULL));
+    c.I64And();
+    c.F64ReinterpretI64();
+    c.LocalGet(local_f64);
+    PushFPSCRBit(1u << 2);
+    c.I32Const(0);
+    c.I32Ne();
+    // exponent == 0 && fraction != 0
+    c.LocalGet(local_f64);
+    c.I64ReinterpretF64();
+    c.I64Const(0x7FF0000000000000LL);
+    c.I64And();
+    c.I64Eqz();
+    c.I32And();
+    c.LocalGet(local_f64);
+    c.I64ReinterpretF64();
+    c.I64Const(0x000FFFFFFFFFFFFFLL);
+    c.I64And();
+    c.I64Const(0);
+    c.I64Ne();
+    c.I32And();
+    c.Select();
+  }
+  // ConvertToDouble (Interpreter_FPUtils.h) of the single in local i32 `v`
+  // -> stack (i64 bits).
+  void ConvertToDouble(u32 v)
+  {
+    // e = (v >> 23) & 0xff; subnormal (e == 0 && frac != 0): exact promote
+    c.LocalGet(v);
+    c.I32ConstU(0x7f800000);
+    c.I32And();
+    c.I32Eqz();
+    c.LocalGet(v);
+    c.I32ConstU(0x007fffff);
+    c.I32And();
+    c.I32Const(0);
+    c.I32Ne();
+    c.I32And();
+    c.If(WasmJit::I64);
+    {
+      c.LocalGet(v);
+      c.F32ReinterpretI32();
+      c.F64PromoteF32();
+      c.I64ReinterpretF64();
+    }
+    c.Else();
+    {
+      // ((x & 0xc0000000) << 32) | ((x & 0x3fffffff) << 29) | z
+      c.LocalGet(v);
+      c.I64ExtendI32U();
+      c.LocalTee(L_X2);
+      c.I64Const(0xc0000000LL);
+      c.I64And();
+      c.I64Const(32);
+      c.I64Shl();
+      c.LocalGet(L_X2);
+      c.I64Const(0x3fffffffLL);
+      c.I64And();
+      c.I64Const(29);
+      c.I64Shl();
+      c.I64Or();
+      // z = 0x3800000000000000 if e == 255 || (e != 0 && !(x & 0x40000000))
+      c.I64Const(0x3800000000000000LL);
+      c.I64Const(0);
+      c.LocalGet(v);
+      c.I32ConstU(0x7f800000);
+      c.I32And();
+      c.LocalTee(L_T);
+      c.I32ConstU(0x7f800000);
+      c.I32Eq();
+      c.LocalGet(L_T);
+      c.I32Const(0);
+      c.I32Ne();
+      c.LocalGet(v);
+      c.I32ConstU(0x40000000);
+      c.I32And();
+      c.I32Eqz();
+      c.I32And();
+      c.I32Or();
+      c.Select();
+      c.I64Or();
+    }
+    c.End();
+  }
+  // Single from double bits in local i64 `x`, the stfs way (ConvertToSingle):
+  // pushes the u32, or branches to `depth` for the denormal-result case.
+  // With ftz (psq_st: ConvertToSingleFTZ) that case becomes the sign instead.
+  void ConvertToSingle(u32 x, bool ftz, u32 depth)
+  {
+    // exp = (x >> 52) & 0x7ff; simple path when exp > 896 || exp < 874 || |x| == 0
+    c.LocalGet(x);
+    c.I64Const(52);
+    c.I64ShrU();
+    c.I32WrapI64();
+    c.I32ConstU(0x7ff);
+    c.I32And();
+    c.LocalTee(L_T);
+    c.I32ConstU(896);
+    c.I32LeU();
+    c.LocalGet(L_T);
+    c.I32ConstU(ftz ? 0 : 874);
+    c.I32GeU();
+    c.I32And();
+    c.LocalGet(x);
+    c.I64Const(0x7FFFFFFFFFFFFFFFLL);
+    c.I64And();
+    c.I64Const(0);
+    c.I64Ne();
+    c.I32And();
+    if (ftz)
+    {
+      c.If(WasmJit::I32);
+      c.LocalGet(x);
+      c.I64Const(32);
+      c.I64ShrU();
+      c.I32WrapI64();
+      c.I32ConstU(0x80000000);
+      c.I32And();
+      c.Else();
+    }
+    else
+    {
+      c.BrIf(depth);
+    }
+    // ((x >> 32) & 0xc0000000) | ((x >> 29) & 0x3fffffff)
+    c.LocalGet(x);
+    c.I64Const(32);
+    c.I64ShrU();
+    c.I32WrapI64();
+    c.I32ConstU(0xc0000000);
+    c.I32And();
+    c.LocalGet(x);
+    c.I64Const(29);
+    c.I64ShrU();
+    c.I32WrapI64();
+    c.I32ConstU(0x3fffffff);
+    c.I32And();
+    c.I32Or();
+    if (ftz)
+      c.End();
+  }
+  void Bswap64()  // i64 on the stack
+  {
+    c.LocalTee(L_X2);
+    c.I32WrapI64();
+    Bswap32();
+    c.I64ExtendI32U();
+    c.I64Const(32);
+    c.I64Shl();
+    c.LocalGet(L_X2);
+    c.I64Const(32);
+    c.I64ShrU();
+    c.I32WrapI64();
+    Bswap32();
+    c.I64ExtendI32U();
+    c.I64Or();
+  }
+
+  void Bswap32()  // value on the stack
+  {
+    c.LocalTee(L_T);
+    c.I32Const(8);
+    c.I32Rotl();
+    c.I32ConstU(0x00ff00ff);
+    c.I32And();
+    c.LocalGet(L_T);
+    c.I32Const(8);
+    c.I32Rotr();
+    c.I32ConstU(0xff00ff00);
+    c.I32And();
+    c.I32Or();
+  }
+
+  // ---- memory ----
+  // Resolves L_EA to a host address in L_HOST, or branches to `slow` (a label
+  // `depth` levels out) when the fast path doesn't apply: page-crossing
+  // access, page-table translation, anything that isn't plain RAM, the data
+  // cache emulation, or a cache-inhibited store that isn't a full aligned word.
+  // Mirrors MMU::ReadFromHardware / WriteToHardware for the RAM case.
+  void Translate(u32 size, bool store, u32 depth)
+  {
+    if (size > 1)
+    {
+      c.LocalGet(L_EA);
+      c.I32ConstU(0xfff);
+      c.I32And();
+      c.I32ConstU(0x1000 - size);
+      c.I32GtU();
+      c.BrIf(depth);
+    }
+    if (!m.dr)
+    {
+      // Real mode: the effective address is physical.
+      c.LocalGet(L_EA);
+      c.LocalSet(L_PHYS);
+      c.I32Const(0);
+      c.LocalSet(L_WI);
+    }
+    else
+    {
+      // translate through the data BATs
+      c.LocalGet(L_EA);
+      c.I32Const(PowerPC::BAT_INDEX_SHIFT);
+      c.I32ShrU();
+      c.I32Const(2);
+      c.I32Shl();
+      c.I32ConstU(m.dbat);
+      c.I32Add();
+      c.I32Load();
+      c.LocalTee(L_E);
+      c.I32Const(PowerPC::BAT_MAPPED_BIT);
+      c.I32And();
+      c.I32Eqz();
+      c.BrIf(depth + 1);  // not BAT-mapped: page tables, take the slow path
+      c.LocalGet(L_E);
+      c.I32ConstU(PowerPC::BAT_RESULT_MASK);
+      c.I32And();
+      c.LocalGet(L_EA);
+      c.I32ConstU(PowerPC::BAT_PAGE_SIZE - 1);
+      c.I32And();
+      c.I32Or();
+      c.LocalSet(L_PHYS);
+      c.LocalGet(L_E);
+      c.I32Const(PowerPC::BAT_WI_BIT);
+      c.I32And();
+      c.LocalSet(L_WI);
+    }
+    // data cache emulation: slow path
+    c.I32ConstU(m.ppc);
+    c.I32Load8U(m.dcache);
+    c.BrIf(depth);
+    if (store)
+    {
+      // Cache-inhibited stores smaller than an aligned word have odd hardware
+      // behaviour (MMU::WriteToHardware): slow path.
+      c.LocalGet(L_WI);
+      if (size < 4)
+      {
+        c.BrIf(depth);
+      }
+      else
+      {
+        c.LocalGet(L_PHYS);
+        c.I32Const(3);
+        c.I32And();
+        c.I32And();
+        c.BrIf(depth);
+      }
+    }
+    // RAM: (phys & 0xF8000000) == 0
+    c.LocalGet(L_PHYS);
+    c.I32ConstU(0xF8000000);
+    c.I32And();
+    if (m.exram)
+    {
+      c.If();
+      {
+        // MEM2: (phys >> 28) == 1 && (phys & 0x0FFFFFFF) < size
+        c.LocalGet(L_PHYS);
+        c.I32Const(28);
+        c.I32ShrU();
+        c.I32Const(1);
+        c.I32Ne();
+        c.BrIf(depth + 1);
+        c.LocalGet(L_PHYS);
+        c.I32ConstU(0x0FFFFFFF);
+        c.I32And();
+        c.LocalTee(L_HOST);
+        c.I32ConstU(m.exram_size);
+        c.I32GeU();
+        c.BrIf(depth + 1);
+        c.LocalGet(L_HOST);
+        c.I32ConstU(m.exram);
+        c.I32Add();
+        c.LocalSet(L_HOST);
+      }
+      c.Else();
+      {
+        c.LocalGet(L_PHYS);
+        c.I32ConstU(m.ram_mask);
+        c.I32And();
+        c.I32ConstU(m.ram);
+        c.I32Add();
+        c.LocalSet(L_HOST);
+      }
+      c.End();
+    }
+    else
+    {
+      c.BrIf(depth);
+      c.LocalGet(L_PHYS);
+      c.I32ConstU(m.ram_mask);
+      c.I32And();
+      c.I32ConstU(m.ram);
+      c.I32Add();
+      c.LocalSet(L_HOST);
+    }
+  }
+
+  // Loads `size` bytes big-endian from L_HOST onto the stack.
+  void LoadHost(u32 size, bool sign)
+  {
+    if (size == 1)
+    {
+      c.LocalGet(L_HOST);
+      sign ? c.I32Load8S() : c.I32Load8U();
+    }
+    else if (size == 2)
+    {
+      c.LocalGet(L_HOST);
+      sign ? c.I32Load8S() : c.I32Load8U();
+      c.I32Const(8);
+      c.I32Shl();
+      c.LocalGet(L_HOST);
+      c.I32Load8U(1);
+      c.I32Or();
+    }
+    else
+    {
+      c.LocalGet(L_HOST);
+      c.I32Load();
+      Bswap32();
+    }
+  }
+  // Stores the low `size` bytes of `local` big-endian at L_HOST.
+  void StoreHost(u32 size, u32 local)
+  {
+    if (size == 1)
+    {
+      c.LocalGet(L_HOST);
+      c.LocalGet(local);
+      c.I32Store8();
+    }
+    else if (size == 2)
+    {
+      c.LocalGet(L_HOST);
+      c.LocalGet(local);
+      c.I32Const(8);
+      c.I32ShrU();
+      c.I32Store8();
+      c.LocalGet(L_HOST);
+      c.LocalGet(local);
+      c.I32Store8(1);
+    }
+    else
+    {
+      c.LocalGet(L_HOST);
+      c.LocalGet(local);
+      Bswap32();
+      c.I32Store();
+    }
+  }
+
+  WasmJit::CodeWriter& c;
+  const Machine& m;
+};
+
+}  // namespace
+
+
+// ---- floating point / paired singles ----
+// Matches the Interpreter's results bit for bit: anything that would produce
+// a NaN, plus the rare fused-multiply-add cases that need extra precision,
+// goes to the Interpreter (which also raises the FPSCR exceptions). FPSCR's
+// FPRF/FI/FR are not updated for arithmetic, like Dolphin's JITs (Jit64,
+// JitArm64) without the "FPRF" setting; Rc forms go to the Interpreter.
+enum WasmJitGroup : u32
+{
+  GROUP_FP_LOADSTORE = 1,  // lfs/lfd/stfs/stfd
+  GROUP_PSQ = 2,           // psq_l/psq_st
+  GROUP_FP_SINGLE = 4,     // opcode 59
+  GROUP_FP_DOUBLE = 8,     // opcode 63 arithmetic, frsp, fctiwz
+  GROUP_FP_MOVE = 16,      // fmr/fneg/fabs/fnabs/fsel, ps moves/merges/sel
+  GROUP_FP_COMPARE = 32,   // fcmpu/fcmpo/ps_cmp*
+  GROUP_PS_ARITH = 64,     // ps arithmetic
+  GROUP_INTEGER = 128,     // everything outside EmitInlineFP
+};
+static u32 s_disabled_groups = 0;
+static bool Enabled(u32 group)
+{
+  return (s_disabled_groups & group) == 0;
+}
+
+static bool EmitInlineFP(Emitter& e, UGeckoInstruction inst, bool& handled,
+                         const std::function<void()>& fallback)
+{
+  using namespace WasmJit;
+  WasmJit::CodeWriter& c = e.c;
+  handled = true;
+
+  // block { block { body (br_if 0 = slow) ; br 1 } ; fallback } ;
+  auto with_fallback = [&](auto body, bool reads_gprs) {
+    c.Block();
+    c.Block();
+    body();
+    c.Br(1);
+    c.End();
+    if (reads_gprs)
+      e.Flush(true);
+    fallback();
+    c.End();
+    return true;
+  };
+
+  // Raw result of a single-precision op on halves (ha of a, hb of b/c)
+  // into `dst` (f64 local); branches to 0 on cases left to the Interpreter.
+  enum class Op { Add, Sub, Mul, Div, Madd, Msub };
+  auto single_raw = [&](Op op, u32 fa, u32 ha, u32 fb, u32 hb, u32 fc, u32 hc, u32 dst) {
+    switch (op)
+    {
+    case Op::Add:
+    case Op::Sub:
+    case Op::Div:
+      e.PushPS(fa, ha);
+      e.PushPS(fb, hb);
+      op == Op::Add ? c.F64Add() : op == Op::Sub ? c.F64Sub() : c.F64Div();
+      c.LocalSet(dst);
+      break;
+    case Op::Mul:
+      e.PushPS(fc, hc);
+      c.LocalSet(L_F5);
+      e.PushPS(fa, ha);
+      e.Force25Bit(L_F5);
+      c.F64Mul();
+      c.LocalSet(dst);
+      break;
+    case Op::Madd:
+    case Op::Msub:
+      // NI_madd_msub<single>: fma(a, Force25Bit(c), +-b), with a tie fix-up.
+      // a * Force25Bit(c) is exact in a double when a has at most 28
+      // significant bits (always, for single-precision values), and then
+      // a * c + b rounds once, like the fma. Otherwise: Interpreter.
+      e.PushPSBits(fa, ha);
+      c.I64Const(0x1FFFFFF);
+      c.I64And();
+      c.I64Const(0);
+      c.I64Ne();
+      c.BrIf(0);
+      e.PushPS(fc, hc);
+      c.LocalSet(L_F5);
+      e.PushPS(fa, ha);
+      e.Force25Bit(L_F5);
+      c.F64Mul();
+      e.PushPS(fb, hb);
+      op == Op::Madd ? c.F64Add() : c.F64Sub();
+      c.LocalTee(dst);
+      // the tie case the Interpreter corrects: (bits & 0x1fffffff) == 0x10000000
+      c.I64ReinterpretF64();
+      c.I64Const(0x1fffffff);
+      c.I64And();
+      c.I64Const(0x10000000);
+      c.I64Eq();
+      c.BrIf(0);
+      break;
+    }
+    e.BrIfNaN(dst, 0);
+  };
+  // dst = ForceSingle(src), negated for the nmadd/nmsub forms (src isn't NaN)
+  auto to_single = [&](u32 src, u32 dst, bool negate) {
+    e.ForceSingle(src);
+    if (negate)
+      c.F64Neg();
+    c.LocalSet(dst);
+  };
+
+  const u32 fd = inst.FD, fa = inst.FA, fb = inst.FB, fc = inst.FC;
+
+  // ---------------- loads / stores ----------------
+  enum class Mem { LFS, LFD, STFS, STFD, PSQ_L, PSQ_ST };
+  auto fpmem = [&](Mem kind, auto ea, bool update, bool w = false, u32 gqr = 0) {
+    if (!Enabled((kind == Mem::PSQ_L || kind == Mem::PSQ_ST) ? GROUP_PSQ : GROUP_FP_LOADSTORE))
+      return false;
+    const bool store = kind == Mem::STFS || kind == Mem::STFD || kind == Mem::PSQ_ST;
+    const u32 size = (kind == Mem::LFD || kind == Mem::STFD) ? 8 :
+                     ((kind == Mem::PSQ_L || kind == Mem::PSQ_ST) && !w) ? 8 : 4;
+    c.Block();  // $done
+    c.Block();  // $slow
+    ea();
+    c.LocalSet(L_EA);
+    if (kind == Mem::PSQ_L || kind == Mem::PSQ_ST)
+    {
+      // HID2.LSQE must be set, and the GQR type must be float
+      e.PushSPR(SPR_HID2);
+      c.I32ConstU(0x80000000);
+      c.I32And();
+      c.I32Eqz();
+      c.BrIf(0);
+      e.PushSPR(SPR_GQR0 + gqr);
+      if (kind == Mem::PSQ_L)
+      {
+        c.I32Const(16);
+        c.I32ShrU();
+      }
+      c.I32Const(7);
+      c.I32And();
+      c.BrIf(0);
+    }
+    else
+    {
+      // lfs/lfd/stfs/stfd: misaligned -> alignment exception (Interpreter)
+      c.LocalGet(L_EA);
+      c.I32Const(3);
+      c.I32And();
+      c.BrIf(0);
+    }
+    // store values, before translating (stfs may need the Interpreter)
+    if (kind == Mem::STFS)
+    {
+      e.PushPSBits(fd, 0);
+      c.LocalSet(L_X);
+      e.ConvertToSingle(L_X, false, 0);
+      c.LocalSet(L_V);
+    }
+    else if (kind == Mem::STFD)
+    {
+      e.PushPSBits(fd, 0);
+      c.LocalSet(L_X);
+    }
+    else if (kind == Mem::PSQ_ST)
+    {
+      e.PushPSBits(fd, 0);
+      c.LocalSet(L_X);
+      e.ConvertToSingle(L_X, true, 0);
+      c.LocalSet(L_V);
+      if (!w)
+      {
+        e.PushPSBits(fd, 1);
+        c.LocalSet(L_X);
+        e.ConvertToSingle(L_X, true, 0);
+        c.LocalSet(L_V2);
+      }
+    }
+    e.Translate(size, store, 0);
+    switch (kind)
+    {
+    case Mem::LFS:
+      c.LocalGet(L_HOST);
+      c.I32Load();
+      e.Bswap32();
+      c.LocalSet(L_V);
+      e.ConvertToDouble(L_V);
+      c.LocalSet(L_X);
+      e.StorePSBitsFromLocal(fd, 0, L_X);
+      e.StorePSBitsFromLocal(fd, 1, L_X);
+      break;
+    case Mem::LFD:
+      c.LocalGet(L_HOST);
+      c.I64Load();
+      e.Bswap64();
+      c.LocalSet(L_X);
+      e.StorePSBitsFromLocal(fd, 0, L_X);
+      break;
+    case Mem::PSQ_L:
+      c.LocalGet(L_HOST);
+      c.I32Load();
+      e.Bswap32();
+      c.LocalSet(L_V);
+      e.ConvertToDouble(L_V);
+      c.LocalSet(L_X);
+      if (w)
+      {
+        c.I64Const(0x3FF0000000000000LL);  // 1.0
+      }
+      else
+      {
+        c.LocalGet(L_HOST);
+        c.I32Load(4);
+        e.Bswap32();
+        c.LocalSet(L_V);
+        e.ConvertToDouble(L_V);
+      }
+      c.LocalSet(L_X2);
+      e.StorePSBitsFromLocal(fd, 0, L_X);
+      e.StorePSBitsFromLocal(fd, 1, L_X2);
+      break;
+    case Mem::STFS:
+      e.StoreHost(4, L_V);
+      break;
+    case Mem::STFD:
+      c.LocalGet(L_HOST);
+      c.LocalGet(L_X);
+      e.Bswap64();
+      c.I64Store();
+      break;
+    case Mem::PSQ_ST:
+      e.StoreHost(4, L_V);
+      if (!w)
+      {
+        c.LocalGet(L_HOST);
+        c.LocalGet(L_V2);
+        e.Bswap32();
+        c.I32Store(4);
+      }
+      break;
+    }
+    if (update)
+      e.SetGPRFromLocal(inst.RA, L_EA);
+    c.Br(1);
+    c.End();  // $slow
+    e.Flush(true);
+    fallback();
+    if (update)
+      e.Reload(inst.RA);
+    c.End();  // $done
+    if (update)
+    {
+      e.loaded |= 1u << inst.RA;
+      e.dirty |= 1u << inst.RA;
+    }
+    return true;
+  };
+  const u32 ra = inst.RA, rb = inst.RB;
+  auto ea_d = [&] { e.PushRAOrZero(ra); c.I32Const(inst.SIMM_16); c.I32Add(); };
+  auto ea_du = [&] { e.PushGPR(ra); c.I32Const(inst.SIMM_16); c.I32Add(); };
+  auto ea_x = [&] { e.PushRAOrZero(ra); e.PushGPR(rb); c.I32Add(); };
+  auto ea_xu = [&] { e.PushGPR(ra); e.PushGPR(rb); c.I32Add(); };
+  auto ea_q = [&] { e.PushRAOrZero(ra); c.I32Const(inst.SIMM_12); c.I32Add(); };
+  auto ea_qu = [&] { e.PushGPR(ra); c.I32Const(inst.SIMM_12); c.I32Add(); };
+
+  switch (inst.OPCD)
+  {
+  case 48: return fpmem(Mem::LFS, ea_d, false);
+  case 49: return fpmem(Mem::LFS, ea_du, true);
+  case 50: return fpmem(Mem::LFD, ea_d, false);
+  case 51: return fpmem(Mem::LFD, ea_du, true);
+  case 52: return fpmem(Mem::STFS, ea_d, false);
+  case 53: return fpmem(Mem::STFS, ea_du, true);
+  case 54: return fpmem(Mem::STFD, ea_d, false);
+  case 55: return fpmem(Mem::STFD, ea_du, true);
+  case 56: return fpmem(Mem::PSQ_L, ea_q, false, inst.W, inst.I);
+  case 57: return fpmem(Mem::PSQ_L, ea_qu, true, inst.W, inst.I);
+  case 60: return fpmem(Mem::PSQ_ST, ea_q, false, inst.W, inst.I);
+  case 61: return fpmem(Mem::PSQ_ST, ea_qu, true, inst.W, inst.I);
+  case 31:
+    switch (inst.SUBOP10)
+    {
+    case 535: return fpmem(Mem::LFS, ea_x, false);
+    case 567: return fpmem(Mem::LFS, ea_xu, true);
+    case 599: return fpmem(Mem::LFD, ea_x, false);
+    case 631: return fpmem(Mem::LFD, ea_xu, true);
+    case 663: return fpmem(Mem::STFS, ea_x, false);
+    case 695: return fpmem(Mem::STFS, ea_xu, true);
+    case 727: return fpmem(Mem::STFD, ea_x, false);
+    case 759: return fpmem(Mem::STFD, ea_xu, true);
+    default: handled = false; return false;
+    }
+  case 59:
+  case 63:
+  case 4:
+    break;
+  default:
+    handled = false;
+    return false;
+  }
+
+  if (inst.Rc)  // CR1 updates: Interpreter
+    return false;
+
+  // ---------------- compare helper ----------------
+  // CR field + FPSCR.FPCC from halves of a and b; NaNs -> Interpreter.
+  auto fcompare = [&](u32 ha, u32 hb) {
+    if (!Enabled(GROUP_FP_COMPARE))
+      return false;
+    return with_fallback(
+        [&] {
+          e.PushPS(fa, ha);
+          c.LocalSet(L_F0);
+          e.PushPS(fb, hb);
+          c.LocalSet(L_F1);
+          e.BrIfNaN(L_F0, 0);
+          e.BrIfNaN(L_F1, 0);
+          // code = LT*8 | GT*4 | EQ*2 (FPCC FL/FG/FE)
+          c.LocalGet(L_F0);
+          c.LocalGet(L_F1);
+          c.F64Lt();
+          c.I32Const(3);
+          c.I32Shl();
+          c.LocalGet(L_F0);
+          c.LocalGet(L_F1);
+          c.F64Gt();
+          c.I32Const(2);
+          c.I32Shl();
+          c.I32Or();
+          c.LocalGet(L_F0);
+          c.LocalGet(L_F1);
+          c.F64Eq();
+          c.I32Const(1);
+          c.I32Shl();
+          c.I32Or();
+          c.LocalSet(L_V);
+          // fpscr.FPRF = (FPRF & ~0xF) | code   (FPRF is bits 12..16)
+          c.I32ConstU(e.m.ppc);
+          c.I32ConstU(e.m.ppc);
+          c.I32Load(e.m.fpscr);
+          c.I32ConstU(~(0xFu << 12));
+          c.I32And();
+          c.LocalGet(L_V);
+          c.I32Const(12);
+          c.I32Shl();
+          c.I32Or();
+          c.I32Store(e.m.fpscr);
+          // cr.fields[crfd] = s_crTable[code]
+          c.I32ConstU(e.m.ppc);
+          c.LocalGet(L_V);
+          c.I32Const(3);
+          c.I32Shl();
+          c.I32ConstU(e.m.cr_table);
+          c.I32Add();
+          c.I64Load();
+          c.I64Store(e.m.cr + 8 * inst.CRFD);
+        },
+        false);
+  };
+  // bit ops on ps0 (and ps1): dst = f(src)
+  auto bits_op = [&](bool both, auto f) {
+    if (!Enabled(GROUP_FP_MOVE))
+      return false;
+    for (u32 h = 0; h < (both ? 2u : 1u); h++)
+    {
+      e.PushPSBits(fb, h);
+      f();
+      c.LocalSet(h ? L_X2 : L_X);
+    }
+    for (u32 h = 0; h < (both ? 2u : 1u); h++)
+      e.StorePSBitsFromLocal(fd, h, h ? L_X2 : L_X);
+    return true;
+  };
+  constexpr s64 SIGN = static_cast<s64>(0x8000000000000000ULL);
+
+  if (inst.OPCD == 59)
+  {
+    if (!Enabled(GROUP_FP_SINGLE))
+      return false;
+    Op op;
+    bool neg = false;
+    switch (inst.SUBOP5)
+    {
+    case 18: op = Op::Div; break;
+    case 20: op = Op::Sub; break;
+    case 21: op = Op::Add; break;
+    case 25: op = Op::Mul; break;
+    case 28: op = Op::Msub; break;
+    case 29: op = Op::Madd; break;
+    case 30: op = Op::Msub; neg = true; break;
+    case 31: op = Op::Madd; neg = true; break;
+    default: return false;  // fres
+    }
+    return with_fallback(
+        [&] {
+          single_raw(op, fa, 0, fb, 0, fc, 0, L_F0);
+          to_single(L_F0, L_F2, neg);
+          e.StorePSFromLocal(fd, 0, L_F2);
+          e.StorePSFromLocal(fd, 1, L_F2);
+        },
+        false);
+  }
+
+  if (inst.OPCD == 63)
+  {
+    if (inst.SUBOP5 == 23 && !Enabled(GROUP_FP_MOVE))
+      return false;
+    if (inst.SUBOP5 != 23 && !Enabled(GROUP_FP_DOUBLE) &&
+        !(inst.SUBOP10 == 0 || inst.SUBOP10 == 32 || inst.SUBOP10 == 40 || inst.SUBOP10 == 72 ||
+          inst.SUBOP10 == 136 || inst.SUBOP10 == 264))
+      return false;
+    switch (inst.SUBOP5)
+    {
+    case 18:  // fdiv
+    case 20:  // fsub
+    case 21:  // fadd
+    case 25:  // fmul
+      return with_fallback(
+          [&] {
+            e.PushPS(fa, 0);
+            e.PushPS(inst.SUBOP5 == 25 ? fc : fb, 0);
+            switch (inst.SUBOP5)
+            {
+            case 18: c.F64Div(); break;
+            case 20: c.F64Sub(); break;
+            case 21: c.F64Add(); break;
+            default: c.F64Mul(); break;
+            }
+            c.LocalSet(L_F0);
+            e.BrIfNaN(L_F0, 0);
+            e.ForceDouble(L_F0);
+            c.LocalSet(L_F2);
+            e.StorePSFromLocal(fd, 0, L_F2);
+          },
+          false);
+    case 23:  // fsel: ps0 = a >= -0.0 ? c : b
+      e.PushPSBits(fc, 0);
+      e.PushPSBits(fb, 0);
+      e.PushPS(fa, 0);
+      c.F64Const(-0.0);
+      c.F64Ge();
+      c.Select();
+      c.LocalSet(L_X);
+      e.StorePSBitsFromLocal(fd, 0, L_X);
+      return true;
+    default:
+      break;
+    }
+    switch (inst.SUBOP10)
+    {
+    case 0:   // fcmpu
+    case 32:  // fcmpo
+      return fcompare(0, 0);
+    case 12:  // frsp
+      return with_fallback(
+          [&] {
+            e.PushPS(fb, 0);
+            c.LocalSet(L_F0);
+            e.BrIfNaN(L_F0, 0);
+            to_single(L_F0, L_F2, false);
+            e.StorePSFromLocal(fd, 0, L_F2);
+            e.StorePSFromLocal(fd, 1, L_F2);
+          },
+          false);
+    case 15:  // fctiwz
+      return with_fallback(
+          [&] {
+            // in range (and not NaN): -2^31 <= b < 2^31, else Interpreter
+            e.PushPS(fb, 0);
+            c.LocalTee(L_F0);
+            c.F64Const(-2147483648.0);
+            c.F64Ge();
+            c.LocalGet(L_F0);
+            c.F64Const(2147483648.0);
+            c.F64Lt();
+            c.I32And();
+            c.I32Eqz();
+            c.BrIf(0);
+            // ps0 = 0xfff8000000000000 | u32(trunc(b)), | 0x100000000 for -0 results
+            c.LocalGet(L_F0);
+            c.I32TruncF64S();
+            c.LocalTee(L_V);
+            c.I64ExtendI32U();
+            c.I64Const(static_cast<s64>(0xfff8000000000000ULL));
+            c.I64Or();
+            c.I64Const(0x100000000LL);
+            c.I64Const(0);
+            c.LocalGet(L_V);
+            c.I32Eqz();
+            c.LocalGet(L_F0);
+            c.I64ReinterpretF64();
+            c.I64Const(0);
+            c.I64LtS();
+            c.I32And();
+            c.Select();
+            c.I64Or();
+            c.LocalSet(L_X);
+            e.StorePSBitsFromLocal(fd, 0, L_X);
+          },
+          false);
+    case 40:   // fneg
+      return bits_op(false, [&] { c.I64Const(SIGN); c.I64Xor(); });
+    case 72:   // fmr
+      return bits_op(false, [] {});
+    case 136:  // fnabs
+      return bits_op(false, [&] { c.I64Const(SIGN); c.I64Or(); });
+    case 264:  // fabs
+      return bits_op(false, [&] { c.I64Const(~SIGN); c.I64And(); });
+    default:
+      return false;
+    }
+  }
+
+  // ---------------- opcode 4: paired singles ----------------
+  switch (inst.SUBOP10)
+  {
+  case 0:   return fcompare(0, 0);  // ps_cmpu0
+  case 32:  return fcompare(0, 0);  // ps_cmpo0
+  case 64:  return fcompare(1, 1);  // ps_cmpu1
+  case 96:  return fcompare(1, 1);  // ps_cmpo1
+  case 40:  return bits_op(true, [&] { c.I64Const(SIGN); c.I64Xor(); });   // ps_neg
+  case 72:  return bits_op(true, [] {});                                    // ps_mr
+  case 136: return bits_op(true, [&] { c.I64Const(SIGN); c.I64Or(); });    // ps_nabs
+  case 264: return bits_op(true, [&] { c.I64Const(~SIGN); c.I64And(); });  // ps_abs
+  case 528:  // ps_merge00
+  case 560:  // ps_merge01
+  case 592:  // ps_merge10
+  case 624:  // ps_merge11
+  {
+    if (!Enabled(GROUP_FP_MOVE))
+      return false;
+    const u32 h0 = (inst.SUBOP10 == 592 || inst.SUBOP10 == 624) ? 1 : 0;  // from a
+    const u32 h1 = (inst.SUBOP10 == 560 || inst.SUBOP10 == 624) ? 1 : 0;  // from b
+    e.PushPSBits(fa, h0);
+    c.LocalSet(L_X);
+    e.PushPSBits(fb, h1);
+    c.LocalSet(L_X2);
+    e.StorePSBitsFromLocal(fd, 0, L_X);
+    e.StorePSBitsFromLocal(fd, 1, L_X2);
+    return true;
+  }
+  default:
+    break;
+  }
+
+  auto paired = [&](Op op, bool neg, u32 c_half0, u32 c_half1) {
+    if (!Enabled(GROUP_PS_ARITH))
+      return false;
+    return with_fallback(
+        [&] {
+          single_raw(op, fa, 0, fb, 0, fc, c_half0, L_F0);
+          single_raw(op, fa, 1, fb, 1, fc, c_half1, L_F1);
+          to_single(L_F0, L_F2, neg);
+          to_single(L_F1, L_F3, neg);
+          e.StorePSFromLocal(fd, 0, L_F2);
+          e.StorePSFromLocal(fd, 1, L_F3);
+        },
+        false);
+  };
+  switch (inst.SUBOP5)
+  {
+  case 10:  // ps_sum0: ps0 = a0 + b1, ps1 = c1
+  case 11:  // ps_sum1: ps0 = c0, ps1 = a0 + b1
+  {
+    if (!Enabled(GROUP_PS_ARITH))
+      return false;
+    const bool sum0 = inst.SUBOP5 == 10;
+    return with_fallback(
+        [&] {
+          single_raw(Op::Add, fa, 0, fb, 1, 0, 0, L_F0);
+          e.PushPS(fc, sum0 ? 1 : 0);
+          c.LocalSet(L_F1);
+          e.BrIfNaN(L_F1, 0);
+          to_single(L_F0, L_F2, false);
+          to_single(L_F1, L_F3, false);
+          e.StorePSFromLocal(fd, sum0 ? 0 : 1, L_F2);
+          e.StorePSFromLocal(fd, sum0 ? 1 : 0, L_F3);
+        },
+        false);
+  }
+  case 12: return paired(Op::Mul, false, 0, 0);   // ps_muls0
+  case 13: return paired(Op::Mul, false, 1, 1);   // ps_muls1
+  case 14: return paired(Op::Madd, false, 0, 0);  // ps_madds0
+  case 15: return paired(Op::Madd, false, 1, 1);  // ps_madds1
+  case 18: return paired(Op::Div, false, 0, 1);   // ps_div
+  case 20: return paired(Op::Sub, false, 0, 1);   // ps_sub
+  case 21: return paired(Op::Add, false, 0, 1);   // ps_add
+  case 23:  // ps_sel
+    if (!Enabled(GROUP_FP_MOVE))
+      return false;
+    for (u32 h = 0; h < 2; h++)
+    {
+      e.PushPSBits(fc, h);
+      e.PushPSBits(fb, h);
+      e.PushPS(fa, h);
+      c.F64Const(-0.0);
+      c.F64Ge();
+      c.Select();
+      c.LocalSet(h ? L_X2 : L_X);
+    }
+    e.StorePSBitsFromLocal(fd, 0, L_X);
+    e.StorePSBitsFromLocal(fd, 1, L_X2);
+    return true;
+  case 25: return paired(Op::Mul, false, 0, 1);   // ps_mul
+  case 28: return paired(Op::Msub, false, 0, 1);  // ps_msub
+  case 29: return paired(Op::Madd, false, 0, 1);  // ps_madd
+  case 30: return paired(Op::Msub, true, 0, 1);   // ps_nmsub
+  case 31: return paired(Op::Madd, true, 0, 1);   // ps_nmadd
+  default:
+    return false;  // ps_res, ps_rsqrte, quantized indexed loads, dcbz_l, ...
+  }
+}
+
+// Emits inline WebAssembly for one instruction, with `fallback` (a call to
+// the Interpreter's version of it) for the cases the inline code doesn't
+// handle. Returns false if the instruction isn't handled inline at all.
+static bool EmitInline(Emitter& e, UGeckoInstruction inst, u32 pc, bool branch_watch,
+                       const std::function<void()>& fallback)
+{
+  WasmJit::CodeWriter& c = e.c;
+  const u32 rd = inst.RD, ra = inst.RA, rb = inst.RB;
+
+  // ---- branches (Interpreter_Branch.cpp). The block's Interpret<true> has
+  // already set pc and npc = pc + 4. Left to the Interpreter while the
+  // debugger's branch watch is recording. ----
+  auto taken_to = [&](auto push_target, bool lk) {
+    push_target();
+    c.LocalSet(Local::L_V);
+    if (lk)
+      e.SetSPR(SPR_LR, [&] { c.I32ConstU(pc + 4); });
+    e.SetNPC(Local::L_V);
+  };
+  // Pushes the BO/BI condition (counter && condition) for bc/bclr, updating
+  // CTR first unless BO says not to.
+  auto push_bo_condition = [&](u32 bo, u32 bi, bool ctr_allowed) {
+    bool have = false;
+    if (ctr_allowed && (bo & BO_DONT_DECREMENT_FLAG) == 0)
+    {
+      e.SetSPR(SPR_CTR, [&] {
+        e.PushSPR(SPR_CTR);
+        c.I32Const(1);
+        c.I32Sub();
+      });
+      // counter: (CTR != 0) ^ BO[1]
+      e.PushSPR(SPR_CTR);
+      c.I32Const(0);
+      ((bo >> 1) & 1) ? c.I32Eq() : c.I32Ne();
+      have = true;
+    }
+    else if (ctr_allowed && ((bo >> 2) & 1) == 0)
+    {
+      // BO says check CTR but not decrement: (CTR != 0) ^ BO[1]
+      e.PushSPR(SPR_CTR);
+      c.I32Const(0);
+      ((bo >> 1) & 1) ? c.I32Eq() : c.I32Ne();
+      have = true;
+    }
+    if (((bo >> 4) & 1) == 0)  // condition check
+    {
+      e.PushCRBit(bi);
+      if (((bo >> 3) & 1) == 0)
+        c.I32Eqz();
+      if (have)
+        c.I32And();
+      have = true;
+    }
+    if (!have)
+      c.I32Const(1);  // branch always
+  };
+
+  if (!branch_watch)
+  {
+    if (inst.OPCD == 18)  // bx
+    {
+      const u32 dest = u32(SignExt26(inst.LI << 2)) + (inst.AA ? 0 : pc);
+      taken_to([&] { c.I32ConstU(dest); }, inst.LK);
+      return true;
+    }
+    if (inst.OPCD == 16)  // bcx
+    {
+      const u32 dest = u32(SignExt16(s16(inst.BD << 2))) + (inst.AA ? 0 : pc);
+      push_bo_condition(inst.BO, inst.BI, true);
+      c.If();
+      taken_to([&] { c.I32ConstU(dest); }, inst.LK);
+      c.End();
+      return true;
+    }
+    if (inst.OPCD == 19 && (inst.SUBOP10 == 16 || inst.SUBOP10 == 528))  // bclrx, bcctrx
+    {
+      const bool lr = inst.SUBOP10 == 16;
+      if (!lr && (inst.BO_2 & BO_DONT_DECREMENT_FLAG) == 0)
+        return false;  // invalid form
+      // Read LR / CTR before LK overwrites LR.
+      push_bo_condition(inst.BO_2, inst.BI_2, lr);
+      c.If();
+      taken_to(
+          [&] {
+            e.PushSPR(lr ? SPR_LR : SPR_CTR);
+            c.I32Const(~3);
+            c.I32And();
+          },
+          inst.LK_3);
+      c.End();
+      return true;
+    }
+  }
+
+  if (inst.OPCD == 4 || inst.OPCD == 59 || inst.OPCD == 63 || (inst.OPCD >= 48 && inst.OPCD <= 61) ||
+      (inst.OPCD == 31 && inst.SUBOP10 >= 535 && inst.SUBOP10 <= 759))
+  {
+    bool handled;
+    const bool ok = EmitInlineFP(e, inst, handled, fallback);
+    if (handled)
+      return ok;
+  }
+  if (!Enabled(GROUP_INTEGER) && inst.OPCD != 16 && inst.OPCD != 18 && inst.OPCD != 19)
+    return false;
+
+  // Memory access with fast path + interpreter fallback.
+  //   ea():     pushes the effective address
+  //   size, sign, store, update: access kind
+  auto mem = [&](auto ea, u32 size, bool sign, bool store, bool update) {
+    c.Block();  // $done
+    c.Block();  // $slow
+    ea();
+    c.LocalSet(Local::L_EA);
+    if (store)
+    {
+      e.PushGPR(rd);  // RS
+      c.LocalSet(Local::L_V);
+    }
+    e.Translate(size, store, 0);
+    if (store)
+    {
+      e.StoreHost(size, Local::L_V);
+    }
+    else
+    {
+      e.SetGPR(rd, [&] { e.LoadHost(size, sign); });
+    }
+    if (update)
+      e.SetGPRFromLocal(ra, Local::L_EA);
+    c.Br(1);
+    c.End();  // $slow
+    // Slow path: the Interpreter does the access from PowerPCState, so write
+    // back what's only in locals; it may change rD (loads) and rA (update).
+    e.Flush(true);
+    fallback();
+    if (!store)
+      e.Reload(rd);
+    if (update)
+      e.Reload(ra);
+    c.End();  // $done
+    if (!store)
+    {
+      e.loaded |= 1u << rd;
+      e.dirty |= 1u << rd;
+    }
+    if (update)
+    {
+      e.loaded |= 1u << ra;
+      e.dirty |= 1u << ra;
+    }
+    return true;
+  };
+  auto ea_d = [&] {
+    e.PushRAOrZero(ra);
+    c.I32Const(inst.SIMM_16);
+    c.I32Add();
+  };
+  auto ea_du = [&] {
+    e.PushGPR(ra);
+    c.I32Const(inst.SIMM_16);
+    c.I32Add();
+  };
+  auto ea_x = [&] {
+    e.PushRAOrZero(ra);
+    e.PushGPR(rb);
+    c.I32Add();
+  };
+  auto ea_xu = [&] {
+    e.PushGPR(ra);
+    e.PushGPR(rb);
+    c.I32Add();
+  };
+
+  // result of `value()` -> rD/rA, then CR0 if Rc
+  auto alu = [&](u32 dst, bool rc, auto value) {
+    value();
+    c.LocalSet(Local::L_V);
+    e.SetGPRFromLocal(dst, Local::L_V);
+    if (rc)
+      e.UpdateCR0(Local::L_V);
+    return true;
+  };
+
+  switch (inst.OPCD)
+  {
+  case 7:  // mulli
+    return alu(rd, false, [&] {
+      e.PushGPR(ra);
+      c.I32Const(inst.SIMM_16);
+      c.I32Mul();
+    });
+  case 8:  // subfic: rD = imm - rA; CA = (a == 0) || carry(0 - a, imm)
+    e.PushGPR(ra);
+    c.LocalSet(Local::L_T);
+    c.I32Const(inst.SIMM_16);
+    c.LocalGet(Local::L_T);
+    c.I32Sub();
+    c.LocalSet(Local::L_V);
+    e.SetGPRFromLocal(rd, Local::L_V);
+    // carry(x, y) = y > ~x, with x = 0 - a = -a, y = imm  ->  imm > ~(-a) = imm > a - 1
+    c.LocalGet(Local::L_T);
+    c.I32Eqz();
+    c.I32ConstU(static_cast<u32>(inst.SIMM_16));
+    c.LocalGet(Local::L_T);
+    c.I32Const(1);
+    c.I32Sub();
+    c.I32GtU();
+    c.I32Or();
+    e.SetCarryFromStack();
+    return true;
+  case 10:  // cmpli
+  case 11:  // cmpi
+    e.PushGPR(ra);
+    c.LocalSet(Local::L_T);
+    if (inst.OPCD == 11)
+      c.I32Const(inst.SIMM_16);
+    else
+      c.I32ConstU(inst.UIMM);
+    c.LocalSet(Local::L_V);
+    e.Compare(inst.CRFD, inst.OPCD == 11);
+    return true;
+  case 12:  // addic
+  case 13:  // addic.
+  {
+    const u32 imm = static_cast<u32>(static_cast<s32>(inst.SIMM_16));
+    e.PushGPR(ra);
+    c.LocalTee(Local::L_T);
+    c.I32ConstU(imm);
+    c.I32Add();
+    c.LocalSet(Local::L_V);
+    e.SetGPRFromLocal(rd, Local::L_V);
+    // carry(a, imm) = imm > ~a  <=>  result < a (unsigned)
+    c.LocalGet(Local::L_V);
+    c.LocalGet(Local::L_T);
+    c.I32LtU();
+    e.SetCarryFromStack();
+    if (inst.OPCD == 13)
+      e.UpdateCR0(Local::L_V);
+    return true;
+  }
+  case 14:  // addi
+    return alu(rd, false, [&] {
+      e.PushRAOrZero(ra);
+      c.I32Const(inst.SIMM_16);
+      c.I32Add();
+    });
+  case 15:  // addis
+    return alu(rd, false, [&] {
+      e.PushRAOrZero(ra);
+      c.I32ConstU(static_cast<u32>(inst.SIMM_16) << 16);
+      c.I32Add();
+    });
+  case 20:  // rlwimix
+  {
+    const u32 mask = MakeRotationMask(inst.MB, inst.ME);
+    return alu(ra, inst.Rc, [&] {
+      e.PushGPR(ra);
+      c.I32ConstU(~mask);
+      c.I32And();
+      e.PushGPR(inst.RS);
+      c.I32Const(inst.SH);
+      c.I32Rotl();
+      c.I32ConstU(mask);
+      c.I32And();
+      c.I32Or();
+    });
+  }
+  case 21:  // rlwinmx
+  {
+    const u32 mask = MakeRotationMask(inst.MB, inst.ME);
+    return alu(ra, inst.Rc, [&] {
+      e.PushGPR(inst.RS);
+      c.I32Const(inst.SH);
+      c.I32Rotl();
+      c.I32ConstU(mask);
+      c.I32And();
+    });
+  }
+  case 23:  // rlwnmx
+  {
+    const u32 mask = MakeRotationMask(inst.MB, inst.ME);
+    return alu(ra, inst.Rc, [&] {
+      e.PushGPR(inst.RS);
+      e.PushGPR(rb);
+      c.I32Rotl();  // wasm rotl uses the amount mod 32, like & 0x1F
+      c.I32ConstU(mask);
+      c.I32And();
+    });
+  }
+  case 24:  // ori
+  case 25:  // oris
+  case 26:  // xori
+  case 27:  // xoris
+  {
+    const u32 imm = inst.OPCD & 1 ? (u32{inst.UIMM} << 16) : u32{inst.UIMM};
+    return alu(ra, false, [&] {
+      e.PushGPR(inst.RS);
+      c.I32ConstU(imm);
+      inst.OPCD < 26 ? c.I32Or() : c.I32Xor();
+    });
+  }
+  case 28:  // andi.
+  case 29:  // andis.
+  {
+    const u32 imm = inst.OPCD == 29 ? (u32{inst.UIMM} << 16) : u32{inst.UIMM};
+    return alu(ra, true, [&] {
+      e.PushGPR(inst.RS);
+      c.I32ConstU(imm);
+      c.I32And();
+    });
+  }
+  case 32: return mem(ea_d, 4, false, false, false);   // lwz
+  case 33: return mem(ea_du, 4, false, false, true);   // lwzu
+  case 34: return mem(ea_d, 1, false, false, false);   // lbz
+  case 35: return mem(ea_du, 1, false, false, true);   // lbzu
+  case 36: return mem(ea_d, 4, false, true, false);    // stw
+  case 37: return mem(ea_du, 4, false, true, true);    // stwu
+  case 38: return mem(ea_d, 1, false, true, false);    // stb
+  case 39: return mem(ea_du, 1, false, true, true);    // stbu
+  case 40: return mem(ea_d, 2, false, false, false);   // lhz
+  case 41: return mem(ea_du, 2, false, false, true);   // lhzu
+  case 42: return mem(ea_d, 2, true, false, false);    // lha
+  case 43: return mem(ea_du, 2, true, false, true);    // lhau
+  case 44: return mem(ea_d, 2, false, true, false);    // sth
+  case 45: return mem(ea_du, 2, false, true, true);    // sthu
+  case 31:
+    break;
+  default:
+    return false;
+  }
+
+  // ---- opcode 31 ----
+  if (inst.OE)
+  {
+    // Overflow-enable forms (rare): leave to the interpreter. OE shares a bit
+    // with SUBOP10's top bit, so only XO-form ops reach here with OE set;
+    // X-form ops whose SUBOP10 >= 512 are matched before this check below.
+  }
+  const u32 xo = inst.SUBOP10;
+  const u32 rs = inst.RS;
+  auto binop = [&](u32 dst, auto op) {  // dst = op(rA/rS, rB)
+    return alu(dst, inst.Rc, op);
+  };
+
+  switch (xo)
+  {
+  case 0:   // cmp
+  case 32:  // cmpl
+    e.PushGPR(ra);
+    c.LocalSet(Local::L_T);
+    e.PushGPR(rb);
+    c.LocalSet(Local::L_V);
+    e.Compare(inst.CRFD, xo == 0);
+    return true;
+  case 23: return mem(ea_x, 4, false, false, false);   // lwzx
+  case 55: return mem(ea_xu, 4, false, false, true);   // lwzux
+  case 87: return mem(ea_x, 1, false, false, false);   // lbzx
+  case 119: return mem(ea_xu, 1, false, false, true);  // lbzux
+  case 151: return mem(ea_x, 4, false, true, false);   // stwx
+  case 183: return mem(ea_xu, 4, false, true, true);   // stwux
+  case 215: return mem(ea_x, 1, false, true, false);   // stbx
+  case 247: return mem(ea_xu, 1, false, true, true);   // stbux
+  case 279: return mem(ea_x, 2, false, false, false);  // lhzx
+  case 311: return mem(ea_xu, 2, false, false, true);  // lhzux
+  case 343: return mem(ea_x, 2, true, false, false);   // lhax
+  case 375: return mem(ea_xu, 2, true, false, true);   // lhaux
+  case 407: return mem(ea_x, 2, false, true, false);   // sthx
+  case 439: return mem(ea_xu, 2, false, true, true);   // sthux
+  case 24:  // slw
+  case 536: // srw
+    return binop(ra, [&] {
+      // (rB & 0x20) ? 0 : rS shifted by rB & 0x1f
+      c.I32Const(0);
+      e.PushGPR(rs);
+      e.PushGPR(rb);
+      xo == 24 ? c.I32Shl() : c.I32ShrU();
+      e.PushGPR(rb);
+      c.I32Const(0x20);
+      c.I32And();
+      c.Select();  // select(0, shifted, rB & 0x20): 0 if the bit is set
+    });
+  case 26:  // cntlzw
+    return binop(ra, [&] {
+      e.PushGPR(rs);
+      c.I32Clz();
+    });
+  case 28:  // and
+  case 60:  // andc
+  case 124: // nor
+  case 284: // eqv
+  case 316: // xor
+  case 412: // orc
+  case 444: // or
+  case 476: // nand
+    return binop(ra, [&] {
+      e.PushGPR(rs);
+      e.PushGPR(rb);
+      if (xo == 60 || xo == 412)
+      {
+        c.I32Const(-1);
+        c.I32Xor();
+      }
+      switch (xo)
+      {
+      case 28: case 60: case 476: c.I32And(); break;
+      case 124: case 412: case 444: c.I32Or(); break;
+      default: c.I32Xor(); break;
+      }
+      if (xo == 124 || xo == 284 || xo == 476)
+      {
+        c.I32Const(-1);
+        c.I32Xor();
+      }
+    });
+  case 824:  // srawi
+  case 792:  // sraw
+  {
+    // rA = rS >> n (arithmetic); CA = rS < 0 && n > 0 && (rS << (32 - n)) != 0
+    e.PushGPR(rs);
+    c.LocalSet(Local::L_V);  // rs
+    if (xo == 824)
+    {
+      c.I32Const(inst.SH);
+    }
+    else
+    {
+      // sraw: amount = rB & 0x3f, anything >= 32 behaves like 31 for the
+      // result and carry (all bits shifted out)
+      e.PushGPR(rb);
+      c.I32Const(0x3f);
+      c.I32And();
+      c.LocalTee(Local::L_T);
+      c.I32Const(31);
+      c.LocalGet(Local::L_T);
+      c.I32Const(31);
+      c.I32LtU();
+      c.Select();
+    }
+    c.LocalSet(Local::L_T);  // n (0..31)
+    // carry: rs < 0 && (rs & ((1 << n) - 1)) != 0   [for sraw with amount >= 32: rs < 0]
+    c.LocalGet(Local::L_V);
+    c.I32Const(0);
+    c.I32LtS();
+    c.LocalGet(Local::L_V);
+    if (xo == 792)
+      c.I32Const(-1);  // amount >= 32: every bit is shifted out
+    c.I32Const(1);
+    c.LocalGet(Local::L_T);
+    c.I32Shl();
+    c.I32Const(1);
+    c.I32Sub();
+    if (xo == 792)
+    {
+      e.PushGPR(rb);
+      c.I32Const(0x20);
+      c.I32And();
+      c.Select();  // select(-1, (1 << n) - 1, rB & 0x20)
+    }
+    c.I32And();
+    c.I32Const(0);
+    c.I32Ne();
+    c.I32And();
+    c.LocalSet(Local::L_E);  // carry
+    // result: rs >> n, or rs >> 31 for amounts >= 32 (n is 31 then)
+    c.LocalGet(Local::L_V);
+    c.LocalGet(Local::L_T);
+    c.I32ShrS();
+    c.LocalSet(Local::L_V);
+    e.SetGPRFromLocal(ra, Local::L_V);
+    c.LocalGet(Local::L_E);
+    e.SetCarryFromStack();
+    if (inst.Rc)
+      e.UpdateCR0(Local::L_V);
+    return true;
+  }
+  case 339:  // mfspr
+  case 467:  // mtspr
+  {
+    const u32 spr = inst.SPR;
+    const u32 index = xo == 339 ? (((spr & 0x1F) << 5) + ((spr >> 5) & 0x1F)) :
+                                  ((inst.SPRU << 5) | (inst.SPRL & 0x1F));
+    const bool user = index == SPR_LR || index == SPR_CTR || index == SPR_XER;
+    const bool plain = user || (index >= SPR_GQR0 && index < SPR_GQR0 + 8) ||
+                       (index >= SPR_SPRG0 && index < SPR_SPRG0 + 4);
+    if (!plain)
+      return false;  // side effects: Interpreter
+    // Supervisor-only SPRs: in user mode (MSR.PR) the Interpreter raises the
+    // program exception.
+    c.Block();
+    c.Block();
+    e.Use(rd);
+    if (!user)
+    {
+      c.I32ConstU(e.m.ppc);
+      c.I32Load(e.m.msr);
+      c.I32Const(1 << 14);  // MSR.PR
+      c.I32And();
+      c.BrIf(0);
+    }
+    if (xo == 339)
+    {
+      if (index == SPR_XER)
+      {
+        // GetXER(): stringctrl | ca << 29 | so_ov << 30, also stored in spr[XER]
+        c.I32ConstU(e.m.ppc);
+        c.I32Load16U(e.m.xer_stringctrl);
+        c.I32ConstU(e.m.ppc);
+        c.I32Load8U(e.m.xer_ca);
+        c.I32Const(XER_CA_SHIFT);
+        c.I32Shl();
+        c.I32Or();
+        c.I32ConstU(e.m.ppc);
+        c.I32Load8U(e.m.xer_so_ov);
+        c.I32Const(XER_OV_SHIFT);
+        c.I32Shl();
+        c.I32Or();
+        c.LocalSet(L_V);
+        e.SetSPR(index, [&] { c.LocalGet(L_V); });
+        e.SetGPRFromLocal(rd, L_V);
+      }
+      else
+      {
+        e.SetGPR(rd, [&] { e.PushSPR(index); });
+      }
+    }
+    else
+    {
+      e.PushGPR(rd);
+      c.LocalSet(L_V);
+      e.SetSPR(index, [&] { c.LocalGet(L_V); });
+      if (index == SPR_XER)
+      {
+        // SetXER: stringctrl = BYTE_COUNT + (BYTE_CMP << 8); ca; so_ov = (SO << 1) + OV
+        c.I32ConstU(e.m.ppc);
+        c.LocalGet(L_V);
+        c.I32Const(0x7f);
+        c.I32And();
+        c.LocalGet(L_V);
+        c.I32Const(8);
+        c.I32ShrU();
+        c.I32Const(0xff);
+        c.I32And();
+        c.I32Const(8);
+        c.I32Shl();
+        c.I32Add();
+        c.I32Store16(e.m.xer_stringctrl);
+        c.I32ConstU(e.m.ppc);
+        c.LocalGet(L_V);
+        c.I32Const(XER_CA_SHIFT);
+        c.I32ShrU();
+        c.I32Const(1);
+        c.I32And();
+        c.I32Store8(e.m.xer_ca);
+        c.I32ConstU(e.m.ppc);
+        c.LocalGet(L_V);
+        c.I32Const(XER_OV_SHIFT);
+        c.I32ShrU();
+        c.I32Const(3);
+        c.I32And();
+        c.I32Store8(e.m.xer_so_ov);
+      }
+    }
+    c.Br(1);
+    c.End();
+    e.Flush(true);
+    fallback();
+    if (xo == 339)
+      e.Reload(rd);
+    c.End();
+    if (xo == 339)
+    {
+      e.loaded |= 1u << rd;
+      e.dirty |= 1u << rd;
+    }
+    return true;
+  }
+  case 922:  // extsh
+  case 954:  // extsb
+    return binop(ra, [&] {
+      e.PushGPR(rs);
+      xo == 922 ? c.I32Extend16S() : c.I32Extend8S();
+    });
+  default:
+    break;
+  }
+
+  if (inst.OE)
+    return false;
+
+  switch (xo & 0x1ff)  // XO-form: 9-bit opcode
+  {
+  case 266:  // add
+    return binop(rd, [&] {
+      e.PushGPR(ra);
+      e.PushGPR(rb);
+      c.I32Add();
+    });
+  case 40:  // subf: rB - rA
+    return binop(rd, [&] {
+      e.PushGPR(rb);
+      e.PushGPR(ra);
+      c.I32Sub();
+    });
+  case 104:  // neg
+    return binop(rd, [&] {
+      c.I32Const(0);
+      e.PushGPR(ra);
+      c.I32Sub();
+    });
+  case 235:  // mullw
+    return binop(rd, [&] {
+      e.PushGPR(ra);
+      e.PushGPR(rb);
+      c.I32Mul();
+    });
+  case 75:  // mulhw
+  case 11:  // mulhwu
+    return binop(rd, [&] {
+      e.PushGPR(ra);
+      (xo & 0x1ff) == 75 ? c.I64ExtendI32S() : c.I64ExtendI32U();
+      e.PushGPR(rb);
+      (xo & 0x1ff) == 75 ? c.I64ExtendI32S() : c.I64ExtendI32U();
+      c.I64Mul();
+      c.I64Const(32);
+      c.I64ShrU();
+      c.I32WrapI64();
+    });
+  case 491:  // divw
+  {
+    // overflow (b == 0 || (a == INT_MIN && b == -1)): rD = a < 0 ? -1 : 0
+    e.PushGPR(ra);
+    c.LocalSet(Local::L_T);
+    e.PushGPR(rb);
+    c.LocalSet(Local::L_E);
+    c.LocalGet(Local::L_E);
+    c.I32Eqz();
+    c.LocalGet(Local::L_T);
+    c.I32ConstU(0x80000000);
+    c.I32Eq();
+    c.LocalGet(Local::L_E);
+    c.I32Const(-1);
+    c.I32Eq();
+    c.I32And();
+    c.I32Or();
+    c.If(WasmJit::I32);
+    c.LocalGet(Local::L_T);
+    c.I32Const(31);
+    c.I32ShrS();
+    c.Else();
+    c.LocalGet(Local::L_T);
+    c.LocalGet(Local::L_E);
+    c.I32DivS();
+    c.End();
+    c.LocalSet(Local::L_V);
+    e.SetGPRFromLocal(rd, Local::L_V);
+    if (inst.Rc)
+      e.UpdateCR0(Local::L_V);
+    return true;
+  }
+  case 459:  // divwu: b == 0 -> 0
+    e.Use(ra);
+    e.PushGPR(rb);
+    c.LocalTee(Local::L_E);
+    c.If(WasmJit::I32);
+    e.PushGPR(ra);
+    c.LocalGet(Local::L_E);
+    c.I32DivU();
+    c.Else();
+    c.I32Const(0);
+    c.End();
+    c.LocalSet(Local::L_V);
+    e.SetGPRFromLocal(rd, Local::L_V);
+    if (inst.Rc)
+      e.UpdateCR0(Local::L_V);
+    return true;
+  case 10:   // addc: CA = carry(a, b)
+  case 138:  // adde: CA = carry(a, b) || carry(a + b, ca)
+  case 202:  // addze: rD = a + ca, CA = carry(a, ca)
+  case 8:    // subfc: rD = ~a + b + 1, CA = ~a == 0xFFFFFFFF || carry(b, ~a + 1)
+  case 136:  // subfe: rD = ~a + b + ca, CA = carry(~a, b) || carry(~a + b, ca)
+  {
+    const u32 op = xo & 0x1ff;
+    // Do it in 64 bits: carry is bit 32 of the full sum.
+    e.PushGPR(ra);
+    if (op == 8 || op == 136)
+    {
+      c.I32Const(-1);
+      c.I32Xor();
+    }
+    c.I64ExtendI32U();
+    if (op != 202)
+    {
+      e.PushGPR(rb);
+      c.I64ExtendI32U();
+      c.I64Add();
+    }
+    if (op == 8)
+    {
+      c.I64Const(1);
+      c.I64Add();
+    }
+    else if (op != 10)
+    {
+      e.PushCarry();
+      c.I64ExtendI32U();
+      c.I64Add();
+    }
+    c.LocalTee(Local::L_X);
+    c.I32WrapI64();
+    c.LocalSet(Local::L_V);
+    e.SetGPRFromLocal(rd, Local::L_V);
+    c.LocalGet(Local::L_X);
+    c.I64Const(32);
+    c.I64ShrU();
+    c.I32WrapI64();
+    e.SetCarryFromStack();
+    if (inst.Rc)
+      e.UpdateCR0(Local::L_V);
+    return true;
+  }
+  default:
+    return false;
+  }
+}
+
+s32 CachedInterpreter::WasmEntry(PowerPC::PowerPCState& ppc_state,
+                                 const WasmEntryOperands& operands)
+{
+  // Only reached when the block isn't compiled; ExecuteOneBlock handles it.
+  return sizeof(AnyCallback) + sizeof(operands);
+}
+
+s32 CachedInterpreter::WasmEntry(std::ostream& stream, const WasmEntryOperands& operands)
+{
+  fmt::println(stream, "WasmEntry(fn={}, calls={})", operands.fn, operands.calls);
+  return sizeof(AnyCallback) + sizeof(operands);
+}
+
+void CachedInterpreter::OnDestroyBlock(const JitBlock& block)
+{
+  if (!block.normalEntry)
+    return;
+  if (*reinterpret_cast<const AnyCallback*>(block.normalEntry) != AnyCallbackCast(WasmEntry))
+    return;
+  auto& entry =
+      *reinterpret_cast<WasmEntryOperands*>(block.normalEntry + sizeof(AnyCallback));
+  if (entry.fn != 0)
+    dolphin_wasm_jit_free(static_cast<int>(entry.fn));
+  entry.fn = 0;
+  entry.calls = WASM_JIT_NEVER;
+}
+
+void CachedInterpreter::CompileWasm(WasmEntryOperands& entry)
+{
+  using namespace WasmJit;
+  const int mode = dolphin_wasm_jit_mode();
+  s_disabled_groups = static_cast<u32>(dolphin_wasm_jit_disabled_groups());
+  if (mode <= 0)
+  {
+    entry.calls = WASM_JIT_NEVER;
+    return;
+  }
+  JitBlock& block = *entry.block;
+  const u8* p = reinterpret_cast<const u8*>(&entry) + sizeof(WasmEntryOperands);
+  const u8* const end = block.near_end;
+
+  const u32 ppc = static_cast<u32>(reinterpret_cast<uintptr_t>(&m_ppc_state));
+  const u32 off_pc = offsetof(PowerPC::PowerPCState, pc);
+  const u32 off_npc = offsetof(PowerPC::PowerPCState, npc);
+
+  auto& memory = m_system.GetMemory();
+  const Machine machine{
+      ppc,
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, gpr)),
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, cr) +
+                       offsetof(PowerPC::ConditionRegister, fields)),
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, msr)),
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, xer_ca)),
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, xer_so_ov)),
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, xer_stringctrl)),
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, m_enable_dcache)),
+      static_cast<u32>(reinterpret_cast<uintptr_t>(PowerPC::ConditionRegister::s_crTable.data())),
+      static_cast<u32>(reinterpret_cast<uintptr_t>(m_system.GetMMU().GetDBATTable().data())),
+      static_cast<u32>(reinterpret_cast<uintptr_t>(memory.GetRAM())),
+      memory.GetRamMask(),
+      static_cast<u32>(reinterpret_cast<uintptr_t>(memory.GetEXRAM())),
+      memory.GetEXRAM() ? memory.GetExRamSizeReal() : 0,
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, pc)),
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, npc)),
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, spr)),
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, downcount)),
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, feature_flags)),
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, ps)),
+      static_cast<u32>(offsetof(PowerPC::PowerPCState, fpscr)),
+      (block.feature_flags & FEATURE_FLAG_MSR_DR) != 0,
+  };
+  const bool branch_watch = m_system.GetPowerPC().GetBranchWatch().GetRecordingActive();
+
+  CodeWriter c;
+  Emitter emitter(c, machine);
+  auto call_callback = [&](AnyCallback cb, const u8* payload) {
+    // if (cb(ppc_state, payload) == 0) return;
+    emitter.Flush();
+    c.I32ConstU(ppc);
+    c.I32ConstU(static_cast<u32>(reinterpret_cast<uintptr_t>(payload)));
+    c.I32ConstU(static_cast<u32>(reinterpret_cast<uintptr_t>(cb)));
+    c.CallIndirect(TYPE_I_II);
+    c.I32Eqz();
+    c.If();
+    c.I32Const(0);
+    c.Return();
+    c.End();
+    emitter.Invalidate();  // callbacks may change any register
+  };
+
+  // Block exit: EndBlock<false> inline (pc = npc, downcount, no performance
+  // monitor), then block chaining: if there's time left in the slice, look
+  // the next block up in the dispatcher's map and return its compiled
+  // function (0: let the dispatcher handle it).
+  const bool can_chain = m_block_cache.UsesFastBlockMapFallback();
+  const bool tail_calls = dolphin_wasm_jit_tailcalls() != 0;
+  const u32 entry_addr = static_cast<u32>(reinterpret_cast<uintptr_t>(&entry));
+  const u32 fast_map =
+      static_cast<u32>(reinterpret_cast<uintptr_t>(m_block_cache.GetFastBlockMapFallback()));
+  const u32 wasm_entry_cb = static_cast<u32>(reinterpret_cast<uintptr_t>(AnyCallbackCast(WasmEntry)));
+  auto end_block_inline = [&](const EndBlockOperands<false>& op) {
+    emitter.Flush();
+    // pc = npc
+    c.I32ConstU(ppc);
+    c.I32ConstU(ppc);
+    c.I32Load(machine.npc);
+    c.I32Store(machine.pc);
+    // downcount -= n
+    c.I32ConstU(ppc);
+    c.I32ConstU(ppc);
+    c.I32Load(machine.downcount);
+    c.I32ConstU(op.downcount);
+    c.I32Sub();
+    c.LocalTee(L_T);
+    c.I32Store(machine.downcount);
+    if (!can_chain)
+    {
+      c.I32Const(0);
+      c.Return();
+      return;
+    }
+    c.LocalGet(L_T);
+    c.I32Const(0);
+    c.I32LeS();
+    c.If();
+    c.I32Const(0);
+    c.Return();
+    c.End();
+    // Tight loop: the block branches to itself. Run it again here, unless it
+    // was destroyed meanwhile (OnDestroyBlock clears entry.fn; the operands'
+    // memory is only reused at the next compile).
+    c.I32ConstU(ppc);
+    c.I32Load(machine.pc);
+    c.I32ConstU(block.effectiveAddress);
+    c.I32Eq();
+    c.I32ConstU(entry_addr);
+    c.I32Load(offsetof(WasmEntryOperands, fn));
+    c.I32Const(0);
+    c.I32Ne();
+    c.I32And();
+    c.BrIf(0);  // the function-wide loop
+    // block = fast_map[(pc >> 2) & mask]
+    c.I32ConstU(ppc);
+    c.I32Load(machine.pc);
+    c.LocalTee(L_V);
+    c.I32Const(2);
+    c.I32ShrU();
+    c.I32ConstU(JitBaseBlockCache::FAST_BLOCK_MAP_FALLBACK_MASK);
+    c.I32And();
+    c.I32Const(2);
+    c.I32Shl();
+    c.I32ConstU(fast_map);
+    c.I32Add();
+    c.I32Load();
+    c.LocalTee(L_E);
+    c.I32Eqz();
+    c.If();
+    c.I32Const(0);
+    c.Return();
+    c.End();
+    // block->effectiveAddress == pc && block->feature_flags == feature_flags
+    c.LocalGet(L_E);
+    c.I32Load(offsetof(JitBlockData, effectiveAddress));
+    c.LocalGet(L_V);
+    c.I32Ne();
+    c.LocalGet(L_E);
+    c.I32Load(offsetof(JitBlockData, feature_flags));
+    c.I32ConstU(ppc);
+    c.I32Load(machine.feature_flags);
+    c.I32Ne();
+    c.I32Or();
+    c.If();
+    c.I32Const(0);
+    c.Return();
+    c.End();
+    // entry = block->normalEntry; first callback must be WasmEntry
+    c.LocalGet(L_E);
+    c.I32Load(offsetof(JitBlockData, normalEntry));
+    c.LocalTee(L_E);
+    c.I32Load();
+    c.I32ConstU(wasm_entry_cb);
+    c.I32Ne();
+    c.If();
+    c.I32Const(0);
+    c.Return();
+    c.End();
+    c.LocalGet(L_E);
+    c.I32Load(sizeof(AnyCallback) + offsetof(WasmEntryOperands, fn));
+    if (tail_calls)
+    {
+      // next block compiled: jump into it; otherwise back to the dispatcher
+      c.LocalTee(L_E);
+      c.I32Eqz();
+      c.If();
+      c.I32Const(0);
+      c.Return();
+      c.End();
+      c.LocalGet(L_E);
+      c.ReturnCallIndirect(TYPE_I_V);
+    }
+    else
+    {
+      c.Return();
+    }
+  };
+
+  c.Loop();  // target of the tight-loop branch in end_block_inline
+  while (p < end)
+  {
+    const auto cb = *reinterpret_cast<const AnyCallback*>(p);
+    const u8* payload = p + sizeof(AnyCallback);
+
+    if (cb == AnyCallbackCast(Interpret<false>) || cb == AnyCallbackCast(Interpret<true>))
+    {
+      const auto& op = *reinterpret_cast<const InterpretOperands*>(payload);
+      if (cb == AnyCallbackCast(Interpret<true>))
+      {
+        c.I32ConstU(ppc);
+        c.I32ConstU(op.current_pc);
+        c.I32Store(off_pc);
+        c.I32ConstU(ppc);
+        c.I32ConstU(op.current_pc + 4);
+        c.I32Store(off_npc);
+      }
+      // func(interpreter, inst): the instruction is passed by pointer in the
+      // WebAssembly C ABI, and the operands hold a copy we can point at.
+      const auto call_interpreter = [&] {
+        c.I32ConstU(static_cast<u32>(reinterpret_cast<uintptr_t>(&op.interpreter)));
+        c.I32ConstU(static_cast<u32>(reinterpret_cast<uintptr_t>(&op.inst)));
+        c.I32ConstU(static_cast<u32>(reinterpret_cast<uintptr_t>(op.func)));
+        c.CallIndirect(TYPE_V_II);
+      };
+      if (!(mode >= 2 && EmitInline(emitter, op.inst, op.current_pc, branch_watch,
+                                     call_interpreter)))
+      {
+        emitter.Flush();
+        call_interpreter();
+        emitter.Invalidate();
+        dolphin_wasm_jit_note_fallback(PPCTables::GetInstructionName(op.inst, op.current_pc));
+      }
+      p = payload + sizeof(InterpretOperands);
+      continue;
+    }
+
+    std::size_t size;
+    if (cb == AnyCallbackCast(InterpretAndCheckExceptions<false>) ||
+        cb == AnyCallbackCast(InterpretAndCheckExceptions<true>))
+      size = sizeof(InterpretAndCheckExceptionsOperands);
+    else if (cb == AnyCallbackCast(EndBlock<false>))
+    {
+      size = sizeof(EndBlockOperands<false>);
+      if ((block.feature_flags & FEATURE_FLAG_PERFMON) == 0)
+      {
+        end_block_inline(*reinterpret_cast<const EndBlockOperands<false>*>(payload));
+        p = payload + size;
+        continue;
+      }
+    }
+    else if (cb == AnyCallbackCast(EndBlock<true>))
+      size = sizeof(EndBlockOperands<true>);
+    else if (cb == AnyCallbackCast(StartProfiledBlock))
+      size = sizeof(StartProfiledBlockOperands);
+    else if (cb == AnyCallbackCast(HLEFunction))
+      size = sizeof(HLEFunctionOperands);
+    else if (cb == AnyCallbackCast(WriteBrokenBlockNPC))
+      size = sizeof(WriteBrokenBlockNPCOperands);
+    else if (cb == AnyCallbackCast(CheckFPU) || cb == AnyCallbackCast(CheckBreakpoint))
+      size = sizeof(CheckHaltOperands);
+    else if (cb == AnyCallbackCast(CheckIdle))
+      size = sizeof(CheckIdleOperands);
+    else
+    {
+      WARN_LOG_FMT(DYNA_REC, "WebAssembly JIT: unknown callback in block {:08x}",
+                   block.effectiveAddress);
+      entry.calls = WASM_JIT_NEVER;
+      return;
+    }
+    call_callback(cb, payload);
+    p = payload + size;
+  }
+
+  c.End();        // loop
+  c.I32Const(0);  // not reached: every block ends in EndBlock
+  const std::vector<u8> module =
+      BuildModule({{L_I32_COUNT, I32}, {L_I64_COUNT, I64}, {L_F64_COUNT, F64}}, c.bytes);
+  const int fn = dolphin_wasm_jit_install(module.data(), static_cast<int>(module.size()));
+  if (fn <= 0)
+  {
+    entry.calls = WASM_JIT_NEVER;
+    return;
+  }
+  entry.fn = static_cast<u32>(fn);
+}
