+std::unique_ptr<AbstractFramebuffer>
+Gfx::CreateFramebuffer(AbstractTexture* color, AbstractTexture* depth,
+                       std::vector<AbstractTexture*> additional)
+{
+  std::vector<int> adds;
+  for (auto* t : additional)
+    adds.push_back(TexId(t));
+  const AbstractTexture* any = color ? color : depth;
+  const int id = wgpu_fb_create(TexId(color), TexId(depth), adds.data(),
+                                static_cast<int>(adds.size()));
+  return std::make_unique<Framebuffer>(
+      color, depth, std::move(additional),
+      color ? color->GetFormat() : AbstractTextureFormat::Undefined,
+      depth ? depth->GetFormat() : AbstractTextureFormat::Undefined, any->GetWidth(),
+      any->GetHeight(), id);
+}
