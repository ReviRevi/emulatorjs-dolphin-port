+    loadDolphinAssets() {
+        // Dolphin needs its "Sys" data folder (fonts, game INIs, etc.).
+        // It ships as cores/dolphin-sys.zip and is unpacked to
+        // /home/web_user/retroarch/system/dolphin-emu/Sys
+        return new Promise(async (resolve, reject) => {
+            try {
+                const res = await this.EJS.downloadFile("cores/dolphin-sys.zip", this.EJS.downloadType.core.name, null, false, { responseType: "arraybuffer", method: "GET" }, true, this.EJS.downloadType.core.dontCache);
+                if (res === -1) {
+                    throw new Error("Failed to download Dolphin Sys files");
+                }
+                const root = "/home/web_user/retroarch/system/dolphin-emu/";
+                const files = res.data.files;
+                for (let i = 0; i < files.length; i++) {
+                    const path = root + files[i].filename;
+                    const parts = path.split("/");
+                    let cp = "";
+                    for (let j = 0; j < parts.length - 1; j++) {
+                        if (parts[j] === "") continue;
+                        cp += "/" + parts[j];
+                        if (!this.FS.analyzePath(cp).exists) this.FS.mkdir(cp);
+                    }
+                    if (!path.endsWith("/")) this.FS.writeFile(path, files[i].bytes);
+                }
+                resolve();
+            } catch (error) {
+                this.EJS.frontend.setLoadingText("Network Error");
+                this.EJS.frontend.textElem.style.color = "red";
+                reject(error);
+            }
+        });
+    }
